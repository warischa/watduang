{
  "name": "watduang",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-games.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test 'src/**/*.test.mjs' 'scripts/**/*.test.mjs'",
    "validate": "node scripts/validate-games.mjs --selftest && node scripts/validate-games.mjs",
    "gate-selftest-coverage-check": "node scripts/gate-selftest-coverage-check.mjs --selftest && node scripts/gate-selftest-coverage-check.mjs",
    "js-motion-guard-check": "node scripts/js-motion-guard-check.mjs --selftest && node scripts/js-motion-guard-check.mjs",
    "check-citations": "node scripts/check-citations.mjs --selftest && node scripts/check-citations.mjs",
    "added-lineno-citation-check": "node scripts/added-lineno-citation-check.mjs --selftest && node scripts/added-lineno-citation-check.mjs",
    "thai-comments": "node scripts/thai-comments.mjs --selftest && node scripts/thai-comments.mjs",
    "dangling-css-var-check": "node scripts/dangling-css-var-check.mjs --selftest && node scripts/dangling-css-var-check.mjs",
    "public-orphan-check": "node scripts/public-orphan-check.mjs --selftest && node scripts/public-orphan-check.mjs",
    "check-node-version": "node -v; major=$(node -p \"process.versions.node.split('.')[0]\"); if [ \"$major\" -lt 22 ]; then echo \"::error::Node major version $major < 22 -- scripts/validate-games.mjs needs built-in .ts type stripping (Node >=22.18).\"; exit 1; fi",
    "no-nav-in-stage-check": "node scripts/no-nav-in-stage-check.mjs --selftest && node scripts/no-nav-in-stage-check.mjs",
    "leave-confirm-check": "node scripts/leave-confirm-check.mjs --selftest && node scripts/leave-confirm-check.mjs",
    "round-start-announce-check": "node scripts/round-start-announce-check.mjs --selftest && node scripts/round-start-announce-check.mjs",
    "arm-gate-coverage-check": "node scripts/arm-gate-coverage-check.mjs --selftest && node scripts/arm-gate-coverage-check.mjs",
    "stable-exit-markers-check": "node scripts/stable-exit-markers-check.mjs --selftest && node scripts/stable-exit-markers-check.mjs",
    "roster-lock-structure-check": "node scripts/roster-lock-structure-check.mjs --selftest && node scripts/roster-lock-structure-check.mjs",
    "checkpoint-writer-check": "node scripts/checkpoint-writer-check.mjs --selftest && node scripts/checkpoint-writer-check.mjs",
    "astro-check": "astro check",
    "page-chrome-check": "node scripts/page-chrome-check.mjs --selftest && node scripts/page-chrome-check.mjs",
    "csp-allowlist-check": "node scripts/csp-allowlist-check.mjs --selftest && node scripts/csp-allowlist-check.mjs",
    "csp-inline-check": "node scripts/csp-inline-check.mjs --selftest && node scripts/csp-inline-check.mjs",
    "sitemap-tool-pages-check": "missing=''; for tool in wheel draw team number; do grep -q \"/tool/$tool/\" dist/sitemap-0.xml || missing=\"$missing /tool/$tool/\"; done; if [ -n \"$missing\" ]; then echo \"::error::dist/sitemap-0.xml missing:$missing -- tool pages must be discoverable\"; exit 1; fi",
    "crawl-check-gamenav": "node scripts/crawl-check-gamenav.mjs",
    "party-size-claim-check": "node scripts/party-size-claim-check.mjs --selftest && node scripts/party-size-claim-check.mjs",
    "repo-root-walk-check": "node scripts/repo-root-walk-check.mjs --selftest && node scripts/repo-root-walk-check.mjs",
    "css-brace-balance-check": "node scripts/css-brace-balance-check.mjs --selftest && node scripts/css-brace-balance-check.mjs",
    "live-region-height-check": "node scripts/live-region-height-check.mjs --selftest && node scripts/live-region-height-check.mjs",
    "accent-single-source-check": "node scripts/accent-single-source-check.mjs --selftest && node scripts/accent-single-source-check.mjs",
    "css-reachability-check": "node scripts/css-reachability-check.mjs --selftest && node scripts/css-reachability-check.mjs",
    "landing-claims-check": "node scripts/landing-claims-check.mjs --selftest && node scripts/landing-claims-check.mjs",
    "bundle-freeze-check": "node scripts/bundle-freeze-check.mjs --selftest && node scripts/bundle-freeze-check.mjs",
    "smoke-dist": "bash scripts/smoke-dist.sh",
    "ci-probes": "bash scripts/ci-probes.sh",
    "ci": "npm run check-node-version && npm run validate && npm run check-citations && npm run added-lineno-citation-check && npm run thai-comments && npm run public-orphan-check && npm run no-nav-in-stage-check && npm run leave-confirm-check && npm run round-start-announce-check && npm run arm-gate-coverage-check && npm run play-icon-label-check && npm run stable-exit-markers-check && npm run roster-lock-structure-check && npm run checkpoint-writer-check && npm run repo-root-walk-check && npm run css-brace-balance-check && npm run live-region-height-check && npm run accent-single-source-check && npm run css-reachability-check && npm test && npm run astro-check && npm run build && npm run page-chrome-check && npm run landing-claims-check && npm run bundle-freeze-check && npm run dangling-css-var-check && npm run csp-allowlist-check && npm run csp-inline-check && npm run sitemap-tool-pages-check && npm run crawl-check-gamenav && npm run smoke-dist && npm run js-motion-guard-check && npm run gate-selftest-coverage-check && npm run party-size-claim-check",
    "play-icon-label-check": "node scripts/play-icon-label-check.mjs --selftest && node scripts/play-icon-label-check.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.0.0"
  }
}

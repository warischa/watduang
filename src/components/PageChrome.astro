---
interface SiteLink {
  label: string;
  href: string;
  /** Token value for the top-bar pill background. */
  accent: string;
}

// The three section links, declared exactly once and mapped into the top bar, so a label or href
// can never drift between consumers (gh#86 acceptance). The footer carries the brand only (gh#247).
// Labels are byte-for-byte the design canvas's own copy (design/HomeShelfDesktop.dc.html).
const SITE_LINKS: SiteLink[] = [
  { label: 'ดูดวง', href: '/c/fortune/', accent: 'var(--accent-gold)' },
  { label: 'สุ่มคนโดน', href: '/c/party/', accent: 'var(--accent-punch)' },
  { label: 'เครื่องมือสุ่ม', href: '/tools/', accent: 'var(--accent-sky)' },
];
---

<header class="chrome-bar chrome-topbar" data-page-chrome>
  <div class="chrome-inner chrome-topbar-inner">
    <a class="chrome-brand" href="/">วัดดวง</a>
    <nav class="chrome-pills">
      {SITE_LINKS.map((link) => (
        <a class="chrome-pill" href={link.href} style={`background: ${link.accent}`}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<slot />

<footer class="chrome-bar chrome-footer" data-page-chrome>
  <div class="chrome-inner chrome-footer-inner">
    <span class="chrome-footer-brand">วัดดวง</span>
  </div>
</footer>

<style>
  /* gh#247 — the top bar and footer of canvas D (design/HomeShelfDesktop.dc.html and
     design/HomeShelf320.dc.html), values byte for byte. Colours go through tokens where the canvas
     value IS a token: ink --color-line-strong, the brand's yellow --accent-gold, and the three pill
     fills --accent-gold / --accent-punch / --accent-sky. The canvas page is two artboards: the
     1440 one is the base here, and the 320 one takes over at max-width 1099px (ADR-0058, the
     breakpoint every landing component shares). The pill text is ink on all three pills (gh#248).
     The footer carries the brand only, no links: the section links live in the top-bar pills.
     data-page-chrome on both landmark elements is the marker scripts/page-chrome-check.mjs reads;
     it is never presentation. */
  .chrome-bar {
    background: var(--color-line-strong);
    font-family: var(--font-display);
    /* the full-bleed bar's own gutter: with UA content-box sizing, inline padding on the 100%-wide
       inner box overflows it past the viewport (measured +36px at 390px) */
    padding-inline: 18px;
  }

  .chrome-bar a {
    text-decoration: none;
  }

  .chrome-inner {
    box-sizing: border-box;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chrome-topbar-inner {
    height: 84px;
  }

  .chrome-brand {
    font-weight: 700;
    font-size: 32px;
    color: var(--accent-gold);
  }

  .chrome-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
  }

  .chrome-pill {
    border-radius: 999px;
    padding: 9px 20px;
    color: var(--color-line-strong);
  }

  .chrome-footer-inner {
    height: 96px;
    justify-content: center;
  }

  .chrome-footer-brand {
    font-weight: 700;
    font-size: 26px;
    color: var(--accent-gold);
  }

  @media (max-width: 1099px) {
    .chrome-bar {
      padding: 12px 14px;
    }

    .chrome-topbar-inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .chrome-brand {
      font-size: 26px;
    }

    .chrome-pills {
      margin-top: 10px;
      gap: 6px;
      font-size: 14px;
    }

    .chrome-pill {
      padding: 6px 12px;
    }

    .chrome-footer {
      padding-block: 0;
    }

    .chrome-footer-inner {
      height: 72px;
    }

    .chrome-footer-brand {
      font-size: 22px;
    }
  }
</style>

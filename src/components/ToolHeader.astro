---
interface Props {
  /** The page h1 — the tool's name, verbatim from the page that renders it. */
  title: string;
  /** The one tagline line under the h1, verbatim from the page that renders it. */
  tagline: string;
}
const { title, tagline } = Astro.props as Props;
---

{/* The one header of the four tool pages (draw, team, number, wheel): the accent title band, the h1
    and one tagline. The pages pass their own Thai in as props, so the copy stays in the pinned page
    files and this component carries none. Every comment here is a brace comment, never an HTML one:
    an HTML comment renders straight into the built page. */}
<header class="tool-head">
  <div class="tool-band">
    <div class="tool-band-inner">
      <h1>{title}</h1>
      <p class="tool-tagline">{tagline}</p>
    </div>
  </div>
</header>

<style>
  /* Values from the approved tool-pages board, header A, replayed from the number page's band that
     shipped first (gh#262). Sizes stay literal, as the design draws them; colours are tokens. Base is
     the phone form; the block under the 1100px query is the desktop form, the same boundary the
     tool pages already use. */
  .tool-band {
    background: var(--accent-sky);
    border-bottom: 3px solid var(--color-line-strong);
  }

  .tool-band-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 20px 22px 20px;
  }

  .tool-band h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 1.3;
  }

  .tool-tagline {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
  }

  @media (min-width: 1100px) {
    .tool-band {
      border-bottom-width: 5px;
    }

    .tool-band-inner {
      gap: 0;
      margin-inline: auto;
      max-width: 1280px;
      width: 100%;
      box-sizing: border-box;
      padding: 40px 0 36px 0;
    }

    .tool-band h1 {
      font-weight: 700;
      font-size: 38px;
      line-height: 1.2;
    }

    .tool-tagline {
      margin: 10px 0 0 0;
      font-size: 17px;
      line-height: 1.7;
      max-width: 56ch;
    }
  }
</style>

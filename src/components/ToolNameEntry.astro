---
interface Props {
  /** Panel heading — "ชื่อในวง" | "ชื่อในกล่อง" | "ชื่อในสนาม", byte-exact from the per-tool artboards under design/. */
  heading: string;
  /** localStorage key this panel's list lives under — one key per tool, never the shared stores (ADR-0039). */
  storageKey: string;
  /** The CTA label — "ใส่ชื่อลงวงล้อ" | "ใส่ชื่อลงกล่อง" | "ใส่ชื่อลงสนาม". */
  ctaLabel: string;
}
const { heading, storageKey, ctaLabel } = Astro.props as Props;
---

{/* Every comment in this file is a JS-style brace comment, never an HTML one: an HTML comment renders
    straight into the built page (the same hazard PlayerSetup documents), and this panel ships Thai copy
    to players.

    gh#91 — the one shared name-entry panel the three tools adopt. It replaces the game shell's setup
    panel on the tool pages, so the tools stop living on the shared roster (ADR-0039). No checkbox grid,
    no count input, no numbered mode, no clear-group — and no ceiling on the list. Every colour, radius
    and type size is copied from design/ToolNameEntry.dc.html and its per-tool 390px artboards.

    The list is one textarea, one name per line — owner-decided, replacing the type-and-add field plus
    the removable chip row. The reader edits the whole list in place, so there is nothing to add, nothing
    to remove and no empty-state footnote: an empty box is its own empty state.

    The CTA dispatches the same document event the shell panel dispatched, carrying the names, so each
    tool page keeps its listener and its behaviour exactly as it is — only where the names come from
    changes (the ticket's own boundary). The frontmatter args are strings on purpose, not objects: the
    ticket's names-in path must stay readable at one mount call per page. */}
<div id="tool-name-entry" data-storage-key={storageKey}>
  <div class="name-head">
    <h2>{heading}</h2>
    <span class="name-hint">ใส่ได้กี่คนก็ได้</span>
  </div>
  {/* One name per line. rows="20" is the whole scroller: a textarea taller than its rows scrolls
      natively, so 20 lines are visible and the 21st does not need a max-height hack or any JS. rows
      bounds what is VISIBLE and never what fits — the list stays unbounded (ADR-0039).

      Measured in a real browser at 320x568 and 390x568: 20 rows renders clientHeight 500px, 88% of
      a 568px-tall viewport — the CTA button gets pushed off screen on a small phone. The media query
      below (owner-decided: 9 rows on short viewports) overrides this with an explicit CSS `height`,
      which wins over the `rows` attribute because `rows` only feeds the UA stylesheet's own sizing
      rule, and an author rule always outranks the UA default in the cascade — proved in a real
      browser, not assumed (see the session's measurement table). `overflow-y: auto` (inherited from
      the textarea default) still applies, so line 10 scrolls instead of growing the box. */}
  <textarea id="name-input" rows="20" placeholder="พิมพ์ชื่อ บรรทัดละ 1 ชื่อ"></textarea>
  <button id="name-start" type="button">{ctaLabel}</button>
</div>

<style>
  /* Values byte-exact from the canvas (ADR-0033): container, name box, CTA — see
     design/ToolNameEntry.dc.html and the Tool*390.dc.html artboards. The one-line input became a
     20-row textarea (owner-decided deviation, the canvas still draws chips), and it reuses that
     input's own canvas values rather than inventing new ones. The short-viewport 9-row override
     below is also owner-decided and is now recorded in the canvas, per ADR-0033. */
  #tool-name-entry {
    background: #fffdf7;
    border: 2.5px solid #1a1a1a;
    border-radius: 20px;
    box-shadow: 5px 5px 0 #1a1a1a;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .name-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .name-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
  }

  .name-hint {
    font-size: 12px;
    color: #6b7280;
  }

  /* Same border, radius, padding and type size the single-line input carried, so no new design
     value enters the file (ADR-0033) — only the box grew. resize keeps the reader's control over
     height without letting a drag break the panel's own width. */
  #name-input {
    box-sizing: border-box;
    padding: 10px 14px;
    font: inherit;
    font-size: 15px;
    line-height: 1.6;
    background: #fffdf7;
    border: 2.5px solid #1a1a1a;
    border-radius: 14px;
    resize: vertical;
  }

  /* Owner-decided deviation, this session: 20 rows is 88% of a small phone's viewport height
     (measured 500px clientHeight at 320x568 and 390x568 — see the session's measurement table).
     9 rows keeps a few more names visible than the 8-row floor while dropping well under half the
     viewport (241px border-box height / 568px ~ 42%). 700px is a plain height breakpoint: every
     measured phone height (568px) is under it, the measured desktop/tablet case (900px) is over it.

     Pre-merge review, a11y fix: this was a bare `height: 241px`, which pins the box while the line
     box it holds can still grow. `em` resolves against this element's own COMPUTED font-size, so
     the height tracks the line box instead of fighting it.
     Be precise about WHICH setting this helps, because the obvious reading is wrong: the font-size
     below is an explicit 15px, and a browser's DEFAULT-font-size preference does not touch an
     explicit px value, so that case never resized the text here in the first place. Full page zoom
     scales px and em alike, so it was never the problem either. The case this fixes is a browser's
     MINIMUM font size, which does force an explicit 15px upward — there the old fixed 241px showed
     roughly 4.5 rows instead of 9, worst for exactly the readers who set it. Same for any later
     change that makes this font-size relative.
     Exact box-sizing: border-box arithmetic, not an approximation: 9 lines * line-height 1.6 =
     14.4em of content, plus the padding (10px + 10px) and border (2.5px + 2.5px) this rule does not
     touch = 25px. At the 15px base, calc(14.4em + 25px) = 14.4*15 + 25 = 241px — byte-identical to
     the value it replaces, so nothing moves at the default setting. */
  @media (max-height: 700px) {
    #name-input {
      height: calc(14.4em + 25px);
    }
  }

  #name-start {
    min-height: 60px;
    background: #1a1a1a;
    color: #fffdf7;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    border: 2.5px solid #1a1a1a;
    border-radius: 16px;
    box-shadow: 5px 5px 0 rgba(26, 26, 26, 0.3);
    cursor: pointer;
  }
</style>

<script>
  import { loadToolNames, saveToolNames, parseNameLines } from '../tools/name-list';

  const root = document.getElementById('tool-name-entry') as HTMLDivElement;
  const storageKey = root.dataset.storageKey!;
  const input = document.getElementById('name-input') as HTMLTextAreaElement;
  const startBtn = document.getElementById('name-start') as HTMLButtonElement;

  // Loaded once from this tool's own key — a refresh brings the typed lines back (the acceptance
  // box). The key itself arrives as a prop, so this file carries no storage literal at all and can
  // never write a store the games share (ADR-0039 closes that door by construction, not by a check).
  input.value = loadToolNames(storageKey).join('\n');

  // ponytail: saves the parsed lines on every keystroke, no debounce — the payload is a handful of
  // short strings and localStorage is synchronous but cheap at this size. Debounce it if a profile
  // ever says otherwise. Blank lines the reader left mid-list are not preserved; the names are.
  input.addEventListener('input', () => {
    saveToolNames(storageKey, parseNameLines(input.value));
  });

  startBtn.addEventListener('click', () => {
    // The same event the shell panel dispatched, same channel, same payload shape — each tool page
    // keeps its own listener untouched. No `start` field: that word describes a game round, and
    // tools have none (ADR-0040).
    const players = parseNameLines(input.value);
    saveToolNames(storageKey, players);
    document.dispatchEvent(new CustomEvent('watduang:start', { detail: { players }, bubbles: true }));
  });
</script>
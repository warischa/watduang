---
// The home page hero (canvas D, gh#244): a featured-game stage, not a pitch. The left column is
// the page's own hero copy, passed in as props because a component carries no copy; the right
// column is the featured game's card. Below 1100px the two stack, copy first, the way the 320
// artboard draws them.
import FeaturedCard from './FeaturedCard.astro';

export interface Props {
  badge: string;
  /** The h1's first line. */
  titleTop: string;
  /** The h1's second line, up to the highlighted words. */
  titleLead: string;
  /** The highlighted words that close the h1. */
  titleMark: string;
  lead: string;
  ctaLabel: string;
  ctaHref: string;
  featured: { href: string; title: string; desc: string; art: string; art2x: string };
}

const { badge, titleTop, titleLead, titleMark, lead, ctaLabel, ctaHref, featured } = Astro.props;
---

<header class="hero">
  <div class="ambient" aria-hidden="true"></div>
  <div class="dots" aria-hidden="true"></div>
  <div class="inner">
    <div class="copy">
      <span class="badge">{badge}</span>
      <h1>{titleTop}<br />{titleLead}<span class="mark">{titleMark}</span></h1>
      <p class="lead">{lead}</p>
      <a class="cta" href={ctaHref}>{ctaLabel} <span aria-hidden="true">→</span></a>
    </div>
    <FeaturedCard href={featured.href} title={featured.title} desc={featured.desc} art={featured.art} art2x={featured.art2x} />
  </div>
</header>

<style>
  /* Canvas D values (ADR-0033): desktop from the 1440 artboard, <= 1099px from the 320 one. The
     inner row is the canvas's 1280px box, kept 14px off each edge — the 320 artboard's own gutter —
     wherever the viewport is narrower. overflow-wrap on the copy column is the Thai-text guard: the
     hero clips (overflow: hidden), so a no-break string has to wrap rather than vanish. */
  .hero {
    position: relative;
    overflow: hidden;
    /* The ambient layer's z-index stays inside the hero. */
    isolation: isolate;
    background: var(--surface-hero);
    border-block-end: 6px solid var(--ink);
  }

  /* gh#288 pick 2: one decorative gradient layer behind the hero content, moved by transform alone
     (a moving background-position repaints every frame, measured about 50x costlier). It is 220% x
     180% of the hero, centred, clipped by the hero's overflow, so the hero's own box never changes.
     Strength 0.12 is the owner's pick; the sheet's demo default of 0.18 is the one not picked. The
     base rule is the static middle pose, so a browser that runs no animation still shows the layer. */
  .ambient {
    --glow: 0.12;
    position: absolute;
    inset: -40% -60%;
    z-index: 0;
    pointer-events: none;
    opacity: var(--glow);
    background:
      radial-gradient(ellipse 28% 30% at 26% 38%, var(--accent-sky) 0, transparent 70%),
      radial-gradient(ellipse 28% 30% at 74% 62%, var(--accent-sky) 0, transparent 70%);
    transform: translate3d(0, 0, 0) scale(1.04);
    will-change: transform;
  }

  /* Motion-sheet keyframes: plus or minus 6% and 4%, scale 1 to 1.08. The 27% and 22% on the board
     are the layer's travel limits, drawn to prove the gradient never runs out, not animation ends. */
  @keyframes hero-ambient {
    from {
      transform: translate3d(-6%, -4%, 0) scale(1);
    }
    to {
      transform: translate3d(6%, 4%, 0) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ambient {
      animation: hero-ambient var(--motion-ambient) var(--ease-ambient) infinite alternate;
    }
  }

  /* Reduced, not removed (ADR-0046): the layer holds the middle pose at half strength, 0.06. */
  @media (prefers-reduced-motion: reduce) {
    .ambient {
      animation: none;
      transform: translate3d(0, 0, 0) scale(1.04);
      opacity: calc(var(--glow) * 0.5);
    }
  }

  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--hero-dot) 3px, transparent 3.5px);
    background-size: 34px 34px;
  }

  .inner {
    position: relative;
    width: min(1280px, 100% - 28px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    padding-block: 56px;
  }

  .copy {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .badge {
    display: inline-block;
    background: var(--surface-sun);
    color: var(--ink);
    border: 4px solid var(--ink);
    border-radius: 999px;
    padding: 6px 18px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
  }

  h1 {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 84px;
    line-height: 1.08;
    color: var(--ink-light);
    text-shadow: 5px 5px 0 var(--ink);
  }

  /* Ink on a gold chip with an ink border (owner ruling, gh#262): the old gold-on-pink text measured 2.23:1,
     this pair 11.93:1. nowrap keeps the chip whole, so at 320 it takes its own line. */
  .mark {
    display: inline-block;
    white-space: nowrap;
    padding: 0 8px;
    border: 3px solid var(--ink);
    border-radius: 12px;
    background: var(--surface-sun);
    color: var(--ink);
    text-shadow: none;
  }

  .lead {
    margin: 22px 0 0;
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
  }

  .cta {
    display: inline-block;
    margin-top: 30px;
    background: var(--surface-sun);
    color: var(--ink);
    text-decoration: none;
    border: 4px solid var(--ink);
    border-radius: 18px;
    box-shadow: 6px 6px 0 0 var(--ink);
    padding: 16px 32px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
  }

  @media (max-width: 1099px) {
    .hero {
      border-block-end-width: 5px;
    }

    .dots {
      background-image: radial-gradient(circle, var(--hero-dot) 2.5px, transparent 3px);
      background-size: 26px 26px;
    }

    .inner {
      display: block;
      padding-block: 24px 30px;
    }

    .badge {
      border-width: 3px;
      padding: 4px 12px;
      font-size: 14px;
    }

    h1 {
      margin-top: 14px;
      font-size: 44px;
      line-height: 1.1;
      text-shadow: 3px 3px 0 var(--ink);
    }

    .lead {
      margin-top: 12px;
      font-size: 17px;
    }

    .cta {
      display: block;
      margin-top: 18px;
      text-align: center;
      border-width: 3px;
      border-radius: 14px;
      box-shadow: 4px 4px 0 0 var(--ink);
      padding: 12px 16px;
      font-size: 20px;
    }
  }
</style>

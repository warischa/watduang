---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  // gh#86 — when a page renders the shared PageChrome component, the chrome supplies the site
  // footer and this layout's plain one steps aside. DEFAULT FALSE: every page that does not opt
  // in keeps the footer it has always had, which is what keeps the six game pages unchanged.
  chrome?: boolean;
}

// The share card must always exist — twitter:card below hardcodes summary_large_image, so a page
// that didn't pass ogImage used to declare a big card with no image, sharing to LINE/FB with a blank link.
// The default lives here in exactly one place, so every new page gets a free card without remembering
// to set one (generate with `node scripts/make-og.mjs site`).
const { title, description, ogImage = '/og/site.png', noindex = false, chrome = false } = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <slot />

    {/* gh#86 — skipped on pages whose chrome (PageChrome) brings its own footer nav. */}
    {!chrome && (
      <footer>
        {
          Astro.url.pathname === '/' ? (
            <span>วัดดวง</span>
          ) : (
            <a href="/">วัดดวง</a>
          )
        }
      </footer>
    )}
  </body>
</html>

<style is:global>
  /* The one global reset on the site, and it lives here because this layout is where <body> is
     declared — every page renders through it. Until now nothing zeroed the UA's default body margin,
     so every screen carried an 8px gutter on each side that no design source asks for: the artboards
     under design/ are full-bleed 390px, and the shell paints its accent to the edge. The gutter was
     also load-bearing in the wrong direction — it is the width the 44px tap-target arithmetic for
     gh#79 missed, because reading the CSS finds no body rule at all and it is easy to conclude there
     is no margin rather than that the UA supplies one. */
  body {
    margin: 0;
  }
</style>

<style>
  footer {
    padding: var(--space-md);
    text-align: center;
    color: var(--color-muted);
    font-family: var(--font-sans);
  }
</style>

---
import Base from './Base.astro';
import PlayerSetup from '../shell/PlayerSetup.astro';
import PassPhone from '../shell/PassPhone.astro';
import GameNav from '../components/GameNav.astro';
import type { GameModule } from '../games/types';

interface Props {
  game: GameModule;
}

const { game } = Astro.props as Props;

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: game.seo.title,
  step: game.seo.steps.map((text) => ({ '@type': 'HowToStep', text })),
};
---

<Base title={game.seo.title} description={game.seo.description} ogImage={`/og/${game.og}`}>
  <main>
    <h1>{game.names.th}</h1>

    {/* The page's only crawlable link to /games/ — static, and deliberately ABOVE #stage. Every game
         used to append its own copy INTO #stage on the result screen, where a tap-transition
         (stage.replaceChildren()) dropped it at the coordinate the finger had just used, so a double-tap
         navigated the group off their round: measured at 26px INSIDE the tapped chip in daily-fortune
         and 4px inside the tapped stick in short-stick (docs/verification/evidence/34/15). Above #stage
         in document order, nothing that changes height at runtime sits above this line, so no re-render
         can move it under a finger — that is the whole reason it is here and not in the how-to section
         below the stage, whose y depends on the stage's height. */}
    {/* data-stable-exit (#39): this link never moves under a tap-transition (see the comment above),
         so it is the one link exempted from the leave-confirm guard in PlayerSetup.astro — every other
         link below #stage (GameNav's siblings, the footer's) still asks first mid-round. */}
    <p><a href="/games/" data-stable-exit>ดูเกมทั้งหมด</a></p>

    {/* gameId lets the panel know whether a stranded checkpoint belongs to this page or another game (#23).
         Tool pages don't pass this prop, so there's no round to ask about at all. */}
    <PlayerSetup min={game.players[0]} max={game.players[1]} gameId={game.id} />

    <div id="stage" data-game-id={game.id}></div>

    <PassPhone />

    <section id="how-to-play">
      <h2>วิธีเล่น</h2>
      <ol>
        {game.seo.steps.map((step) => <li>{step}</li>)}
      </ol>

      {game.ads && <div class="ad-slot" aria-hidden="true" style="min-height: 250px;"></div>}
    </section>
  </main>

  {/* ponytail: outside <main> as #35 prescribed. Safe only while nothing gives <main> a width or font
       this nav should share — today nothing does (tokens.css was :root-only; #39 added #leave-confirm
       rules to it, still scoped to that one id, so <main> is still untouched). Watch <main> itself, not a
       list of stylesheets: Astro bundles <style is:global>, a bare `import './x.css'`, and a <style> block
       here all page-globally, so that set belongs to the bundler, not to this comment. The moment <main>
       gets a width or font, move this inside it (that is what tool pages already do). */}
  <GameNav navClass="game-next" excludeId={game.id} />

  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
</Base>

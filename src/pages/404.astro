---
// design/NotFoundDesktop.dc.html is the base and design/NotFound320.dc.html takes over at 1099px;
// the layout and values now live in FeedbackResult, which gh#292 lifted out of this page for the
// feedback result pages. gh#292 adds the outline pill to the feedback page (owner pick 2026-11-04:
// the category-and-tools placement includes this page). No script (ADR-0005).
import Base from '../layouts/Base.astro';
import PageChrome from '../components/PageChrome.astro';
import FeedbackResult from '../components/FeedbackResult.astro';
---

<Base title="ไม่พบหน้านี้ — วัดดวง" description="ไม่พบหน้าที่คุณต้องการ ลองกลับไปหน้าแรก" noindex chrome>
  <PageChrome>
    <FeedbackResult
      heading="ไม่พบหน้านี้"
      lead="ขออภัย ไม่พบหน้าที่คุณต้องการ"
      primary={{ label: 'กลับหน้าแรก', href: '/' }}
      secondary={{ label: 'ติชม / เสนอเกม', href: '/feedback/' }}
    />
  </PageChrome>
</Base>

---
// gh#292: the feedback page, direction A of design/Gh292FeedbackProposals.dc.html (owner pick
// 2026-11-04): two pop cards, two native forms. Each form posts to /api/feedback, the Function App
// the SWA links at /api (ADR-0074); the server answers with a 303 to /feedback/sent/ or
// /feedback/failed/. No script of any kind (ADR-0005), so a same-origin form post needs no CSP edit.
// Every Thai string is the sheet's COPY block, verbatim. Field caps match the server's LIMITS in
// services/feedback/src/record.mjs; the server is the one that holds them.
import Base from '../../layouts/Base.astro';
import PageChrome from '../../components/PageChrome.astro';

const PRIVACY =
  'เราเก็บข้อความและอีเมล (ถ้ากรอก) ไว้อ่านและตอบกลับเท่านั้น ไม่ส่งต่อให้ใคร และลบอัตโนมัติภายใน 6 เดือน อยากให้ลบก่อนนั้น ส่งคำขอผ่านหน้านี้พร้อมอีเมลที่ใช้';
---

<Base
  title="ติชมและเสนอเกม — วัดดวง"
  description="ติชม แจ้งปัญหา หรือเสนอเกมใหม่ให้ผู้พัฒนาวัดดวง อ่านเองทุกข้อความ"
  chrome
>
  <PageChrome>
  <main>
    <header class="fb-head">
      <div class="fb-head-inner">
        <h1>บอกผู้พัฒนาหน่อย</h1>
        <p class="lead">ชอบอะไร อยากให้แก้ตรงไหน หรืออยากได้เกมใหม่ เขียนมาได้เลย ผู้พัฒนาอ่านเองทุกข้อความ</p>
      </div>
    </header>

    <div class="fb-body">
      <div class="fb-grid">
        <form class="fb-card" method="post" action="/api/feedback" aria-labelledby="fb-feedback-title">
          <h2 id="fb-feedback-title" class="fb-card-head fb-card-head-feedback">ติชม / แจ้งปัญหา</h2>
          <div class="fb-card-body">
            <input type="hidden" name="kind" value="feedback" />
            {/* The honeypot: off-screen and out of the tab order, so only a bot fills it. */}
            <div class="fb-hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
            <div class="fb-field">
              <label class="fb-label" for="fb-message">ข้อความ</label>
              <textarea class="fb-input fb-area" id="fb-message" name="message" required maxlength="2000" placeholder="เช่น เกมไหนสนุก ตรงไหนใช้ยาก หรือเจออะไรแปลกๆ"></textarea>
            </div>
            <div class="fb-field">
              <label class="fb-label" for="fb-email">อีเมล (ไม่บังคับ)</label>
              <input class="fb-input" id="fb-email" type="email" name="email" maxlength="254" autocomplete="email" aria-describedby="fb-email-hint" />
              <span class="fb-hint" id="fb-email-hint">กรอกถ้าอยากให้ตอบกลับ</span>
            </div>
            <button class="fb-submit ui-press" type="submit">ส่งความเห็น</button>
          </div>
        </form>

        <form class="fb-card" method="post" action="/api/feedback" aria-labelledby="fb-game-title">
          <h2 id="fb-game-title" class="fb-card-head fb-card-head-game">เสนอเกมใหม่</h2>
          <div class="fb-card-body">
            <input type="hidden" name="kind" value="game" />
            <div class="fb-hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
            <div class="fb-field">
              <label class="fb-label" for="game-name">ชื่อเกมหรือไอเดีย</label>
              <input class="fb-input" id="game-name" type="text" name="game_name" required maxlength="120" placeholder="เช่น เกมทายคำใบ้" />
            </div>
            <div class="fb-field">
              <label class="fb-label" for="game-message">เล่นยังไง</label>
              <textarea class="fb-input fb-area" id="game-message" name="message" maxlength="2000" placeholder="เล่าคร่าวๆ ใครโดน แพ้ยังไง"></textarea>
            </div>
            <div class="fb-field">
              <label class="fb-label" for="game-email">อีเมล (ไม่บังคับ)</label>
              <input class="fb-input" id="game-email" type="email" name="email" maxlength="254" autocomplete="email" aria-describedby="game-email-hint" />
              <span class="fb-hint" id="game-email-hint">กรอกถ้าอยากให้ตอบกลับ</span>
            </div>
            <button class="fb-submit ui-press" type="submit">ส่งไอเดียเกม</button>
          </div>
        </form>
      </div>

      <p class="fb-privacy">{PRIVACY}</p>

      <p class="fb-back"><a class="fb-back-link ui-press" href="/">กลับหน้าแรก</a></p>
    </div>
  </main>
  </PageChrome>
</Base>

<style>
  /* Values are design/Gh292FeedbackProposals.dc.html's direction A (ADR-0033). Shared with the tools
     hub: the accent head band (52px block padding, 58px/30px H1, 19px lead), the 1280px track with
     18px inline padding, the pop card (2.5px rule, --radius-lg, --shadow-pop), the back-link card and
     the 1099px single-column reflow. New on the sheet: 16px field text (iOS zooms below 16px), 52px
     inputs, the 56px ink submit pill with gold text. Keyboard focus is the site ring from web.css. */
  main {
    background: var(--color-ground-warm);
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  main a {
    text-decoration: none;
  }

  /* ------------------------------ header -------------------------------- */

  .fb-head {
    background: var(--accent-gold);
    color: var(--color-line-strong);
    border-block-end: 2.5px solid var(--color-line-strong);
  }

  .fb-head-inner {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 18px;
    padding-block: 52px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 58px;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .lead {
    margin: 0;
    max-width: 760px;
    font-size: 19px;
    line-height: 1.6;
  }

  /* ------------------------------ body ---------------------------------- */

  .fb-body {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 18px;
    padding-block: 40px 48px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    box-sizing: border-box;
  }

  .fb-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 20px;
  }

  .fb-card {
    margin: 0;
    background: var(--color-bg);
    border: 2.5px solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .fb-card-head {
    margin: 0;
    padding: 18px 22px;
    border-block-end: 2.5px solid var(--color-line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--color-line-strong);
  }

  .fb-card-head-feedback {
    background: var(--accent-gold);
  }

  .fb-card-head-game {
    background: var(--accent-punch);
  }

  .fb-card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .fb-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fb-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.3;
  }

  .fb-hint {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .fb-input {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 2.5px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    box-sizing: border-box;
  }

  .fb-input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .fb-area {
    min-height: 140px;
    resize: vertical;
  }

  /* Clipped, not display:none, so a bot that skips hidden fields still sees and fills it. */
  .fb-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .fb-submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: var(--color-line-strong);
    color: var(--accent-gold);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
  }

  .fb-privacy {
    margin: 0;
    max-width: 860px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* ------------------------------ back link ----------------------------- */

  .fb-back {
    margin: 0;
  }

  .fb-back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 0 24px;
    background: var(--color-ground-warm);
    border: 2.5px solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-pop);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    color: var(--color-line-strong);
    box-sizing: border-box;
  }

  /* ------------------------------ reflow -------------------------------- */

  /* The site's 1099px reflow; the narrow values are the sheet's 320 board. */
  @media (max-width: 1099px) {
    .fb-head-inner {
      padding-block: 36px;
      padding-inline: 14px;
    }

    h1 {
      font-size: 30px;
      letter-spacing: 0;
    }

    .lead {
      font-size: 16px;
    }

    .fb-body {
      padding-inline: 14px;
      padding-block: 28px 40px;
      gap: 24px;
    }

    .fb-grid {
      grid-template-columns: 1fr;
    }

    .fb-card-head {
      padding: 14px 18px;
      font-size: 20px;
    }

    .fb-card-body {
      padding: 18px;
    }

    .fb-submit {
      align-self: stretch;
    }

    .fb-privacy {
      font-size: 14px;
    }
  }
</style>

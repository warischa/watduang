---
import GameLayout from '../../layouts/GameLayout.astro';
import { games } from '../../games/manifest';
import type { GameModule } from '../../games/types';

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props as { game: GameModule };
---

<GameLayout game={game} />

<script>
  import type { GameContext, GameModule } from '../../games/types';
  import { loadRoster } from '../../shell/roster';
  import { loadSession, type StartKind } from '../../shell/session';
  import { refusalCopy } from '../../shell/player-select';

  // negative-glob lazy loader — must not import manifest.ts/game module here (CONTRACT.md)
  const mods = import.meta.glob<{ default: GameModule }>([
    '../../games/*.ts',
    '!../../games/_*.ts',
    '!../../games/categories.ts',
    '!../../games/manifest.ts',
    '!../../games/types.ts',
  ]);

  const stage = document.getElementById('stage') as HTMLElement;
  const id = stage.dataset.gameId!;
  const load = mods[`../../games/${id}.ts`];
  const writeRefusedEl = document.getElementById('write-refused') as HTMLElement;

  let game: GameModule | null = null;

  function dispose(): void {
    game?.dispose();
  }

  // No client router (ClientRouter) in this project — every navigation is already a full page load.
  // Uses pagehide because on iOS other page-exit events don't fire reliably.
  // persisted = the page entered bfcache and wasn't discarded → must not dispose, because on return
  // visibilitychange will resume handleVisibility() for the same round on its own (catching an elapsed deadline too).
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) dispose();
  });

  document.addEventListener('watduang:start', async (event) => {
    const { players, start } = (event as CustomEvent<{ players: string[]; start: StartKind }>).detail;

    const roster = loadRoster();
    // gh#50 — clear any notice from a previous round. Belt-and-braces, NOT load-bearing today:
    // watduang:start is dispatched from exactly one place (PlayerSetup.astro), and every game play-again
    // button ("เล่นอีกรอบ") remounts via mountInto without it (grepped all five, per that file own
    // instruction not to
    // trust a comment here), and the panel only re-shows after a reload, which starts with the notice
    // already hidden. Kept because nothing else ever re-hides it, so if a future start path does fire
    // this event, a stale notice would otherwise outlive the round it describes.
    writeRefusedEl.hidden = true;
    writeRefusedEl.textContent = '';

    const session = loadSession();
    // gh#50 — drop hidden first, then set the text: role="alert" announces only once hidden drops.
    session.onWriteRefused = (reason) => {
      writeRefusedEl.hidden = false;
      writeRefusedEl.textContent = refusalCopy(reason);
    };
    session.setPlayers(players, start); // gh#53 — the panel's own answer, never inferred from the slot

    const ctx: GameContext = { roster, session };

    try {
      if (!game) {
        game = (await load()).default;
      }
      // Always close the previous round cleanly before mount — mounting again without disposing leaks an
      // AudioContext (iOS caps how many exist), leaks the wake lock, and stacks visibilitychange listeners;
      // no matter how many times this event fires, only one round survives, because the dispose+mount pair
      // runs sync back-to-back (no await between them) and dispose before any mount is a no-op.
      game.dispose();
      game.mount(stage, ctx);
    } catch {
      // gh#54 — neither the import nor the mount had any handling, and requestStart sets root.hidden =
      // true the moment it dispatches. root.hidden IS the liveness bit the panel reads later (it is what
      // planClear is handed as roundLive), so a failed mount left the panel believing a round was
      // running while the stage stayed empty. The player's only remaining control was Clear group, which
      // then asked about a round that did not exist and, on confirm, ran saveGroup([]) — wiping the group
      // they had just ticked. Putting the panel back is what makes the failure non-destructive: the
      // ticked names are still on screen, Start round is pressable again, and Clear group means what its
      // label says.
      //
      // gh#25 — no longer silent. The site owner has written the copy for this case and chosen where it
      // goes: #setup-error, the panel's own pre-start notice node, reached through the panel's showError.
      // NOT #write-refused — that is the node this handler clears and fills above, and it belongs to a
      // refused WRITE. None of refusalCopy's three strings may stand in for it either, and for the same
      // reason: all three name a refused write and this is a mount that never ran, and naming the wrong
      // loss is the defect gh#53 exists to close. showError is module-scoped inside the setup island, so
      // the notice goes back the way the start came — a CustomEvent on document, the mirror of
      // "watduang:start" (PlayerSetup.astro owns the listener and the string). Nothing is logged: this
      // repo has no console calls in src/, so the failure is the panel coming back with that line on it.
      //
      // Deferred to a microtask because the two failure paths unwind at different times, and only one
      // of them has already had root.hidden = true applied by the time this runs. First load: `await
      // load()` suspends, so the catch resumes in a microtask long after requestStart returned — the
      // panel restores over a hidden root and stays up. Second start of the same page: `game` is
      // cached, nothing in the try block awaits, so the throw is caught SYNCHRONOUSLY inside
      // dispatchEvent — the stack is still inside requestStart, which then runs its own
      // `root.hidden = true` (PlayerSetup.astro) on the way out and re-hides the panel this line just
      // restored. That leaves gh#54's exact state one retry deep: no round, panel gone, root.hidden
      // true, so planClear reads roundLive and Clear group wipes the group. queueMicrotask makes the
      // restore outlive the dispatcher in BOTH paths — microtasks run after the stack unwinds, so it
      // always lands after requestStart has finished hiding. Do not "normalise" this by awaiting
      // before dispose()/mount() instead: that pair must stay sync back-to-back (see above).
      // The notice rides that same microtask, and lands after the un-hide: showError announces by
      // dropping the alert node's hidden attribute, and a panel still hidden at that instant — or one
      // requestStart is about to re-hide on the synchronous path above — announces to nobody. One
      // dispatch site, inside this callback, is what makes both unwind paths behave identically.
      const panel = document.getElementById('player-setup');
      if (panel) queueMicrotask(() => {
        panel.hidden = false;
        document.dispatchEvent(new CustomEvent('watduang:mount-failed', { bubbles: true }));
      });
    }
  });
</script>

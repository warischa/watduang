---
import GameLayout from '../../layouts/GameLayout.astro';
import { games } from '../../games/manifest';
import type { GameModule } from '../../games/types';

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props as { game: GameModule };
---

<GameLayout game={game} />

<script>
  import type { GameContext, GameModule } from '../../games/types';
  import { loadRoster } from '../../shell/roster';
  import { loadSession } from '../../shell/session';
  import { refusalCopy } from '../../shell/player-select';

  // negative-glob lazy loader — must not import manifest.ts/game module here (CONTRACT.md)
  const mods = import.meta.glob<{ default: GameModule }>([
    '../../games/*.ts',
    '!../../games/_*.ts',
    '!../../games/manifest.ts',
    '!../../games/types.ts',
  ]);

  const stage = document.getElementById('stage') as HTMLElement;
  const id = stage.dataset.gameId!;
  const load = mods[`../../games/${id}.ts`];
  const writeRefusedEl = document.getElementById('write-refused') as HTMLElement;

  let game: GameModule | null = null;

  function dispose(): void {
    game?.dispose();
  }

  // No client router (ClientRouter) in this project — every navigation is already a full page load.
  // Uses pagehide because on iOS other page-exit events don't fire reliably.
  // persisted = the page entered bfcache and wasn't discarded → must not dispose, because on return
  // visibilitychange will resume handleVisibility() for the same round on its own (catching an elapsed deadline too).
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) dispose();
  });

  document.addEventListener('watduang:start', async (event) => {
    const { players } = (event as CustomEvent<{ players: string[] }>).detail;

    const roster = loadRoster();
    // gh#50 — clear any notice from a previous round. Belt-and-braces, NOT load-bearing today:
    // watduang:start is dispatched from exactly one place (PlayerSetup.astro), and every game play-again
    // button ("เล่นอีกรอบ") remounts via mountInto without it (grepped all five, per that file own
    // instruction not to
    // trust a comment here), and the panel only re-shows after a reload, which starts with the notice
    // already hidden. Kept because nothing else ever re-hides it, so if a future start path does fire
    // this event, a stale notice would otherwise outlive the round it describes.
    writeRefusedEl.hidden = true;
    writeRefusedEl.textContent = '';

    const session = loadSession();
    // gh#50 — drop hidden first, then set the text: role="alert" announces only once hidden drops.
    session.onWriteRefused = (reason) => {
      writeRefusedEl.hidden = false;
      writeRefusedEl.textContent = refusalCopy(reason);
    };
    session.setPlayers(players);

    const ctx: GameContext = { roster, session };

    if (!game) {
      game = (await load()).default;
    }
    // Always close the previous round cleanly before mount — mounting again without disposing leaks an
    // AudioContext (iOS caps how many exist), leaks the wake lock, and stacks visibilitychange listeners;
    // no matter how many times this event fires, only one round survives, because the dispose+mount pair
    // runs sync back-to-back (no await between them) and dispose before any mount is a no-op.
    game.dispose();
    game.mount(stage, ctx);
  });
</script>

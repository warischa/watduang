---
import GameLayout from '../../layouts/GameLayout.astro';
import { games } from '../../games/manifest';
import type { GameModule } from '../../games/types';

// gh#77-gh#81 — one stylesheet per game, so a per-game visual is a file nobody else writes to. This
// page component renders every game URL, and Astro bundles a bare CSS import page-globally, so all of
// these load on all of them: every selector inside is prefixed per game. Shared game-screen
// vocabulary stays in the is:global block at the bottom of this file and is never overridden there.
//
// gh#145 / gh#146 — timebomb.css and short-stick.css were retired: both games run at a play route
// (below) whose own sheet lives under src/play/<id>/, and neither page this route builds could reach
// the stage sheets. Only the dead stylesheets and their imports were removed.
//
// Both stage modules stay, but NOT for the same reason, and the difference matters to whoever
// finally retires them:
//   - src/games/timebomb.ts IS the play route's engine — src/play/timebomb/main.ts has a top-level
//     `import game from '../../games/timebomb.ts'` and mounts it as-is. Deleting it takes down a
//     shipping route.
//   - src/games/short-stick.ts is NOT. src/pages/game/short-stick/play.astro loads
//     src/play/short-stick/main.js, which imports nothing from src/games/. That module survives on
//     its manifest registration alone, which play.astro reads via byId and the card lists read to
//     render the game. Retiring it is a manifest question, not a dead-code deletion.
// See the matching note in src/games/short-stick.ts. Stating this as one rule for both games is what
// this comment said before, and it was false for half of them.
import '../../styles/games/siamsi.css';
import '../../styles/games/daily-fortune.css';
import '../../styles/games/love-match.css';

// gh#149 / ADR-0050 ruling 2 — a game that declares a playRoute runs full screen there, and its
// landing page under /game/<id>/ is DELETED (301 to the play route, public/staticwebapp.config.json).
// Keyed on playRoute, not on category, because that is the exact complement of what the cards link:
// index.astro and c/[category].astro both render `game.playRoute ?? /game/<id>/`, so "this route
// builds a page iff the game has no playRoute" is what keeps every card link resolvable, with no
// second list to drift. Today that is the three fortune games (siamsi, daily-fortune, love-match); ADR-0050 ruling 7
// keeps them page-shaped.
export function getStaticPaths() {
  return games.filter((g) => !g.playRoute).map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props as { game: GameModule };
---

<GameLayout game={game} />

<script>
  import type { GameModule, GameSession } from '../../games/types';
  import { loadRoster } from '../../shell/roster';

  // negative-glob lazy loader — must not import manifest.ts/game module here (CONTRACT.md)
  const mods = import.meta.glob<{ default: GameModule }>([
    '../../games/*.ts',
    '!../../games/_*.ts',
    '!../../games/categories.ts',
    '!../../games/manifest.ts',
    '!../../games/types.ts',
  ]);

  const stage = document.getElementById('stage') as HTMLElement;
  const id = stage.dataset.gameId!;
  const load = mods[`../../games/${id}.ts`];

  let game: GameModule | null = null;

  // gh#96 / ADR-0040 — a page declaring [1, 1] has no setup panel to start it (and since gh#273 no page
  // has one: the panel, its "watduang:start" dispatch and this script's listener for it are deleted).
  // The solo branch at the foot of this script mounts the module itself,
  // straight into the stage, and never through a synthesize start event: a fake one-person roster
  // would push a non-"เกม" through the round machinery (setPlayers, planStart, the roster pill) that
  // ADR-0040 just removed "ดูดวง" from. The written shape is the same dataset channel data-game-id uses,
  // and the validator guarantees the only value that is neither "1,1" nor a party range never builds.
  const isSolo = stage.dataset.players === '1,1';

  // A solo page has no "วง" to remember and no round to write. The module still receives a full
  // GameContext, but its session persists nothing and reports no group: the site-wide slot (a live
  // party round's checkpoint) must not leak onto a page that has no resume to offer, and an empty
  // group keeps any "วง" surface — roster chips, pair picks — from drawing party names on a
  // one-person page.
  const soloSession: GameSession = {
    players: [],
    setPlayers(): void {},
    played: [],
    markPlayed(): void {},
    checkpoint: null,
    saveCheckpoint(): void {},
    clear(): void {},
  };

  function dispose(): void {
    game?.dispose();
  }

  // gh#253 / ADR-0070 — releases the stage's pre-mount reserve (GameLayout keys it on this attribute
  // being absent). Set right after a mount returns, in the same task, so no frame shows the reserve
  // collapse under an unfilled stage; set on a failed import or mount too, or the reserve would sit as
  // an empty hole above the page. Never removed: once the game owns the stage it sizes to its content.
  function settleStage(state: 'mounted' | 'failed'): void {
    stage.dataset.stage = state;
  }

  // No client router (ClientRouter) in this project — every navigation is already a full page load.
  // Uses pagehide because on iOS other page-exit events don't fire reliably.
  // persisted = the page entered bfcache and wasn't discarded → must not dispose, because on return
  // visibilitychange will resume handleVisibility() for the same round on its own (catching an elapsed deadline too).
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) dispose();
  });

  // The solo mount: no event, no round write, the module mounts
  // directly into the stage. A failed mount has no panel to restore and no round to lose — there is
  // nothing to say and nothing to save, so the only recovery is the reload any crashed page leaves
  // the player. The bfcache pagehide pair above disposes this mount like any other.
  if (isSolo) {
    (async () => {
      try {
        if (!game) game = (await load()).default;
        game.dispose(); // no-op before the first mount
        game.mount(stage, { roster: loadRoster(), session: soloSession });
        settleStage('mounted');
      } catch {
        // nothing to restore, nothing lost — see the comment on the branch above. The reserve still
        // goes, so a failed page shows no empty block where the game would have been.
        settleStage('failed');
      }
    })();
  }
</script>

<style is:global>
  /* gh#76 — game-screen classes, styled from design/GamePickLoser.dc.html and shared by every game
     that adopts the pattern. is:global because game modules create this DOM at runtime and Astro
     scoping would never reach it. Colours reference tokens defined in src/styles/tokens.css
     (--color-line-strong #14142b, --color-ground-warm #fff6e0, --color-text, --font-display);
     sizes are the design's own literals. The canvas carries no animation, so none is added here —
     that is the whole reduced-motion story. rgba() pairs are the canvas's literal values. */
  .stage-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    width: 100%;
  }

  .stage-screen p {
    margin: 0;
    text-align: center;
  }

  .game-btn {
    width: 100%;
    border-radius: 16px;
    border: 2.5px solid var(--color-line-strong);
    font-family: var(--font-display);
    cursor: pointer;
    /* the same tokens as .ui-press in web.css; the fortune buttons do not carry that class because
       their rest shadow is translucent, not ink */
    transition:
      transform var(--motion-ui) var(--ease-out),
      box-shadow var(--motion-ui) var(--ease-out);
  }

  .game-btn:disabled {
    cursor: default;
  }

  .game-btn-primary {
    min-height: 64px;
    background: var(--color-line-strong);
    color: var(--color-ground-warm);
    font-weight: 500;
    font-size: 22px;
    box-shadow: 5px 5px 0 rgba(20, 20, 43, 0.3);
  }

  /* The shell's declared secondary-control style. gh#154 deleted its only producer; gh#101's
     love-match redo control ("เปิดใหม่อีกที") is the one producer today. */
  .game-btn-secondary {
    min-height: 56px;
    background: transparent;
    font-weight: 400;
    font-size: 17px;
    color: var(--color-text);
    /* -12px collapses the screen's 22px gap to the design's 10px control-group gap (22 - 10) */
    margin-block-start: -12px;
  }

  /* the brief's verbatim inert look — the arm gate renders the control disabled for its 400ms window */
  .game-btn-secondary:disabled {
    color: rgba(20, 20, 43, 0.45);
    border: 2.5px dashed rgba(20, 20, 43, 0.35);
  }

  /* gh#288 — hover and press, owner pick A. The state rules exclude :disabled: the arm gate renders
     a control disabled for its window and a press on it must neither move nor underline it. Press is
     declared after every hover so a pressed, hovered button shows the press. */
  @media (hover: hover) {
    .game-btn-primary:hover:not(:disabled) {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0 rgba(20, 20, 43, 0.3);
    }

    .game-btn-secondary:hover:not(:disabled) {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }

    /* a HELD control (.sm-hold: its hold stops on pointerleave, with no pointer capture) never
       moves, in any state: a 2px lift plus a 5px press would slide the box out from under a
       stationary pointer and end the hold. Shadow only, the reduced-motion form. */
    .game-btn-primary.sm-hold:hover:not(:disabled) {
      transform: none;
      box-shadow: 7px 7px 0 rgba(20, 20, 43, 0.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-btn {
      transition: box-shadow var(--motion-rm-quick) var(--ease-rm);
    }
  }

  @media (prefers-reduced-motion: reduce) and (hover: hover) {
    .game-btn-primary:hover:not(:disabled) {
      transform: none;
      box-shadow: 7px 7px 0 rgba(20, 20, 43, 0.3);
    }
  }

  .game-btn-primary:active:not(:disabled) {
    transform: translate(5px, 5px);
    box-shadow: none;
  }

  .game-btn-secondary:active:not(:disabled) {
    transform: translate(0, 2px);
    text-decoration: none;
  }

  /* the held control's press, shadow only; it out-ranks the hover override, so it sits after it and
     covers the reduced-motion form as well */
  .game-btn-primary.sm-hold:active:not(:disabled) {
    transform: none;
    box-shadow: none;
  }

  /* reduced motion: nothing moves; the secondary press shows the underline the hover shows */
  @media (prefers-reduced-motion: reduce) {
    .game-btn-primary:active:not(:disabled) {
      transform: none;
      box-shadow: none;
    }

    .game-btn-secondary:active:not(:disabled) {
      transform: none;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }
  }
</style>

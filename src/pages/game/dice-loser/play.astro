---
// The full-screen play route for the dice-loser game (gh#156, owner decision gh#139, ADR-0050 ruling 1).
//
// NOT a verbatim mockup lift. ~/claude/mockup-games/dice-loser IS this game — its test-logic.js
// carries exactly the rule gh#139 describes (three dice each, high-or-low chosen up front, tiebreak
// rounds among the tied) — but its markup also ships a THIRD lose condition, a random cursed number,
// which gh#139 puts out of scope with "Nothing extra". A lift that must be surgically edited is no
// longer a lift and loses the extractor's whole fidelity guarantee, so the route is authored here and
// the mockup's Thai copy is quoted rather than paraphrased. The rule itself lives in
// src/games/dice-loser.ts, where dice-loser.test.mjs pins it.
//
// ONE FILE PER GAME, not a [id] route: each play route's stylesheet styles bare `body` and shared
// game-screen class names, so a dynamic route would load every game's sheet on every play page and let
// them fight. Same reasoning src/pages/game/[id].astro records for its per-game imports.
//
// INDEXABLE, like the other play routes: src/pages/noindex.test.mjs rejects noindex on every page but
// 404.astro, because a site whose business model is organic search must not deindex page by page. The
// two URLs are differentiated by title — this is the app view, /game/dice-loser/ is the landing page.
import Base from '../../../layouts/Base.astro';
// The shared exit X (and the edit-players pill) — page chrome outside the game root, which is where
// ADR-0014 puts a navigation target. It brings its own style and its own arm gate.
import PlayExit from '../../../shell/PlayExit.astro';
import markup from '../../../play/dice-loser/markup.html?raw';
// play.css, not style.css: the thai-comments carve-out exempts the extractor's three basenames inside
// a play folder as verbatim lifts. Nothing here IS a lift, so the file is named off that exemption and
// stays under the full gate.
import '../../../play/dice-loser/play.css';
import { byId } from '../../../games/manifest';

// The manifest is the single source for this game's name and copy — a literal here would be a second
// copy to drift. `names.th`, not `title`: the module declares no `title` field, and reading one puts
// the literal string "undefined" at the front of the built <title>.
const game = byId('dice-loser');
if (!game) throw new Error('dice-loser is not registered in the manifest — this play route has no game to name');
const title = `${game.names.th} — เล่นเต็มจอ`;
const description = game.seo.description;
---

<Base title={title} description={description} ogImage="/og/dice-loser.png" chrome>
  <PlayExit />
  <Fragment set:html={markup} />
</Base>

<script>
  // Bundled, never inline: ADR-0005 and the site CSP (`script-src 'self'`) mean an inline block here
  // executes zero lines. Astro emits this as one external module.
  import '../../../play/dice-loser/main.ts';
</script>

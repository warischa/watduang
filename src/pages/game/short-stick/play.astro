---
// The full-screen play route: the short-stick mockup itself, served through this site so it gets a
// real URL, a real <head>, and a bundler that turns its inline <script> into an external module the
// CSP admits. `/game/short-stick/` keeps the crawlable page — how-to-play prose, JSON-LD, the ad slot
// — and links here; this page is the app view and carries no chrome at all.
//
// ONE FILE PER GAME, not a [id] route. Each mockup's stylesheet styles bare `body` and generic class
// names of its own, so a dynamic route would load every game's sheet on every play page and let them
// fight. The same reasoning src/pages/game/[id].astro already records for its per-game imports, one
// step further: here the sheets cannot be prefixed, because they are lifted verbatim.
//
// INDEXABLE. src/pages/noindex.test.mjs rejects noindex on any page but 404.astro, on the reasoning
// that a site whose business model is organic search must never deindex a page one page at a time.
// The two URLs are differentiated by title instead — this one is the app view, `/game/short-stick/` is
// the landing page that explains the game.
import Base from '../../../layouts/Base.astro';
// gh#144 — the shared exit X, page chrome outside the mockup root. One component for every play
// route; it brings its own style and its own arm gate.
import PlayExit from '../../../shell/PlayExit.astro';
import markup from '../../../play/short-stick/markup.html?raw';
import '../../../play/short-stick/style.css';
// AFTER style.css, always: overrides.css wins on equal specificity only if it comes second.
import '../../../play/short-stick/overrides.css';
import { byId } from '../../../games/manifest';

// The manifest is the single source for the game's name and copy — a literal here would be a second
// copy to drift. `names.th`, not `title`: the module has no `title` field, and reading one silently
// put the literal string "undefined" at the front of the built <title> on the first build.
const game = byId('short-stick');
if (!game) throw new Error('short-stick is not registered in the manifest — this play route has no game to name');
const title = `${game.names.th} — เล่นเต็มจอ`;
const description = game.seo.description;
---

<Base title={title} description={description} ogImage="/og/short-stick.png" chrome>
  <PlayExit />
  <Fragment set:html={markup} />
</Base>

<script>
  // Bundled, never inline: ADR-0005 and the site CSP (`script-src 'self'`) mean an inline block of
  // this size executes zero lines. Astro emits both of these as one external module.
  import '../../../play/short-stick/main.js';
  import '../../../play/short-stick/roster-bridge.ts';
  // The drawn play surface. Imported LAST and it measures rather than drives: it reads the buttons
  // main.js has rendered and paints depth behind them, so the draw logic (and the fairness lock inside
  // it) has no code path into this renderer. See the header of that file.
  import '../../../play/short-stick/stick-canvas.ts';
</script>

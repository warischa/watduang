---
// The full-screen play route: the zero-trigger mockup itself, served through this site so it gets a
// real URL, a real <head>, and a bundler that turns its inline <script> into an external module the
// CSP admits.
//
// This is the game's ONLY page. ADR-0050 ruling 2 deleted the party-game landing pages, and
// getStaticPaths() in src/pages/game/[id].astro builds a landing only for a game with no playRoute —
// so `/game/zero-trigger/` does not exist and how-to-play lives inside the game, behind the 📖
// control the mockup already ships.
//
// ONE FILE PER GAME, not a [id] route. Each mockup's stylesheet styles bare `body` and generic class
// names of its own, so a dynamic route would load every game's sheet on every play page and let them
// fight.
//
// INDEXABLE, deliberately: src/pages/noindex.test.mjs allows noindex on 404.astro alone, because on a
// site whose business model is organic search a page that deindexes itself is the worst available
// outcome.
import Base from '../../../layouts/Base.astro';
// gh#144 — the shared exit X, page chrome outside the mockup root. One component for every play
// route; it brings its own style and its own arm gate.
import PlayExit from '../../../shell/PlayExit.astro';
import markup from '../../../play/zero-trigger/markup.html?raw';
import '../../../play/zero-trigger/style.css';
// AFTER style.css, always: overrides.css wins on equal specificity only if it comes second.
import '../../../play/zero-trigger/overrides.css';
// The MODULE, not `byId()` from the manifest: the module is the single source for this metadata and
// the manifest only decides which modules get a landing URL.
import game from '../../../games/zero-trigger';

// `names.th`, not `title`: the module has no `title` field, and reading one puts the literal string
// "undefined" at the front of the built <title>.
const title = `${game.names.th} — เล่นเต็มจอ`;
const description = game.seo.description;
---

<Base title={title} description={description} ogImage={`/og/${game.og}`} chrome>
  <PlayExit />
  <Fragment set:html={markup} />
</Base>

<script>
  // Bundled, never inline: ADR-0005 and the site CSP (`script-src 'self'`) mean an inline block of
  // this size executes zero lines. Astro emits both of these as one external module.
  import '../../../play/zero-trigger/main.js';
  import '../../../play/zero-trigger/roster-bridge.ts';
</script>

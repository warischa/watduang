---
import Base from '../../layouts/Base.astro';
import { games } from '../../games/manifest';
---

<Base title="เกมทั้งหมด — วัดดวง" description="รวมเกมปาร์ตี้เล่นฟรีทุกเกม เลือกเล่นได้เลย">
  <main>
    <h1>เกมทั้งหมด</h1>
    <ul>
      {
        games.map((game) => (
          <li>
            <a href={`/game/${game.id}/`}>{game.names.th}</a>
            <p>{game.seo.description}</p>
          </li>
        ))
      }
    </ul>

    <p><a href="/tools/">เครื่องมือสุ่ม</a> — วงล้อสุ่มชื่อ จับฉลาก แบ่งทีม สุ่มเลข ใช้รายชื่อวงเดียวกับเกมได้</p>
  </main>
</Base>

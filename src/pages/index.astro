---
// gh#244 — the home page becomes canvas D, Toy Shelf (design/HomeShelfDesktop.dc.html and
// design/HomeShelf320.dc.html; owner pick 2026-10-04 on gh#243). Every value is the artboards' own
// (ADR-0033), read through the landing tokens in src/styles/tokens.css and the landing components.
// Structure is ADR-0058 as amended for gh#244: the page lists every party game again as an art
// shelf, then the fortune and tools rows, each under its own hub heading with a see-all link to its
// hub — those links are what keep landing-claims-check's per-category link resolvable.
//
// Manifest-held copy (game names, taglines, tool names and descriptions, hub headings and bodies,
// the popular heading) is read at build time and never retyped. The hero, the see-all label, the
// FAQ and the ad placeholder are the live page's own copy, approved for reuse (owner ruling
// 2026-10-04 on gh#243); this page invents no Thai. All motion is CSS only (ADR-0005: no inline
// page script) and stops under prefers-reduced-motion.
import Base from '../layouts/Base.astro';
import PageChrome from '../components/PageChrome.astro';
import HomeHero from '../components/landing/HomeHero.astro';
import Section from '../components/landing/Section.astro';
import ArtTile from '../components/landing/ArtTile.astro';
import TextTile from '../components/landing/TextTile.astro';
import { categories } from '../games/categories';
import { games, popularGames, popularGroup, featuredGame } from '../games/manifest';
import { tools, toolsGroup } from '../tools/manifest';
import type { Category, GameModule } from '../games/types';

// One tile model for every game the page shows, wherever it shows it. A tile enters the game by its
// play route wherever one exists (ADR-0050 ruling 2).
const gameTile = (game: GameModule) => ({
  title: game.names.th,
  desc: game.tagline,
  href: game.playRoute ?? `/game/${game.id}/`,
  art: game.cardArt ?? null,
  art2x: game.cardArt2x ?? null,
});

// Art tiles need art and its 2x file. Every party game declares both (validate-games), and the popular
// row and the featured game are party games, so a missing file name here is a manifest regression, said
// loudly.
const withArt = (game: GameModule) => {
  const tile = gameTile(game);
  if (!tile.art || !tile.art2x) throw new Error(`home: ${game.id} renders as an art tile but declares no cardArt and cardArt2x`);
  return { ...tile, art: tile.art, art2x: tile.art2x };
};

// The popular row wiggles in turn, in the canvas order of its three beats.
const TILTS = ['tilt-a', 'tilt-b', 'tilt-c'] as const;

// One row per category, each under the category's own hub pair (ADR-0034) and linking its hub. The
// party row is the art shelf on the ink band and comes first, as the canvas draws it; the fortune
// row is typographic because no art set exists for it. A category this list does not place fails
// the build here rather than going missing from the home page.
const categoryRow = (cat: Category) => ({
  id: cat,
  heading: categories[cat].hubHeading,
  body: categories[cat].hubBody,
  href: `/c/${cat}/`,
  accentVar: `--accent-${categories[cat].accent}` as const,
  games: games.filter((game) => game.category === cat),
});
const ROW_ORDER: Category[] = ['party', 'fortune'];
for (const cat of Object.keys(categories) as Category[]) {
  if (!ROW_ORDER.includes(cat)) throw new Error(`home: category "${cat}" has no row on the home page`);
}
const [partyRow, fortuneRow] = ROW_ORDER.map(categoryRow);

// Tools are not a category (ADR-0032): their row links the tools hub, never a /c/<slug>/ URL, and
// renders the tools hub heading once — the duplicate h2 gh#192 (i) removed does not come back.
const toolsRow = {
  heading: toolsGroup.heading,
  body: toolsGroup.body,
  href: toolsGroup.href,
  accentVar: toolsGroup.accentVar,
  tiles: tools.map((tool) => ({ href: tool.href, title: tool.name, desc: tool.desc })),
};

const featured = withArt(featuredGame);
---

<Base
  title="วัดดวง — ดูดวง สุ่มคนโดน และเครื่องมือสุ่ม ฟรีบนมือถือเครื่องเดียว"
  description="ดูดวง สุ่มคนโดน วงล้อสุ่ม จับฉลาก แบ่งทีม ใช้ฟรีบนมือถือเครื่องเดียว ไม่ต้องโหลดแอป ไม่ต้องสมัคร"
  chrome
>
  <PageChrome>
  <main>
    <HomeHero
      badge="เปิดเว็บแล้วกดเล่นได้เลย"
      titleTop="กดทีเดียว"
      titleLead="รู้เลยว่า"
      titleMark="ใครโดน"
      lead="ไม่ต้องโหลดแอป ไม่ต้องสมัคร"
      ctaLabel="เลือกเกมเลย"
      ctaHref="/c/party/"
      featured={featured}
    />

    {/* The one ad slot canvas D marks, under the hero (owner ruling 2026-10-04 on gh#244: one slot,
        as drawn). The height is reserved, fixed rather than a floor (ADR-0024), so a real unit
        replacing this placeholder shifts nothing above it. */}
    <div class="wrap ad-slot" aria-hidden="true">ช่องโฆษณา</div>

    <div class="wrap popular">
      <Section id="popular" heading={popularGroup.heading}>
        <div class="grid grid-popular">
          {popularGames.map(withArt).map((card, index) => (
            <ArtTile
              variant="popular"
              href={card.href}
              title={card.title}
              desc={card.desc}
              art={card.art}
              art2x={card.art2x}
              tilt={TILTS[index % TILTS.length]}
            />
          ))}
        </div>
      </Section>
    </div>

    <div class="band">
      <div class="wrap">
        <Section id={partyRow.id} tone="dark" heading={partyRow.heading} body={partyRow.body} href={partyRow.href} linkLabel="ดูทั้งหมด →">
          <div class="grid grid-shelf">
            {partyRow.games.map((game) => {
              const card = withArt(game);
              return (
                <ArtTile
                  href={card.href}
                  title={card.title}
                  art={card.art}
                  highlight={game === featuredGame}
                />
              );
            })}
          </div>
        </Section>
      </div>
    </div>

    <div class="wrap row">
      <Section id={fortuneRow.id} heading={fortuneRow.heading} body={fortuneRow.body} href={fortuneRow.href} linkLabel="ดูทั้งหมด →">
        <div class="grid grid-fortune">
          {fortuneRow.games.map(gameTile).map((card) => (
            <TextTile kind="fortune" href={card.href} title={card.title} desc={card.desc} accentVar={fortuneRow.accentVar} />
          ))}
        </div>
      </Section>
    </div>

    <div class="wrap row">
      <Section id="tools" heading={toolsRow.heading} body={toolsRow.body} href={toolsRow.href} linkLabel="ดูทั้งหมด →">
        <div class="grid grid-tools">
          {toolsRow.tiles.map((card) => (
            <TextTile kind="tool" href={card.href} title={card.title} desc={card.desc} accentVar={toolsRow.accentVar} />
          ))}
        </div>
      </Section>
    </div>

    <section class="wrap faq" aria-labelledby="faq">
      <h2 id="faq">คำถามที่เจอบ่อย</h2>
      <div class="faq-item">
        <h3>ต้องโหลดแอปไหม</h3>
        <p>ไม่ต้อง ทุกเกมทำงานในเบราว์เซอร์ เปิดลิงก์แล้วกดเล่นได้เลย</p>
      </div>
      <div class="faq-item">
        <h3>ต้องสมัครสมาชิกไหม</h3>
        <p>ไม่ต้อง ไม่มีการล็อกอิน ชื่อที่ใส่เก็บอยู่ในเครื่องของคุณเอง</p>
      </div>
      <div class="faq-item">
        <h3>เสียเงินไหม</h3>
        <p>ไม่เสีย เล่นได้ทุกเกมทุกเครื่องมือ ไม่มีของที่ต้องปลดล็อก</p>
      </div>
    </section>
  </main>
  </PageChrome>
</Base>

<style>
  /* Canvas D values (ADR-0033): desktop from the 1440 artboard, <= 1099px from the 320 one. Every
     row is the canvas's 1280px box, kept 14px off each edge — the 320 artboard's own gutter —
     wherever the viewport is narrower. Section spacing is the canvas's own margins; the bottom
     padding stands in for the canvas's gap above its footer band. */
  main {
    background: var(--surface-page);
    color: var(--color-text);
    font-family: var(--font-sans);
    padding-block-end: 88px;
  }

  .wrap {
    width: min(1280px, 100% - 28px);
    margin-inline: auto;
  }

  /* content-box on purpose, as the canvas draws it: the 250px is the space a real unit gets, and the
     dashed border sits outside it rather than eating 6px of a 250px creative. */
  .ad-slot {
    margin-top: 40px;
    height: 250px;
    display: grid;
    place-items: center;
    border: 3px dashed var(--ad-line);
    border-radius: 16px;
    color: var(--ink-soft);
    font-size: 16px;
  }

  .grid {
    display: grid;
  }

  .popular {
    margin-top: 88px;
  }

  .grid-popular {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .band {
    margin-top: 96px;
    background: var(--surface-band);
    padding-block: 72px 84px;
  }

  .grid-shelf {
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 64px;
  }

  .row {
    margin-top: 96px;
  }

  .grid-fortune {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: -20px;
  }

  .grid-tools {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: -20px;
  }

  .faq {
    margin-top: 96px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .faq h2 {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
  }

  .faq-item {
    min-width: 0;
    overflow-wrap: anywhere;
    border: 4px solid var(--ink);
    border-radius: 20px;
    padding: 22px;
    background: var(--surface-tile);
  }

  .faq-item h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
  }

  .faq-item p {
    margin: 8px 0 0;
  }

  /* ------------------------------ focus & motion contracts ------------ */

  /* The one focus treatment on the page. :global reaches the anchors the landing components render
     (their scoped attribute is not this file's), so a component never writes an outline of its own.
     On the ink band an ink ring around a tile vanishes against the band, so the ring there takes the
     band's own sun yellow, the colour its see-all pill already uses. */
  main :global(:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .band :global(:focus-visible) {
    outline-color: var(--surface-sun);
  }

  /* Every animation and transition on this page is decorative, so under reduced motion ALL of them
     stop, not a listed few: any motion a later section adds, in this file or in a landing component,
     falls under this rule with no edit. !important is what makes that true against the components'
     scoped selectors; it is the only !important on the page. */
  @media (prefers-reduced-motion: reduce) {
    main :global(*),
    main :global(*::before),
    main :global(*::after) {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 1099px) {
    main {
      padding-block-end: 40px;
    }

    .ad-slot {
      margin-top: 24px;
      height: 100px;
      border-radius: 12px;
      font-size: 14px;
    }

    .popular {
      margin-top: 40px;
    }

    .grid-popular {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 16px;
    }

    .band {
      margin-top: 44px;
      padding-block: 32px 36px;
    }

    /* Four columns between the artboards: two would draw each tile far larger than the desktop's. */
    .grid-shelf {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 12px;
      row-gap: 40px;
      margin-top: 40px;
    }

    .row {
      margin-top: 40px;
    }

    .grid-fortune {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 16px;
    }

    .grid-tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 16px;
    }

    .faq {
      margin-top: 40px;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .faq h2 {
      font-size: 26px;
    }

    .faq-item {
      border-width: 3px;
      border-radius: 16px;
      padding: 14px;
    }

    .faq-item h3 {
      font-size: 18px;
    }

    .faq-item p {
      margin: 6px 0 0;
      font-size: 16px;
    }
  }

  @media (max-width: 639px) {
    .grid-shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

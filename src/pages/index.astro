---
import Base from '../layouts/Base.astro';
import { games } from '../games/manifest';
import { tools } from '../tools/manifest';
---

<Base
  title="วัดดวง — เกมปาร์ตี้เล่นฟรี บนมือถือเครื่องเดียว"
  description="เว็บรวมเกมกลุ่มเล่นฟรี 2-10 คน ส่งมือถือวนกัน เล่นได้ทันทีไม่ต้องโหลดแอป"
>
  <main>
    <h1>วัดดวง</h1>
    <p>เว็บรวมเกมกลุ่มเล่นฟรี 2-10 คน บนเครื่องเดียว ส่งมือถือวนกัน ไม่ต้องโหลดแอป</p>
    <p>
      {games.map((game) => (
        <>
          <a href={`/game/${game.id}/`}>{game.names.th}</a>{' '}
        </>
      ))}
    </p>
    <p><a href="/games/">ดูเกมทั้งหมด</a></p>
    <p>
      <a href="/tools/">เครื่องมือสุ่ม</a> —{' '}
      {tools.map((tool) => (
        <>
          <a href={tool.href}>{tool.name}</a>{' '}
        </>
      ))}
      ใช้รายชื่อร่วมกับเกมได้
    </p>
  </main>
</Base>

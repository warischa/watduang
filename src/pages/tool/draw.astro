---
import Base from '../../layouts/Base.astro';
import ToolNameEntry from '../../components/ToolNameEntry.astro';
import GameNav from '../../components/GameNav.astro';
---

<Base
  title="จับฉลาก — วัดดวง"
  description="จับฉลากออนไลน์ ใส่ชื่อลงกล่องแล้วเลือกว่าจะจับกี่คน กดจับได้ทันที ไม่ซ้ำคนเดิมในรอบเดียวกัน"
>
  <main class="tool-page">
    <header class="tool-head">
      {/* tool chrome (390 artboard) — the back row plus the accent title band; desktop artboards add
          the site-wide top bar above this, which stays home-only per the page-chrome opt-in, so the
          tool chrome renders at every width */}
      <div class="tool-chrome">
        <a href="/tools/" class="tool-back">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#1a1a1a"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          ><path d="M19 12H6"></path><path d="M12 19l-7-7 7-7"></path></svg>
          เครื่องมือสุ่มทั้งหมด
        </a>
        <span class="tool-badge">เครื่องมือ</span>
      </div>

      <div class="tool-band">
        <div class="tool-band-inner">
          <p class="tool-breadcrumb"><a href="/tools/">เครื่องมือสุ่มทั้งหมด</a></p>
          <p class="tool-eyebrow">ไม่ใช่เกม ตอบทันทีในกดเดียว ใครจ่าย ใครไปก่อน แบ่งทีมยังไง</p>
          <h1>จับฉลาก</h1>
          <p class="tool-tagline">ใส่ชื่อลงกล่อง เลือกจำนวนที่จะจับ แล้วกดจับ — คนที่จับไปแล้วจะไม่ถูกจับซ้ำในรอบเดียวกัน</p>
        </div>
      </div>
    </header>

    <div class="tool-column">
      <ToolNameEntry heading="ชื่อในกล่อง" storageKey="watduang:tool:draw-names" ctaLabel="ใส่ชื่อลงกล่อง" />

      {/* The draw itself: heading, field label, button labels, result format and the "เหลือในกล่อง N คน"
          status live in draw.ts/the module strings, all byte-exact from the artboards. Every region that
          a name list or a reveal can grow — the dark result box, the remaining-names list and the status
          note — carries a FIXED height in the stylesheet below, so nothing this page renders at runtime
          can move the ad slot (ADR-0024, the reflow is the hazard). */}
      <section id="draw" class="tool-module" aria-labelledby="draw-heading">
        <h2 id="draw-heading" class="module-title">กล่องฉลาก</h2>

        <div class="draw-grid">
          <div class="draw-left">
            <label class="draw-count">
              จับกี่คน
              <input id="draw-count" type="number" min="1" value="2" inputmode="numeric" />
            </label>

            <div id="draw-result-box" class="draw-result-box"><p id="draw-result" role="status" aria-live="polite"></p></div>

            <div class="draw-actions">
              <button id="draw-go" type="button" disabled aria-describedby="draw-note">จับฉลาก</button>
              <button id="draw-reset" type="button">เริ่มรอบใหม่</button>
            </div>
          </div>

          <div id="draw-box" class="draw-box">
            <h3>ยังอยู่ในกล่อง</h3>
            <ul id="draw-remaining" class="draw-names"></ul>
          </div>

          <p id="draw-note" class="draw-note" role="status" aria-live="polite">
            ยังจับไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงกล่อง"
          </p>
        </div>
      </section>

      {/* Game continuation link sits next to the tool, not below the ad — #11 explains why the tool exists.
           Names no longer flow through the roster (ADR-0039), so the heading drops the "ด้วยวงเดิม" claim
           the games still get from the GameNav default. */}
      <GameNav navClass="draw-next" category="party" heading="เล่นเกมต่อ" />

      {/* Ad always sits below the tool (ADR-0004) · the inline min-height reserves space so content does
           not jump on load. The placeholder copy and split labels are byte-exact from the two draw
           artboards; the 250px reserve stays the runtime floor the artboards do not own. */}
      <div class="ad-slot" aria-hidden="true" style="min-height: 250px;">
        <span class="ad-slot-title">ช่องโฆษณา</span>
        <span class="ad-slot-meta">728 × 90 · ใต้เครื่องมือ · ตาม ADR-0004</span>
        <span class="ad-slot-mobile">ช่องโฆษณา — ใต้เครื่องมือ (ADR-0004)</span>
      </div>

      <section id="how-to-use">
        <h2>วิธีใช้</h2>
        <ol>
          <li>เลือกชื่อจากกลุ่มเดิม หรือพิมพ์ชื่อใหม่เข้าไป แล้วกด "ใส่ชื่อลงกล่อง"</li>
          <li>เลือกจำนวนที่จะจับ แล้วกด "จับฉลาก" ผลขึ้นเป็นตัวหนังสือทันที</li>
          <li>จับต่อได้เรื่อยๆ คนที่จับไปแล้วจะไม่ถูกจับซ้ำ จนกว่าจะกด "เริ่มรอบใหม่"</li>
        </ol>
        <p><a href="/tools/">เครื่องมือสุ่มทั้งหมด</a></p>
      </section>
    </div>
  </main>
</Base>

<style>
  /* Values byte-exact from design/ToolDraw390.dc.html (base block) and design/ToolDrawDesktop.dc.html
     (the min-width: 1100px block; 1100px is the canvas's own "จอแคบกว่า 1100px" boundary) — ADR-0033.
     Tokens stand in wherever the canvas value IS a token (--color-ground-warm, --color-line-strong,
     --color-muted, --color-primary, --accent-sky, the font tokens); #f3efe4 and the rgba() alpha fills
     are canvas literals with no token. Base = 390px artboard, mobile-first. */

  :global(body) {
    background-color: var(--color-ground-warm);
  }

  .tool-page {
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-ground-warm);
  }

  /* tool chrome — 390 artboard's back row and badge */
  .tool-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 2.5px solid var(--color-line-strong);
  }

  .tool-back {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text);
    text-decoration: none;
  }

  .tool-back:hover {
    color: var(--color-primary);
  }

  .tool-badge {
    font-size: 13px;
    font-weight: 500;
    border: 2px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 3px 10px;
  }

  /* title band — accent ground, page title and tagline */
  .tool-band {
    background: var(--accent-sky);
    border-bottom: 3px solid var(--color-line-strong);
  }

  .tool-band-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 20px 22px 20px;
  }

  .tool-eyebrow {
    margin: 0;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-muted);
  }

  .tool-breadcrumb {
    display: none;
  }

  .tool-band h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 1.3;
  }

  .tool-tagline {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
  }

  /* content column: 390 artboard gap/padding; desktop block below retunes them */
  .tool-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
  }

  /* the tool module panel */
  .tool-module {
    background: var(--color-ground-warm);
    border: 2.5px solid var(--color-line-strong);
    border-radius: 20px;
    box-shadow: 5px 5px 0 var(--color-line-strong);
    padding: 18px 16px;
  }

  .module-title {
    margin: 0 0 12px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
  }

  .draw-count {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
  }

  .draw-count input {
    width: 4rem;
    min-height: 48px;
    box-sizing: border-box;
    padding: 0 10px;
    font-size: 18px;
    text-align: center;
    background: var(--color-ground-warm);
    border: 2.5px solid var(--color-line-strong);
    border-radius: 14px;
  }

  /* The result box always renders so a reveal cannot move anything below it (ADR-0024 is the reflow
     doctrine): the "จับได้:" line has a one-line reserve and long results wrap inside the box. */
  .draw-result-box {
    background: var(--color-line-strong);
    color: var(--color-ground-warm);
    border-radius: 16px;
    padding: 14px 16px;
    text-align: center;
    margin-top: 12px;
    /* Fixed height, own scroll: the reveal can be one line or five, and a growing box would push the
       ad slot down. border-box keeps the pad inside it; a longer reveal scrolls in place instead of
       moving the page. A NEW design value, not the .ad-slot reserve this box used to borrow — a
       deliberate ADR-0033 departure (gh#120: the borrowed 250px met a first-time visitor as an empty
       box). 136px = 28px vertical padding + three lines of the 24px display font, measured at 320px
       in a real browser: a five-name realistic reveal needs 108px of text (136 total) and a
       two-name long-name reveal needs the same, so both land inside it exactly. Longer reveals
       scroll, which is what this box's own scrollbar is for. max-height is FORECLOSED here: an empty
       box would collapse to ~0 and grow on the first reveal, which is the gh#114 mechanism. */
    height: 136px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  #draw-result {
    margin: 0;
    min-height: 1.5em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    overflow-wrap: anywhere;
  }

  .draw-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }

  #draw-go {
    min-height: 60px;
    background: var(--accent-sky);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    border: 2.5px solid var(--color-line-strong);
    border-radius: 16px;
    box-shadow: 4px 4px 0 var(--color-line-strong);
    cursor: pointer;
  }

  #draw-reset {
    min-height: 52px;
    background: var(--color-ground-warm);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    border: 2.5px solid var(--color-line-strong);
    border-radius: 14px;
    cursor: pointer;
  }

  /* the remaining box — dashed ground, chips of names still in the box */
  .draw-box {
    border: 2.5px dashed var(--color-line-strong);
    border-radius: 16px;
    padding: 12px 14px;
    background: #f3efe4;
    margin-top: 14px;
    box-sizing: border-box;
  }

  .draw-box h3 {
    margin: 0 0 10px 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
  }

  /* The chip list is the region a loaded name list grows. Fixed height with its own scroll, so any
     number of names of any length leaves the box — and therefore the ad slot below — where it is.
     150px is a NEW design value, a deliberate ADR-0033 departure (gh#120), no longer the .ad-slot
     reserve borrowed: measured at 320px, a full ten-name realistic roster wraps to 4 rows of a 32px
     chip with 6px gaps = 146px, so 150px shows the whole roster without a scrollbar. Long names
     wrap to 10 rows (374px) and scroll, as before. max-height is FORECLOSED: an empty list would
     collapse and grow on the first render — the gh#114 mechanism. */
  .draw-names {
    display: flex;
    flex-wrap: wrap;
    /* align-content is load-bearing, not cosmetic: a wrapping flex container defaults to
       align-content: stretch, so the moment this list got a fixed height every chip grew to fill
       the whole region. Two names rendered as two full-height pills. Caught by a pre-merge review that
       reproduced it in a browser — the ad-reflow probe reads the slot's y only and is blind to it. */
    align-content: flex-start;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 150px;
    overflow-y: auto;
  }

  .draw-names li {
    max-width: 100%;
    font-size: 13px;
    font-weight: 500;
    background: var(--color-ground-warm);
    border: 2px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 4px 12px;
    overflow-wrap: anywhere;
  }

  /* Every legal status line measures one or two line boxes at 320px and 390px (all five texts
     measured in a real browser). An explicit line-height makes the existing one-line 1.5em reserve
     exact, so a two-line floor of 3em is the height EVERY one of them renders at — the note cannot
     change height when a list loads, and no script has to pin it. */
  .draw-note {
    margin: 10px 0 0 0;
    line-height: 1.5;
    /* A BOUND, not a floor. min-height here left the note free to grow, and these strings
       interpolate a user-supplied count that can run to ~21 digits — so the reachable set of note
       texts is not the handful anyone measured, and a third line would move the ad again. Bounding
       the box we own converges; enumerating the strings the user can produce does not. */
    height: 3em;
    overflow-y: auto;
    font-size: 13px;
    color: var(--color-muted);
  }

  /* ad slot — mobile form per the 390 artboard: ground fill, top rule, one centred label; the inline
     min-height 250px keeps the ADR-0004 reserve on every breakpoint */
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    border-top: 2.5px solid var(--color-line-strong);
    background: #f3efe4;
    font-size: 12px;
    color: var(--color-muted);
  }

  .ad-slot-title,
  .ad-slot-meta {
    display: none;
  }

  #how-to-use h2 {
    font-family: var(--font-display);
    color: var(--color-text);
  }

  #how-to-use ol {
    margin: 0;
    padding-inline-start: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  #how-to-use p a {
    color: var(--color-text);
  }

  #how-to-use p a:hover {
    color: var(--color-primary);
  }

  /* desktop block — values from ToolDrawDesktop.dc.html. Minmax(0, 1fr) carries the canvas's 1fr 1fr
     sizing plus a min-track clamp so a very long name cannot widen the column past the module. */
  @media (min-width: 1100px) {
    .tool-chrome,
    .tool-eyebrow {
      display: none;
    }

    .tool-band {
      border-bottom-width: 5px;
    }

    .tool-band-inner {
      gap: 0;
      margin-inline: auto;
      max-width: 1280px;
      width: 100%;
      box-sizing: border-box;
      padding: 40px 0 36px 0;
    }

    .tool-breadcrumb {
      display: block;
      margin: 0 0 8px 0;
      font-size: 14px;
      font-weight: 500;
    }

    .tool-breadcrumb a {
      color: var(--color-text);
      text-decoration: none;
      border-bottom: 2px solid rgba(26, 26, 26, 0.35);
      padding-bottom: 2px;
    }

    .tool-band h1 {
      font-weight: 700;
      font-size: 38px;
      line-height: 1.2;
    }

    .tool-tagline {
      margin: 10px 0 0 0;
      font-size: 17px;
      line-height: 1.7;
      max-width: 56ch;
    }

    .tool-column {
      width: 100%;
      max-width: 940px;
      margin-inline: auto;
      box-sizing: border-box;
      gap: 36px;
      padding: 44px 0 20px 0;
    }

    .tool-module {
      padding: 26px;
    }

    .module-title {
      margin: 0 0 16px 0;
      font-size: 26px;
    }

    .draw-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 30px;
      align-items: start;
    }

    .draw-left {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .draw-count {
      font-size: 16px;
    }

    .draw-count input {
      min-height: 52px;
      font-size: 20px;
    }

    .draw-result-box {
      padding: 18px 22px;
      margin-top: 0;
    }

    #draw-result {
      font-size: 30px;
    }

    .draw-actions {
      gap: 10px;
      margin-top: 0;
    }

    #draw-go {
      min-height: 64px;
      font-size: 22px;
      box-shadow: 5px 5px 0 var(--color-line-strong);
    }

    #draw-reset {
      min-height: 56px;
      font-size: 18px;
      border-radius: 16px;
    }

    .draw-box {
      border-radius: 20px;
      padding: 18px;
      margin-top: 0;
    }

    .draw-box h3 {
      margin: 0 0 12px 0;
      font-size: 16px;
    }

    .draw-names {
      gap: 8px;
    }

    .draw-names li {
      font-size: 14px;
      padding: 6px 14px;
    }

    .draw-note {
      margin: 0;
      font-size: 14px;
    }

    .ad-slot {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 3px dashed rgba(26, 26, 26, 0.35);
      border-radius: 16px;
      background: none;
      font-size: 13px;
    }

    .ad-slot-title {
      display: block;
      font-family: var(--font-display);
      font-weight: 500;
    }

    .ad-slot-meta {
      display: block;
      font-size: 12px;
    }

    .ad-slot-mobile {
      display: none;
    }
  }
</style>

<script>
  import { DrawRound } from '../../tools/draw-round';
  import { type NameSlot } from '../../tools/name-list';

  const countInput = document.getElementById('draw-count') as HTMLInputElement;
  const resultEl = document.getElementById('draw-result') as HTMLElement;
  const noteEl = document.getElementById('draw-note') as HTMLElement;
  const remainingEl = document.getElementById('draw-remaining') as HTMLUListElement;
  const boxEl = document.getElementById('draw-box') as HTMLElement;
  const drawBtn = document.getElementById('draw-go') as HTMLButtonElement;
  const resetBtn = document.getElementById('draw-reset') as HTMLButtonElement;

  // Astro's scoped styles key on the data-astro-cid attribute stamped on template elements only.
  // Chips and team cards are created at runtime, so each gets the attribute copied off a stamped
  // ancestor — the same trap ToolNameEntry documents for its own runtime chips.
  const scopeAttr = Array.from(boxEl.attributes).find((a) => a.name.startsWith('data-astro-cid'));

  // The round itself lives in draw-round.ts: which slots are left, which a press hands out, and who
  // leaves — all keyed on roster position, never on the name string, and unit-tested there because
  // this file is a page script no test can import.
  const round = new DrawRound();

  // One reveal line for every count — a single-slot join is that slot's own name.
  function resultText(slots: NameSlot[]): string {
    return `จับได้: ${slots.map((slot) => slot.name).join(', ')}`;
  }

  function render(): void {
    const left = round.remaining();

    remainingEl.innerHTML = '';
    for (const slot of left) {
      const li = document.createElement('li');
      if (scopeAttr) li.setAttribute(scopeAttr.name, scopeAttr.value);
      li.textContent = slot.name;
      remainingEl.appendChild(li);
    }

    const count = Math.floor(Number(countInput.value));
    const validCount = Number.isFinite(count) && count >= 1;

    if (round.size < 2) {
      drawBtn.disabled = true;
      noteEl.textContent = 'ยังจับไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงกล่อง"';
    } else if (left.length === 0) {
      drawBtn.disabled = true;
      noteEl.textContent = `จับครบทั้ง ${round.size} คนแล้ว — กด "เริ่มรอบใหม่" เพื่อคืนทุกชื่อเข้ากล่อง`;
    } else if (!validCount) {
      drawBtn.disabled = true;
      noteEl.textContent = 'จำนวนที่จะจับต้องเป็นเลขจำนวนเต็มตั้งแต่ 1 ขึ้นไป';
    } else if (count > left.length) {
      drawBtn.disabled = true;
      noteEl.textContent = `เหลือในกล่องแค่ ${left.length} คน จับ ${count} คนไม่ได้ — ลดจำนวน หรือกด "เริ่มรอบใหม่"`;
    } else {
      drawBtn.disabled = false;
      noteEl.textContent = `เหลือในกล่อง ${left.length} คน`;
    }
  }

  // Nothing here measures or reserves any height: the result box, the chip list and the note all
  // carry fixed heights in this page's stylesheet (ADR-0024 — the reflow is the hazard). A script
  // that wrote min-height would beat those fixed heights and bring the reflow straight back.
  function draw(): void {
    const count = Math.floor(Number(countInput.value));

    let picked: NameSlot[];
    try {
      picked = round.pick(count);
    } catch (error) {
      // Last resort — the button is normally disabled first, but if this is reached the user must
      // see the reason as text
      const reason = error instanceof Error ? error.message : 'จับฉลากไม่ได้';
      noteEl.textContent = reason;
      return;
    }

    round.take(picked);
    resultEl.textContent = resultText(picked);
    render();
  }

  // gh#91 — names arrive from the tool's own name panel (ToolNameEntry) on this event, the same
  // channel the shell panel used. The tool stays a listener; its behaviour is untouched.
  document.addEventListener('watduang:start', (event) => {
    round.start((event as CustomEvent<{ players: string[] }>).detail.players);
    resultEl.textContent = '';
    render();
  });

  drawBtn.addEventListener('click', draw);

  resetBtn.addEventListener('click', () => {
    round.reset();
    resultEl.textContent = '';
    render();
  });

  countInput.addEventListener('input', () => {
    render();
  });

  render();
</script>
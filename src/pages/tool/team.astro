---
import Base from '../../layouts/Base.astro';
import ToolNameEntry from '../../components/ToolNameEntry.astro';
import GameNav from '../../components/GameNav.astro';
import PageChrome from '../../components/PageChrome.astro';
import ToolHeader from '../../components/ToolHeader.astro';
// gh#94, owner ruling 2026-08-26: the trailing continue-into-a-game clause was DELETED from
// the SEO description above rather than reworded, the same call made on the wheel's desc in
// src/tools/manifest.ts (which quotes the removed clause for the record). Tools keep no
// roster (ADR-0039) and the continue path now reaches one category, so the promise was no
// longer true. Nothing replaces it; a new clause would be invented Thai.
---

<Base
  title="แบ่งทีม — วัดดวง"
  description="แบ่งทีมออนไลน์ ใส่ชื่อแล้วเลือกจำนวนทีม สุ่มแบ่งให้ทันทีแบบยุติธรรม เปลี่ยนจำนวนทีมแล้วแบ่งใหม่ได้เรื่อยๆ"
  chrome
>
  <PageChrome>
  <main class="tool-page">
    <ToolHeader title="แบ่งทีม" tagline="ใส่ชื่อลงสนาม เลือกจำนวนทีม แล้วสุ่มแบ่งให้ทันที — คนเกินกระจายให้เห็นชัดว่าทีมไหนได้เพิ่ม" />

    <div class="tool-column">
      <ToolNameEntry heading="ชื่อในสนาม" storageKey="watduang:tool:team-names" ctaLabel="ใส่ชื่อลงสนาม" />

      {/* The split: heading, field label, button and the "พร้อมแบ่ง N คน เป็น N ทีม" status are
          byte-exact module strings; team cards read "ทีม N — M คน (ได้คนเกิน)" so the extra member
          is announced in words. ADR-0024 is the reflow doctrine: the card region and the status note
          both carry a FIXED height in the stylesheet below, so neither a loaded name list nor a split
          can move the ad slot. */}
      <section id="team" class="tool-module" aria-labelledby="team-heading">
        <h2 id="team-heading" class="module-title">แบ่งทีม</h2>

        <div class="team-row">
          <label class="team-count">
            จำนวนทีม
            <input id="team-count" type="number" min="1" value="2" inputmode="numeric" />
          </label>
          <button id="team-split" class="tool-go ui-press" type="button" disabled aria-describedby="team-note">แบ่งทีม</button>
        </div>

        <p id="team-note" class="team-note" role="status" aria-live="polite">
          ยังแบ่งไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงสนาม"
        </p>

        <div id="team-result" class="team-cards" role="status" aria-live="polite"></div>
      </section>

      {/* Game continuation link sits next to the tool, not below the ad — #11 explains why the tool exists.
           Names no longer flow through the roster (ADR-0039), so the heading drops the "ด้วยวงเดิม" claim
           the games still get from the GameNav default. */}
      <GameNav navClass="team-next" category="party" heading="เล่นเกมต่อ" />

      {/* Ad always sits below the tool (ADR-0004) · the inline min-height reserves space so content does
           not jump on load; the one label is shared by every tool page. */}
      <div class="ad-slot" aria-hidden="true" style="min-height: 250px;">ช่องโฆษณา</div>

      <section id="how-to-use">
        <h2>วิธีใช้</h2>
        <ol>
          <li>พิมพ์ชื่อในช่อง "ชื่อในสนาม" บรรทัดละ 1 ชื่อ แล้วกด "ใส่ชื่อลงสนาม"</li>
          <li>ใส่จำนวนทีมที่ต้องการ แล้วกด "แบ่งทีม" ผลขึ้นเป็นรายชื่อแยกทีมทันที</li>
          <li>เปลี่ยนจำนวนทีมเมื่อไหร่ก็แบ่งใหม่ให้ทันทีโดยไม่ต้องพิมพ์ชื่อซ้ำ กด "แบ่งทีม" ซ้ำเพื่อสุ่มใหม่ด้วยจำนวนทีมเดิม</li>
        </ol>
        <p><a href="/tools/">เครื่องมือสุ่มทั้งหมด</a></p>
      </section>
    </div>
  </main>
  </PageChrome>
</Base>

<style>
  /* Values byte-exact from design/ToolTeam390.dc.html (base block) and design/ToolTeamDesktop.dc.html
     (the min-width: 1100px block; 1100px is the canvas's own "จอแคบกว่า 1100px" boundary) — ADR-0033.
     Tokens stand in wherever the canvas value IS a token (--color-ground-warm, --color-line-strong,
     --color-muted, --accent-sky, the font tokens); #f3efe4 and the rgba() alpha fills
     are canvas literals with no token. Base = 390px artboard, mobile-first. */

  :global(body) {
    background-color: var(--color-ground-warm);
  }

  .tool-page {
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-ground-warm);
  }

  /* content column: 390 artboard gap/padding; desktop block below retunes them */
  .tool-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
  }

  /* the tool module panel */
  .tool-module {
    background: var(--color-ground-warm);
    border: 2.5px solid var(--color-line-strong);
    border-radius: 20px;
    box-shadow: 5px 5px 0 var(--color-line-strong);
    padding: 18px 16px;
  }

  .module-title {
    margin: 0 0 12px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
  }

  .team-count {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
  }

  .team-count input {
    width: 4rem;
    min-height: 48px;
    box-sizing: border-box;
    padding: 0 10px;
    font-size: 18px;
    text-align: center;
    background: var(--color-ground-warm);
    border: 2.5px solid var(--color-line-strong);
    border-radius: 14px;
  }

  /* The go button's rest rules are wrapped in :where() on purpose: the shared .tool-go:disabled and
     .ui-press hover/press rules (web.css) are class selectors, and an id selector here would
     out-rank them on box-shadow and cursor, so a disabled go would still cast its shadow. */
  :where(#team-split) {
    width: 100%;
    min-height: 60px;
    margin-top: 12px;
    background: var(--accent-sky);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    border: 2.5px solid var(--color-line-strong);
    border-radius: 16px;
    box-shadow: 4px 4px 0 var(--color-line-strong);
    cursor: pointer;
  }

  /* Every legal status line — including the empty one after a split — measures at most two line
     boxes at 320px and 390px (all of them measured in a real browser). An explicit line-height makes
     the existing one-line 1.5em reserve exact, so a two-line floor of 3em is the height EVERY state
     renders at: the note cannot change height when a list loads, and no script has to pin it. */
  .team-note {
    margin: 10px 0 0 0;
    line-height: 1.5;
    /* A BOUND, not a floor — same reason as draw's note: the text interpolates a user-supplied
       team count, so the reachable string set is unbounded and a third line would move the ad. */
    height: 3em;
    overflow-y: auto;
    font-size: 16px;
    color: var(--color-muted);
  }

  /* The result region: fixed height with its own scroll. The card stack it can render is unbounded
     (any number of names of any length), so bounding the box is the only thing that keeps the ad slot
     below from moving, and a taller stack scrolls in place. 185px is a NEW design value, a deliberate
     ADR-0033 departure (gh#120) rather than the .ad-slot reserve borrowed: measured at 320px, the
     default two-team split of a ten-name realistic roster renders two 86.39px cards + the 10px gap
     = 182.78px, so the default reveal fits whole. Three or more teams scroll, as before. max-height
     is FORECLOSED — an empty region would collapse and grow on the first split (gh#114). */
  .team-cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
    height: 185px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  /* Idle slot, variant (i) approved by the owner: before the first split and after a reset the
     region is a light dashed placeholder with no text. :empty holds only while the script leaves no
     child at all, which it does on every clear. The dashed border sits inside the fixed 185px
     (border-box), so the first split moves nothing. */
  .team-cards:empty {
    border: 2.5px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    border-radius: 16px;
  }

  .team-card {
    background: #f3efe4;
    border: 2.5px solid var(--color-line-strong);
    border-radius: 16px;
    padding: 14px 16px;
  }

  .team-card-heading {
    margin: 0 0 6px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }

  .team-card-members {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* The one ad placeholder look shared by the four tool pages: a dashed frame and one label. The
     inline min-height keeps the 250px reserve, and border-box keeps the frame inside it, so the box
     the ad reflow probe measures does not move. Phone and tablet take the smaller radius and label;
     everything from 1100px up takes the desktop pair, written as the complement of the closed
     max-width 1099px query. */
  .ad-slot {
    box-sizing: border-box;
    width: 100%;
    display: grid;
    place-items: center;
    border: 3px dashed var(--ad-line);
    border-radius: 16px;
    color: var(--ink-soft);
    font-size: 16px;
  }

  @media (max-width: 1099px) {
    .ad-slot {
      border-radius: 12px;
      font-size: 14px;
    }
  }

  #how-to-use h2 {
    font-family: var(--font-display);
    color: var(--color-text);
  }

  #how-to-use ol {
    margin: 0;
    padding-inline-start: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  #how-to-use p a {
    color: var(--color-text);
    /* a 44px invisible hit area per the owner ruling on gh#263; the row may grow to hold it */
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Link hover: the muted ink plus a 2px underline is the non-colour cue; instant, no transition. */
  @media (hover: hover) {
    #how-to-use p a:hover {
      color: var(--color-muted);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }
  }

  /* desktop block — values from ToolTeamDesktop.dc.html. Minmax(0, 1fr) carries the canvas's 1fr 1fr
     sizing plus a min-track clamp so a very long name cannot widen a column past the module. */
  @media (min-width: 1100px) {
    .tool-column {
      width: 100%;
      max-width: 940px;
      margin-inline: auto;
      box-sizing: border-box;
      gap: 36px;
      padding: 44px 0 20px 0;
    }

    .tool-module {
      padding: 26px;
    }

    .module-title {
      margin: 0 0 16px 0;
      font-size: 26px;
    }

    .team-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 18px;
    }

    .team-count {
      font-size: 16px;
    }

    .team-count input {
      min-height: 52px;
      font-size: 20px;
    }

    :where(#team-split) {
      flex: 1;
      margin-top: 0;
      min-height: 64px;
      font-size: 22px;
      box-shadow: 5px 5px 0 var(--color-line-strong);
    }

    .team-note {
      margin: 0 0 14px 0;
      font-size: 14px;
    }

    .team-cards {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px;
      margin-top: 0;
    }

    .team-card {
      padding: 16px 18px;
    }

    .team-card-heading {
      margin: 0 0 8px 0;
      font-size: 18px;
    }

    .team-card-members {
      font-size: 15px;
    }
  }
</style>

<script>
  import { splitTeams } from '../../tools/team';

  const countInput = document.getElementById('team-count') as HTMLInputElement;
  const noteEl = document.getElementById('team-note') as HTMLElement;
  const resultEl = document.getElementById('team-result') as HTMLElement;
  const splitBtn = document.getElementById('team-split') as HTMLButtonElement;

  // Astro's scoped styles key on the data-astro-cid attribute stamped on template elements only.
  // Team cards are created at runtime, so each gets the attribute copied off a stamped ancestor —
  // the same trap ToolNameEntry documents for its own runtime chips.
  const scopeAttr = Array.from(resultEl.attributes).find((a) => a.name.startsWith('data-astro-cid'));

  let players: string[] = [];
  // Whether a split already exists — controls whether changing the team count should re-split
  // immediately or just update the status text
  let hasResult = false;
  function currentCount(): number {
    return Math.floor(Number(countInput.value));
  }

  // Reason splitting isn't possible right now (shown to the user), or null if ready to split
  function blockedReason(): string | null {
    if (players.length < 2) {
      return 'ยังแบ่งไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงสนาม"';
    }
    const count = currentCount();
    if (!Number.isInteger(count) || count < 1) {
      return 'จำนวนทีมต้องเป็นเลขจำนวนเต็มตั้งแต่ 1 ขึ้นไป';
    }
    if (count > players.length) {
      return `ขอ ${count} ทีมไม่ได้ เพราะมีคนแค่ ${players.length} คน`;
    }
    return null;
  }

  function render(): void {
    const reason = blockedReason();
    splitBtn.disabled = reason !== null;
    if (reason) {
      noteEl.textContent = reason;
    } else if (!hasResult) {
      noteEl.textContent = `พร้อมแบ่ง ${players.length} คน เป็น ${currentCount()} ทีม`;
    } else {
      noteEl.textContent = '';
    }
  }

  function renderTeamsInto(container: HTMLElement, teams: string[][]): void {
    container.innerHTML = '';
    const sizes = teams.map((t) => t.length);
    const minSize = Math.min(...sizes);
    teams.forEach((team, i) => {
      const card = document.createElement('div');
      // Each new card carries the reveal class: a single wrapper would collapse the card grid and
      // the flex gap, and the cards are the freshly inserted nodes either way.
      card.className = 'team-card wd-reveal';
      if (scopeAttr) card.setAttribute(scopeAttr.name, scopeAttr.value);
      // Status conveyed by text, not colour alone — reads as plain words
      const extra = team.length > minSize ? ' (ได้คนเกิน)' : '';
      const heading = document.createElement('p');
      heading.className = 'team-card-heading';
      if (scopeAttr) heading.setAttribute(scopeAttr.name, scopeAttr.value);
      heading.textContent = `ทีม ${i + 1} — ${team.length} คน${extra}`;
      const members = document.createElement('p');
      members.className = 'team-card-members';
      if (scopeAttr) members.setAttribute(scopeAttr.name, scopeAttr.value);
      members.textContent = team.join(', ');
      card.appendChild(heading);
      card.appendChild(members);
      container.appendChild(card);
    });
  }

  // Nothing here measures or reserves a height: the card region and the note both carry fixed
  // heights in this page's stylesheet (ADR-0024 — the reflow is the hazard). A script writing
  // min-height would beat those fixed heights and bring the reflow straight back.
  function split(): void {
    const reason = blockedReason();
    if (reason) {
      noteEl.textContent = reason;
      return;
    }
    let teams: string[][];
    try {
      // Not passing random = uses splitTeams' own Math.random — re-randomizes every call, no memoization
      teams = splitTeams(players, currentCount());
    } catch (error) {
      // Last resort — the button is normally disabled first, but if this is reached the user must
      // see the reason as text
      const reasonText = error instanceof Error ? error.message : 'แบ่งทีมไม่ได้';
      noteEl.textContent = reasonText;
      return;
    }
    hasResult = true;
    renderTeamsInto(resultEl, teams);
    render();
  }

  // gh#91 — names arrive from the tool's own name panel (ToolNameEntry) on this event, the same
  // channel the shell panel used. The tool stays a listener; its behaviour is untouched.
  document.addEventListener('watduang:start', (event) => {
    players = (event as CustomEvent<{ players: string[] }>).detail.players;
    hasResult = false;
    resultEl.innerHTML = '';
    render();
  });

  splitBtn.addEventListener('click', split);

  // Team count changed: update the live status text on every keystroke, but only re-split once the
  // value is committed (blur/Enter/spinner) — re-splitting mid-type would flash a wrong-count result.
  countInput.addEventListener('input', () => {
    render();
  });
  countInput.addEventListener('change', () => {
    if (hasResult) split();
  });

  render();
</script>
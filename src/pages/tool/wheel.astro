---
import Base from '../../layouts/Base.astro';
import ToolNameEntry from '../../components/ToolNameEntry.astro';
import GameNav from '../../components/GameNav.astro';
---

<Base
  title="วงล้อสุ่มชื่อ — วัดดวง"
  description="วงล้อสุ่มชื่อออนไลน์ ใส่ชื่อในวงแล้วกดหมุน รู้ทันทีว่าใครโดน"
>
  <main>
    <h1>วงล้อสุ่มชื่อ</h1>
    {/* gh#91 removed the tool-to-game name handoff: this tool now keeps its own list and never
        writes the shared roster. The clause promising names flow onward was deleted, not reworded. */}
    <p>ใส่ชื่อในวง กดหมุน แล้วให้ดวงตัดสินว่าใครโดน</p>

    <section id="wheel" aria-labelledby="wheel-heading">
      <div class="wheel-head">
        <h2 id="wheel-heading">วงล้อ</h2>
      </div>

      {/* The stop-mode choice is the reader's: two labelled radios, copy byte-exact from the
          artboard's A/B captions. Checked pill takes the tool accent. */}
      <div class="wheel-mode">
        <label class="wheel-mode-option">
          <input type="radio" name="wheel-mode" value="auto" checked />
          A · หมุนแล้วช้าลงจนหยุดเอง
        </label>
        <label class="wheel-mode-option">
          <input type="radio" name="wheel-mode" value="press" />
          B · หมุนค้างไว้ จนกว่าจะกด "หยุด"
        </label>
      </div>

      {/* One svg 400x400 disc (the artboard's viewBox) inside a button: the whole disc is the spin
          control, labelled "หมุน" like the canvas hub text. Segments, rim and labels are drawn by
          the script into #wheel-group — the hub circle, hub label and fixed pointer below are the
          artboard's own static chrome, byte-exact. */}
      <div class="wheel-stage">
        <button type="button" id="wheel-disc" class="wheel-disc" aria-label="หมุน" aria-describedby="wheel-note">
          <svg viewBox="0 0 400 400" aria-hidden="true">
            <g id="wheel-group"></g>
            <circle cx="200" cy="200" r="46" fill="#fffdf7" stroke="#1a1a1a" stroke-width="7"></circle>
            <text x="200" y="212" text-anchor="middle" font-family="Mitr, sans-serif" font-weight="600" font-size="26" fill="#1a1a1a">หมุน</text>
            <path d="M200 8 l22 40 h-44 z" fill="#fffdf7" stroke="#1a1a1a" stroke-width="6" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>

      <div id="wheel-result" class="wheel-result" role="status" aria-live="polite"></div>
      <p id="wheel-note" class="wheel-note" role="status" aria-live="polite">
        ยังหมุนไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงวงล้อ"
      </p>

      <div class="wheel-actions">
        <button id="wheel-spin" class="wheel-spin" type="button" disabled aria-describedby="wheel-note">หมุน</button>
        {/* The stop control of behaviour B. It renders (disabled, nothing running) whenever B is
            selected, so it never appears mid-spin and never moves the ad below — under
            prefers-reduced-motion B collapses into A and this control stays inert forever. */}
        <button id="wheel-stop" class="wheel-stop" type="button" hidden disabled>หยุด</button>
        <button id="wheel-reset" class="wheel-reset" type="button">คืนทุกชื่อเข้าวงล้อ</button>
      </div>

      <p class="wheel-toggle">
        <label for="wheel-eliminate">
          <input id="wheel-eliminate" type="checkbox" /> เอาคนที่ออกแล้วออกจากวงล้อ
        </label>
      </p>

      <ul id="wheel-names" class="wheel-names"></ul>

      {/* The panel sits BELOW the wheel on this page only: the disc is what the reader came
          for, and it must be the first thing on screen. draw and team keep the panel above. This is a
          deliberate deviation from both wheel artboards under design/, owner-decided (ADR-0033). */}
      <ToolNameEntry heading="ชื่อในวง" storageKey="watduang:tool:wheel-names" ctaLabel="ใส่ชื่อลงวงล้อ" />

      {/* The path into a game sits right next to the tool, not below the ad — #11 says this is the
           whole reason the tool exists. Tools keep no roster of their own by design (ADR-0039), so
           the heading drops the "ด้วยวงเดิม" claim, matching draw/team/number. gh#94: the shared group
           lives in exactly one category, so the list narrows to it — the slug is the ONE thing a tool
           page states, because nothing on this page declares a category for the nav to read. */}
      <GameNav navClass="wheel-next" category="party" heading="เล่นเกมต่อ" />
    </section>

    {/* The ad always sits below the tool (ADR-0004) · min-height reserves the space up front so content
        doesn't jump on load, and nothing may be injected above the content.
        Clearance vs a controls-driven layout shift here is verified by hand only, not in CI.
        See scripts/ad-slot-grid-probe.mjs. */}
    <div class="ad-slot" aria-hidden="true" style="min-height: 250px;"></div>

    <section id="how-to-use">
      <h2>วิธีใช้</h2>
      <ol>
        <li>เลือกชื่อจากกลุ่มเดิม หรือพิมพ์ชื่อใหม่เข้าไป แล้วกด "ใส่ชื่อลงวงล้อ"</li>
        <li>กด "หมุน" หนึ่งครั้งต่อหนึ่งคน ผลขึ้นเป็นตัวหนังสือว่าใครโดน</li>
        <li>อยากไล่ทีละคนจนครบวง ให้ติ๊ก "เอาคนที่ออกแล้วออกจากวงล้อ" แล้วหมุนต่อ</li>
      </ol>
      <p><a href="/tools/">เครื่องมือสุ่มทั้งหมด</a></p>
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-md);
    font-family: var(--font-sans);
    color: var(--color-text);
  }

  /* 320px screen: the disc is fluid below 400px (the desktop artboard's disc size), so it can
     never overflow sideways; aspect-ratio keeps it square whatever the width. */
  .wheel-stage {
    display: flex;
    justify-content: center;
    margin: var(--space-md) 0;
  }

  .wheel-disc {
    display: block;
    width: min(100%, 400px);
    aspect-ratio: 1;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .wheel-disc:disabled {
    cursor: default;
  }

  .wheel-disc svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wheel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .wheel-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
  }

  .wheel-mode {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .wheel-mode-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text);
    border: 2px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
  }

  .wheel-mode-option:has(input:checked) {
    background: var(--accent-sky);
  }

  .wheel-mode-option input {
    margin: 0;
    accent-color: var(--color-line-strong);
  }

  /* The result bar reserves its full height up front (canvas result card on the 390 artboard:
     14px 16px padding, radius 16 — 60px is the artboard's own button min-height, reused here so
     the reserved box matches the canvas proportions), and the script keeps long names on one line
     by shrinking the type, so the ad below never moves when a name appears. The 1.2 line-height is
     the canvas's own title value — without it a 26px result line pushes the bar (and the ad below)
     down by ~8px the moment a name appears, measured live.
     A BOUND, not a floor (gh#120): the shrink is a glyph-advance ESTIMATE, so on a platform whose
     Thai font runs wider it under-shrinks, the name wraps, and a floor let the bar grow. Measured at
     320px in a real browser: empty 28px, one line 59px, two lines 90px — so min-height: 60px held
     the first two and was beaten by the third. 60px is unchanged (the artboard's own button
     min-height, so no ADR-0033 departure); a wrapped name now scrolls in place instead of moving
     the ad. */
  .wheel-result {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 60px;
    overflow-y: auto;
    margin: 0;
    padding: 14px 16px;
    background: var(--color-line-strong);
    color: var(--color-ground-warm);
    border-radius: 16px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  /* A BOUND, not a floor — the confirmed gh#120 reflow on this page. The site ships no @font-face,
     so both the line box and the wrap point are the visitor's OS: min-height: 3em (48px) rendered
     the initial copy at 57px on ubuntu-latest (three 19px lines) and at 48px on macOS, and the -9px
     drop to the floor on the next note text moved the ad slot up. An explicit line-height makes the
     line box 24px everywhere, so an em height is an exact line count.
     4.5em = 72px = three lines is a NEW design value, a deliberate ADR-0033 departure (gh#120):
     measured at 320px in a real browser, every note text this page can emit with a realistic name
     is at most three lines (the initial copy is 2 on macOS and 3 on ubuntu; the single-name and
     last-name-left strings are 3), so the copy a first-time visitor reads shows whole on both.
     Longer texts interpolate a user-supplied name, an unbounded set, and scroll in place —
     bounding the box we own converges, enumerating those strings does not. max-height is
     FORECLOSED: an empty note would collapse and grow on the first text (the gh#114 mechanism). */
  .wheel-note {
    line-height: 1.5;
    height: 4.5em;
    overflow-y: auto;
    margin: var(--space-xs) 0 var(--space-md);
    color: var(--color-muted);
  }

  /* Buttons wrap onto a new line instead of overflowing sideways when the screen is narrower than
     both buttons combined. Colours/heights/radii byte-exact from the 390 artboard's wheel card. */
  .wheel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .wheel-spin,
  .wheel-stop,
  .wheel-reset {
    border: 2.5px solid var(--color-line-strong);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .wheel-spin {
    flex: 1 1 auto;
    min-height: 60px;
    padding: 0 18px;
    background: var(--accent-sky);
    color: var(--color-text);
    font-size: 20px;
    border-radius: 16px;
    box-shadow: 4px 4px 0 var(--color-line-strong);
  }

  .wheel-stop {
    min-height: 56px;
    padding: 0 18px;
    background: var(--color-line-strong);
    color: var(--color-ground-warm);
    font-size: 18px;
    border-radius: 16px;
    box-shadow: 4px 4px 0 rgba(26, 26, 26, 0.3);
  }

  .wheel-reset {
    min-height: 52px;
    padding: 0 18px;
    background: var(--color-ground-warm);
    color: var(--color-text);
    font-size: 16px;
    border-radius: 14px;
  }

  /* The entered-names list is the one region on this page a loaded name list grows, and it sits
     BELOW the disc and the result readout, so bounding it hides neither. Fixed height with its own
     scroll: any number of names of any length now leaves the ad slot below where it is (ADR-0024 —
     the reflow is the hazard). 120px is a NEW design value, a deliberate ADR-0033 departure
     (gh#120) rather than the .ad-slot reserve this list used to borrow: measured at 320px, 120px =
     4 rows of a 24px chip + 3 × var(--space-sm) 8px gaps, and a ten-name realistic roster wraps to
     only 2 rows here. Long names wrap to 7 rows and scroll, as before. max-height is FORECLOSED —
     an empty list would collapse and grow on first render, the gh#114 mechanism. */
  .wheel-names {
    display: flex;
    flex-wrap: wrap;
    /* See the same rule on draw: a wrapping flex line defaults to align-content: stretch, so a
       fixed height stretches every chip to the region's full height. */
    align-content: flex-start;
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
    gap: var(--space-sm);
    height: 120px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .wheel-names li {
    overflow-wrap: anywhere;
  }

  .wheel-names .is-out {
    color: var(--color-muted);
    text-decoration: line-through;
  }

  /* Behaviour B keeps the wheel turning until the stop control is pressed — the 8s linear cycle is
     the canvas's own tool-spin keyframes. Reduced-motion turns it off, like every decorative
     motion on the canvas; the script never even adds the class under that preference. */
  @keyframes wheel-press {
    to {
      transform: rotate(360deg);
    }
  }

  /* SVG elements take transform-origin `0 0`, not the 50% 50% an HTML box gets, so without this
     every rotation pivots on the svg's top-left corner and swings the disc off its own hub. The
     value is the artboard's own centre — the same viewBox 400x400 the hub circle at cx/cy 200 sits
     in, and the same origin index.astro sets on the hero wheel. */
  #wheel-group {
    transform-origin: 200px 200px;
  }

  #wheel-group.is-pressing {
    animation: wheel-press 8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    #wheel-group.is-pressing {
      animation: none;
    }
  }
</style>

<script>
  import {
    landingRotation,
    segmentPath,
    labelGeometry,
    labelFontSize,
    labelText,
    WHEEL_PALETTE,
  } from '../../tools/wheel';
  import { type NameSlot } from '../../tools/name-list';
  import { WheelRound } from '../../tools/wheel-round';

  const disc = document.getElementById('wheel-disc') as HTMLButtonElement;
  const group = document.querySelector<SVGGElement>('#wheel-group')!;
  const resultEl = document.getElementById('wheel-result') as HTMLElement;
  const noteEl = document.getElementById('wheel-note') as HTMLElement;
  const namesEl = document.getElementById('wheel-names') as HTMLUListElement;
  const spinBtn = document.getElementById('wheel-spin') as HTMLButtonElement;
  const stopBtn = document.getElementById('wheel-stop') as HTMLButtonElement;
  const resetBtn = document.getElementById('wheel-reset') as HTMLButtonElement;
  const eliminateBox = document.getElementById('wheel-eliminate') as HTMLInputElement;
  const modeEls = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="wheel-mode"]'));

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Choreography: the canvas gives the mode-B hold (8s linear) but no landing timing, so these
  // three are page constants — mode A: 4 full turns then the landing; mode B: one last arc after
  // the stop press. Flagged in the ticket return, not canvas-sourced.
  const TURNS = 4;
  const SPIN_MS = 2000;
  const STOP_MS = 900;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The round itself lives in wheel-round.ts: which slots are on the disc, which a spin picks, and
  // who a reveal eliminates — all keyed on roster position, never on the name string (duplicates
  // are allowed on purpose, so two players who both typed the same name are two slots and each owes
  // a spin), and unit-tested there because this file is a page script no test can import.
  // Deliberately memory-only, a refresh starts a fresh round (names survive because the tool's own
  // list is localStorage) — tools never touch shell/session.ts.
  const round = new WheelRound();
  let spinning = false;
  let pressMode = false;
  // Cumulative wheel rotation in degrees, owned by the landing math alone. The final angle is
  // computed FROM the picked name, never read back off the wheel to decide the answer.
  let rotation = 0;
  let spinTimer = 0;
  // True while the disc is frozen on the geometry `rotation` encodes for a reveal that already
  // happened. Redrawing it then would move a different name under the pointer than #wheel-result
  // announces — the very defect this page's landing math exists to avoid.
  let discHoldsReveal = false;

  function remaining(): NameSlot[] {
    return round.remaining(eliminateBox.checked);
  }

  function mode(): 'auto' | 'press' {
    const checked = modeEls.find((el) => el.checked);
    return checked?.value === 'press' ? 'press' : 'auto';
  }

  function setRotation(deg: number, transitionFx: string | null): void {
    rotation = deg;
    group.style.transition = transitionFx === null ? 'none' : transitionFx;
    group.style.transform = `rotate(${deg}deg)`;
  }

  // Rebuilds one segment per name — the list that feeds the wheel is `remaining()`, so the disc
  // re-draws when names arrive, when the eliminate box flips, and after every reveal removes one.
  function drawWheel(slots: NameSlot[]): void {
    const names = slots.map((slot) => slot.name);
    while (group.firstChild) group.removeChild(group.firstChild);
    if (names.length === 0) return; // hub, hub label and pointer are static svg chrome

    if (names.length === 1) {
      // one segment IS the whole disc — a filled circle stands in for the degenerate wedge
      const discEl = document.createElementNS(SVG_NS, 'circle');
      discEl.setAttribute('cx', '200');
      discEl.setAttribute('cy', '200');
      discEl.setAttribute('r', '164');
      discEl.setAttribute('fill', WHEEL_PALETTE[0]);
      group.appendChild(discEl);
    } else {
      for (let i = 0; i < names.length; i++) {
        const seg = document.createElementNS(SVG_NS, 'path');
        seg.setAttribute('d', segmentPath(i, names.length));
        seg.setAttribute('fill', WHEEL_PALETTE[i % WHEEL_PALETTE.length]);
        group.appendChild(seg);
      }
    }

    // rim rides inside the rotating group, as on the artboard
    const rim = document.createElementNS(SVG_NS, 'circle');
    rim.setAttribute('cx', '200');
    rim.setAttribute('cy', '200');
    rim.setAttribute('r', '164');
    rim.setAttribute('fill', 'none');
    rim.setAttribute('stroke', '#1a1a1a');
    rim.setAttribute('stroke-width', '7');
    group.appendChild(rim);

    for (let i = 0; i < names.length; i++) {
      const label = labelGeometry(i, names.length);
      const text = document.createElementNS(SVG_NS, 'text');
      text.setAttribute('x', String(label.x));
      text.setAttribute('y', String(label.y));
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('font-family', 'Mitr, sans-serif');
      text.setAttribute('font-weight', '600');
      text.setAttribute('font-size', String(labelFontSize(names.length)));
      text.setAttribute('fill', '#1a1a1a');
      text.setAttribute('transform', `rotate(${label.angle} ${label.x} ${label.y})`);
      text.textContent = labelText(names[i]!, names.length);
      group.appendChild(text);
    }
  }

  // Long names still fit the reserved one-line result bar: shrink the type below the canvas 26px
  // (0.62em glyph-advance estimate, same heuristic as labelText — judged on the rendered page).
  function fitResultFont(): void {
    resultEl.style.fontSize = '';
    const text = resultEl.textContent;
    if (!text) return;
    const inner = resultEl.clientWidth - 32; // the artboard's 16px side padding
    const size = Math.min(26, Math.max(12, Math.floor(inner / (text.length * 0.62))));
    if (size < 26) resultEl.style.fontSize = `${size}px`;
  }

  function render(): void {
    namesEl.innerHTML = '';
    const roster = round.list();
    for (let i = 0; i < roster.length; i++) {
      const name = roster[i]!;
      const isOut = eliminateBox.checked && round.has(i);
      const li = document.createElement('li');
      // State is announced as text, not just color or strikethrough.
      li.textContent = isOut ? `${name} (ออกแล้ว)` : name;
      if (isOut) li.classList.add('is-out');
      namesEl.appendChild(li);
    }

    const left = remaining();
    // Spin still works with one person left — the last person deserves their own result like everyone else, not an unannounced leftover.
    const canSpin = round.size >= 2 && left.length > 0;
    spinBtn.disabled = spinning || !canSpin;
    disc.disabled = spinBtn.disabled;
    stopBtn.hidden = mode() !== 'press';
    stopBtn.disabled = !pressMode;
    for (const el of modeEls) el.disabled = spinning;

    if (spinning) {
      // behaviour B paints its own canvas copy over this, in spin()
      noteEl.textContent = 'กำลังหมุน…';
    } else if (round.size === 0) {
      noteEl.textContent = 'ยังหมุนไม่ได้ — ใส่ชื่ออย่างน้อย 2 ชื่อ แล้วกด "ใส่ชื่อลงวงล้อ"';
    } else if (round.size < 2) {
      // A CTA press with one name reaches this note legitimately — the panel refuses nothing, so this
      // guards the button dying silently (the list is localStorage, so nothing is lost in here).
      noteEl.textContent = `วงล้อมีชื่อเดียว (${roster[0]}) ต้องมีอย่างน้อย 2 ชื่อถึงจะหมุนได้ — รีเฟรชหน้านี้แล้วเลือกชื่อใหม่`;
    } else if (left.length === 0) {
      // Round over: announce once that everyone's out · #wheel-result still holds the last name as "the result", not a separate answer.
      noteEl.textContent = `ออกครบทั้ง ${round.size} คนแล้ว — กด "คืนทุกชื่อเข้าวงล้อ" เพื่อเริ่มรอบใหม่`;
    } else if (left.length === 1) {
      // States who's left, doesn't decide for the wheel — the word announcing "it's you" is only ever emitted by #wheel-result.
      noteEl.textContent = `เหลือ ${left[0]!.name} คนเดียวในวงล้อ — กด "หมุน" อีกครั้งเพื่อเฉลยคนสุดท้าย`;
    } else {
      noteEl.textContent = '';
    }
  }

  function reveal(picked: NameSlot): void {
    spinning = false;
    pressMode = false;
    clearTimeout(spinTimer);
    group.classList.remove('is-pressing');
    // Recording is gated on the same reveal-time read the filter below uses, so the two halves
    // agree (gh#119). Behaviour chosen: record only while the box is checked — ticking applies
    // FORWARD only, never retroactively. An unchecked box promises "picks are not being
    // eliminated", and a player who never asked to eliminate must not be able to uncover three
    // retroactive eliminations by tapping a checkbox. Ticking mid-round still works: spins after
    // the tick are eliminated, spins before it stay on the disc.
    round.reveal(picked, eliminateBox.checked);
    discHoldsReveal = true;
    // Reads state at reveal time, not at spin start — the checkbox can be toggled mid-spin.
    // This can only ever say "who got picked", a past fact that never changes · round state (done yet,
    // who's left) belongs to the note, owned solely by render() — otherwise unchecking after a round
    // ends would leave the result stuck announcing "everyone's out" while the wheel is full again.
    const done = eliminateBox.checked && remaining().length === 0;
    resultEl.textContent = done ? `${picked.name} (คนสุดท้าย)` : picked.name;
    fitResultFont();
    // The disc stays as drawn — re-slicing here would leave `rotation` pointing at an offset into
    // a list that no longer matches what's on screen. The next drawWheel happens at the next
    // spin's entry point (spin() / the stop handler), from the same `left` array the offset indexes.
    render();
  }

  /** The OFFSET into `left` that this spin lands on, or null if nothing can be picked. An offset,
   *  not a name: two slots can carry the same name, so a name cannot say which one was picked. */
  function pickFrom(left: NameSlot[]): number | null {
    try {
      return round.pickFrom(left);
    } catch (error) {
      // Last line of defense — the button is normally disabled before this, but if this is somehow
      // reached, the user must see the reason as text with a way out, not a silently dead button or
      // an error stuck only in the console.
      const reason = error instanceof Error ? error.message : 'หมุนไม่ได้';
      noteEl.textContent = `${reason} — กด "คืนทุกชื่อเข้าวงล้อ" เพื่อเริ่มรอบใหม่`;
      spinBtn.disabled = true;
      disc.disabled = true;
      return null;
    }
  }

  function spin(): void {
    const left = remaining();
    const index = pickFrom(left);
    if (index === null) return;
    const picked = left[index]!;
    // Draw from the SAME array the offset indexes into — the confirmed defect was re-slicing the
    // disc to a shorter list AFTER the rotation had already been computed for this one.
    drawWheel(left);
    discHoldsReveal = false;

    spinning = true;
    pressMode = false;
    resultEl.textContent = '';
    render();

    if (reduceMotion.matches) {
      // Behaviour B collapses into A, and A skips its motion entirely — the wheel still settles
      // onto the answer's landing angle, just without animating there. The stop control never
      // renders live, so there is never a stop with nothing running behind it.
      setRotation(landingRotation(rotation, index, left.length, TURNS), null);
      reveal(picked);
      return;
    }

    if (mode() === 'press') {
      pressMode = true;
      // behaviour B: hold the wheel until the stop control — the canvas's 8s linear cycle.
      group.style.transition = 'none';
      group.style.transform = '';
      group.classList.add('is-pressing');
      // canvas B caption, byte-exact from the desktop artboard
      noteEl.textContent = 'ผลยังไม่ออก — กด "หยุด" แล้วค่อยเฉลยว่าใครโดน';
      stopBtn.hidden = false;
      stopBtn.disabled = false;
      return;
    }

    // behaviour A: the answer is already decided — the wheel animates towards its landing angle.
    setRotation(landingRotation(rotation, index, left.length, TURNS), `transform ${SPIN_MS}ms cubic-bezier(0.2, 0.7, 0.2, 1)`);
    spinTimer = window.setTimeout(() => reveal(picked), SPIN_MS + 60);
  }

  stopBtn.addEventListener('click', () => {
    if (!pressMode) return;
    clearTimeout(spinTimer);

    // Read the live computed transform BEFORE removing .is-pressing — the class removal blanks
    // the animation, and the inline transform was already cleared at spin-entry (:515-516), so
    // reading after would see `none` and snap the wheel back to 0.
    const computedTransform = getComputedStyle(group).transform;
    group.classList.remove('is-pressing');
    pressMode = false;

    // Freeze the decorative hold exactly where it is; then the landing delta runs from that angle.
    // The angle only feeds how much FURTHER to turn — the answer this arc lands on comes from the
    // picker below, never from this reading.
    const m = computedTransform === 'none' ? null : new DOMMatrix(computedTransform);
    const holdAngle = m ? (Math.atan2(m.b, m.a) * 180) / Math.PI || 0 : 0;
    group.style.transition = 'none';
    group.style.transform = `rotate(${holdAngle}deg)`;
    void group.getBoundingClientRect(); // commit the freeze before starting the landing transition

    const left = remaining();
    const index = pickFrom(left);
    if (index === null) {
      spinning = false;
      render();
      return;
    }
    const picked = left[index]!;
    // Same array the offset indexes into — eliminateBox can be toggled mid-hold (it's not disabled
    // while spinning), so the disc must be redrawn from `left` here too, not just at spin() entry.
    drawWheel(left);
    discHoldsReveal = false;

    setRotation(landingRotation(holdAngle, index, left.length, TURNS), `transform ${STOP_MS}ms cubic-bezier(0.2, 0.7, 0.2, 1)`);
    spinTimer = window.setTimeout(() => reveal(picked), STOP_MS + 60);
  });

  // Every path that mutates the round mid-spin has to cancel the pending reveal, or the old
  // round's timer fires into the new round and announces the previous pick as this pick — and
  // marks that name spun, so it drops out of a round it never lost. Three callers reach this:
  // the reset button, a mode switch, and a fresh list arriving from the name panel. It lives in
  // one function because the third caller was written without the guard the first two carry, and
  // a fourth path added later would miss it the same way.
  function cancelPendingSpin(): void {
    clearTimeout(spinTimer);
    spinning = false;
    pressMode = false;
    group.classList.remove('is-pressing');
  }

  // gh#91 — names arrive from the tool's own name panel (ToolNameEntry) on this event, the same
  // channel the shell panel used. The tool stays a listener; its behaviour is untouched.
  document.addEventListener('watduang:start', (event) => {
    cancelPendingSpin();
    round.start((event as CustomEvent<{ players: string[] }>).detail.players);
    discHoldsReveal = false;
    resultEl.textContent = '';
    rotation = 0;
    group.style.transition = 'none';
    group.style.transform = '';
    drawWheel(remaining());
    render();
  });

  disc.addEventListener('click', spin);
  spinBtn.addEventListener('click', spin);

  resetBtn.addEventListener('click', () => {
    // Pressed mid-spin: the pending reveal must be cancelled, otherwise it fills back in the result that was just cleared.
    cancelPendingSpin();
    group.style.transition = 'none';
    group.style.transform = '';
    rotation = 0;
    round.reset();
    discHoldsReveal = false;
    resultEl.textContent = '';
    drawWheel(remaining());
    render();
  });

  eliminateBox.addEventListener('change', () => {
    // Mid-spin, drawing here would desync the disc from the `left` array the pending reveal
    // already committed to. At rest AFTER a reveal, the disc is held on that reveal's geometry for
    // the same reason — remaining() is a name short by then, so a redraw would put a different name
    // under the pointer than #wheel-result announces. Either way the next spin redraws from its own
    // `left`. Never cancelPendingSpin() here — that would swallow the reveal this checkbox is
    // deliberately read again at (see the comment on reveal() above).
    if (!spinning && !discHoldsReveal) drawWheel(remaining());
    render();
  });

  for (const el of modeEls) {
    el.addEventListener('change', () => {
      // Switching mode mid-spin cancels that spin — no mode takes over under a running wheel.
      cancelPendingSpin();
      render();
    });
  }

  render();
</script>
---
import Base from '../../layouts/Base.astro';
import PlayerSetup from '../../shell/PlayerSetup.astro';
import GameNav from '../../components/GameNav.astro';
---

<Base
  title="วงล้อสุ่มชื่อ — วัดดวง"
  description="วงล้อสุ่มชื่อออนไลน์ ใส่ชื่อในวงแล้วกดหมุน รู้ทันทีว่าใครโดน หมุนเสร็จกดต่อเข้าเกมได้เลยโดยไม่ต้องพิมพ์ชื่อใหม่"
>
  <main>
    <h1>วงล้อสุ่มชื่อ</h1>
    <p>ใส่ชื่อในวง กดหมุน แล้วให้ดวงตัดสินว่าใครโดน — หมุนเสร็จกดต่อเข้าเกมได้เลย รายชื่อไหลต่อไปเอง</p>

    <PlayerSetup min={2} max={10} ctaLabel="ใส่ชื่อลงวงล้อ" clearsSession={false} />

    <section id="wheel" aria-labelledby="wheel-heading">
      <h2 id="wheel-heading">วงล้อ</h2>

      <div id="wheel-disc" class="wheel-disc" aria-hidden="true"></div>

      <p id="wheel-result" class="wheel-result" role="status" aria-live="polite"></p>
      <p id="wheel-note" class="wheel-note" role="status" aria-live="polite">
        ยังหมุนไม่ได้ — เลือกหรือเพิ่มชื่ออย่างน้อย 2 ชื่อด้านบน แล้วกด "ใส่ชื่อลงวงล้อ"
      </p>

      <div class="wheel-actions">
        <button id="wheel-spin" type="button" disabled aria-describedby="wheel-note">หมุน</button>
        <button id="wheel-reset" type="button">คืนทุกชื่อเข้าวงล้อ</button>
      </div>

      <p class="wheel-toggle">
        <label for="wheel-eliminate">
          <input id="wheel-eliminate" type="checkbox" /> เอาคนที่ออกแล้วออกจากวงล้อ
        </label>
      </p>

      <ul id="wheel-names" class="wheel-names"></ul>

      {/* The path into a game sits right next to the tool, not below the ad — #11 says this is the
           whole reason the tool exists. Names flow forward via the roster (localStorage), not session,
           so they never clobber a game's stranded checkpoint. */}
      <GameNav navClass="wheel-next" />
    </section>

    {/* The ad always sits below the tool (ADR-0004) · min-height reserves the space up front so content
         doesn't jump on load, and nothing may be injected above the content.
         Clearance vs a controls-driven layout shift here is verified by hand only, not in CI.
         See scripts/ad-slot-grid-probe.mjs. */}
    <div class="ad-slot" aria-hidden="true" style="min-height: 250px;"></div>

    <section id="how-to-use">
      <h2>วิธีใช้</h2>
      <ol>
        <li>เลือกชื่อจากกลุ่มเดิม หรือพิมพ์ชื่อใหม่เข้าไป แล้วกด "ใส่ชื่อลงวงล้อ"</li>
        <li>กด "หมุน" หนึ่งครั้งต่อหนึ่งคน ผลขึ้นเป็นตัวหนังสือว่าใครโดน</li>
        <li>อยากไล่ทีละคนจนครบวง ให้ติ๊ก "เอาคนที่ออกแล้วออกจากวงล้อ" แล้วหมุนต่อ</li>
      </ol>
      <p><a href="/tools/">เครื่องมือสุ่มทั้งหมด</a></p>
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-md);
    font-family: var(--font-sans);
    color: var(--color-text);
  }

  /* 320px screen: the wheel's size tracks viewport width, not a fixed value, so it can't overflow sideways. */
  .wheel-disc {
    width: min(220px, 60vw);
    aspect-ratio: 1;
    margin: var(--space-md) auto;
    border: 8px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
  }

  /* Reserves space for the result up front so content below doesn't shift when a name appears · a long name wraps instead of pushing the layout. */
  .wheel-result {
    min-height: 2em;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .wheel-note {
    min-height: 3em;
    margin: var(--space-xs) 0 var(--space-md);
    color: var(--color-muted);
  }

  /* Buttons wrap onto a new line instead of overflowing sideways when the screen is narrower than both buttons combined. */
  .wheel-actions,
  .wheel-names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .wheel-names {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
  }

  .wheel-names li {
    overflow-wrap: anywhere;
  }

  .wheel-names .is-out {
    color: var(--color-muted);
    text-decoration: line-through;
  }

  @keyframes wheel-spin {
    to {
      transform: rotate(1440deg);
    }
  }

  .wheel-disc.is-spinning {
    animation: wheel-spin 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* Animation off — the result still shows as text in #wheel-result as before (the script reveals it immediately, no wait). */
  @media (prefers-reduced-motion: reduce) {
    .wheel-disc.is-spinning {
      animation: none;
    }
  }
</style>

<script>
  import { pickName } from '../../tools/wheel';

  const disc = document.getElementById('wheel-disc') as HTMLElement;
  const resultEl = document.getElementById('wheel-result') as HTMLElement;
  const noteEl = document.getElementById('wheel-note') as HTMLElement;
  const namesEl = document.getElementById('wheel-names') as HTMLUListElement;
  const spinBtn = document.getElementById('wheel-spin') as HTMLButtonElement;
  const resetBtn = document.getElementById('wheel-reset') as HTMLButtonElement;
  const eliminateBox = document.getElementById('wheel-eliminate') as HTMLInputElement;

  // This constant is the precondition keeping the delayed ad-slot shift (line ~243) outside the
  // double-tap window. NOT gated in CI — see the rejected-tripwire reasoning in
  // scripts/adslot-wheel-delay-probe.mjs. A render() that removes rows instead of appending the
  // finished marker would reintroduce the hazard with SPIN_MS untouched.
  const SPIN_MS = 1200;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let players: string[] = [];
  // Who's already out — deliberately memory-only, a refresh starts a fresh round
  // (names survive because the roster is localStorage) · must never persist to shell/session.ts, because
  // checkpoint is one slot shared site-wide — the moment a tool touches it, any game stranded mid-round is gone.
  const spun = new Set<string>();
  let spinning = false;
  let spinTimer = 0;

  function remaining(): string[] {
    return eliminateBox.checked ? players.filter((name) => !spun.has(name)) : players;
  }

  function render(): void {
    namesEl.innerHTML = '';
    for (const name of players) {
      const isOut = eliminateBox.checked && spun.has(name);
      const li = document.createElement('li');
      // State is announced as text, not just color or strikethrough.
      li.textContent = isOut ? `${name} (ออกแล้ว)` : name;
      if (isOut) li.classList.add('is-out');
      namesEl.appendChild(li);
    }

    const left = remaining();
    // Spin still works with one person left — the last person deserves their own result like everyone else, not an unannounced leftover.
    spinBtn.disabled = spinning || players.length < 2 || left.length === 0;

    if (spinning) {
      noteEl.textContent = 'กำลังหมุน…';
    } else if (players.length === 0) {
      noteEl.textContent = 'ยังหมุนไม่ได้ — เลือกหรือเพิ่มชื่ออย่างน้อย 2 ชื่อด้านบน แล้วกด "ใส่ชื่อลงวงล้อ"';
    } else if (players.length < 2) {
      // Unreachable already — PlayerSetup rejects starting below min, this just guards against the
      // button dying silently if that path is somehow reached (roster is localStorage so nothing is lost; refresh is the correct way back).
      noteEl.textContent = `วงล้อมีชื่อเดียว (${players[0]}) ต้องมีอย่างน้อย 2 ชื่อถึงจะหมุนได้ — รีเฟรชหน้านี้แล้วเลือกชื่อใหม่`;
    } else if (left.length === 0) {
      // Round over: announce once that everyone's out · #wheel-result still holds the last name as "the result", not a separate answer.
      noteEl.textContent = `ออกครบทั้ง ${players.length} คนแล้ว — กด "คืนทุกชื่อเข้าวงล้อ" เพื่อเริ่มรอบใหม่`;
    } else if (left.length === 1) {
      // States who's left, doesn't decide for the wheel — the word announcing "it's you" is only ever emitted by #wheel-result.
      noteEl.textContent = `เหลือ ${left[0]} คนเดียวในวงล้อ — กด "หมุน" อีกครั้งเพื่อเฉลยคนสุดท้าย`;
    } else {
      noteEl.textContent = '';
    }
  }

  function spin(): void {
    const left = remaining();
    let picked: string;
    if (left.length === 1) {
      // One person left = nothing to randomize, but it still has to be revealed as a result.
      // (pickName deliberately throws below 2 names — a non-random pick doesn't belong forced into that.)
      picked = left[0]!;
    } else {
      try {
        picked = pickName(left);
      } catch (error) {
        // Last line of defense — the button is normally disabled before this, but if this is somehow
        // reached, the user must see the reason as text with a way out, not a silently dead button or
        // an error stuck only in the console.
        const reason = error instanceof Error ? error.message : 'หมุนไม่ได้';
        noteEl.textContent = `${reason} — กด "คืนทุกชื่อเข้าวงล้อ" เพื่อเริ่มรอบใหม่`;
        spinBtn.disabled = true;
        return;
      }
    }

    spinning = true;
    resultEl.textContent = '';
    render();

    const reveal = (): void => {
      spinning = false;
      disc.classList.remove('is-spinning');
      spun.add(picked);
      // Reads state at reveal time, not at spin start — the checkbox can be toggled mid-spin.
      // This can only ever say "who got picked", a past fact that never changes · round state (done yet,
      // who's left) belongs to the note, owned solely by render() — otherwise unchecking after a round
      // ends would leave the result stuck announcing "everyone's out" while the wheel is full again.
      const done = eliminateBox.checked && remaining().length === 0;
      resultEl.textContent = done ? `โดน: ${picked} (คนสุดท้าย)` : `โดน: ${picked}`;
      render();
    };

    if (reduceMotion.matches) {
      reveal();
      return;
    }

    disc.classList.remove('is-spinning');
    void disc.offsetWidth; // reflow — otherwise spinning again right away won't restart the animation
    disc.classList.add('is-spinning');
    spinTimer = window.setTimeout(reveal, SPIN_MS);
  }

  // Same name-entry panel the games use — the tool is only a listener, it doesn't change its behavior.
  document.addEventListener('watduang:start', (event) => {
    players = (event as CustomEvent<{ players: string[] }>).detail.players;
    spun.clear();
    resultEl.textContent = '';
    render();
  });

  spinBtn.addEventListener('click', spin);

  resetBtn.addEventListener('click', () => {
    // Pressed mid-spin: the pending reveal must be cancelled, otherwise in 1.2s it fills back in the result that was just cleared.
    window.clearTimeout(spinTimer);
    spinning = false;
    disc.classList.remove('is-spinning');
    spun.clear();
    resultEl.textContent = '';
    render();
  });

  eliminateBox.addEventListener('change', render);

  render();
</script>

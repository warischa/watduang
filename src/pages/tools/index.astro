---
import Base from '../../layouts/Base.astro';
import { tools } from '../../tools/manifest';
---

<Base
  title="เครื่องมือสุ่มทั้งหมด — วัดดวง"
  description="รวมเครื่องมือสุ่มเล่นฟรี วงล้อสุ่มชื่อ จับฉลาก แบ่งทีม สุ่มเลข ใช้ได้ทันทีบนมือถือ ไม่ต้องโหลดแอป"
>
  <main>
    <h1>เครื่องมือสุ่ม</h1>
    <!-- gh#91: the tools left the shared roster (ADR-0039), so the clause promising the list is
         shared with the games was deleted rather than reworded. -->
    <p>เครื่องมือให้คำตอบทันที ไม่มีรอบ ไม่มีลำดับตา คนเดียวก็ใช้ได้</p>

    <ul>
      {
        tools.map((tool) => (
          <li>
            <a href={tool.href}>{tool.name}</a>
            <p>{tool.desc}</p>
          </li>
        ))
      }
    </ul>

    <p><a href="/games/">ดูเกมทั้งหมด</a></p>
  </main>
</Base>

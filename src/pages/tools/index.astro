---
import Base from '../../layouts/Base.astro';

// ponytail: the tool list stays inline here per ADR-0004 — no tool contract or manifest extracted.
// All four tools now exist and still share nothing beyond name/href/desc, so factoring a manifest
// out would be abstraction for its own sake. Revisit only if a fifth tool needs more than these three fields.
const tools = [
  { name: 'วงล้อสุ่มชื่อ', href: '/tool/wheel/', desc: 'ใส่ชื่อในวงแล้วกดหมุน รู้ทันทีว่าใครโดน หมุนเสร็จต่อเข้าเกมได้เลย' },
  { name: 'จับฉลาก', href: '/tool/draw/', desc: 'ใส่ชื่อทั้งวง เลือกว่าจะจั่วกี่คน กดทีเดียวรู้ผล คนที่ออกแล้วไม่ออกซ้ำในรอบเดิม' },
  { name: 'แบ่งทีม', href: '/tool/team/', desc: 'ใส่ชื่อแล้วบอกว่าอยากได้กี่ทีม แบ่งให้ทันที จำนวนคนแต่ละทีมต่างกันไม่เกินหนึ่งคน' },
  { name: 'สุ่มเลข', href: '/tool/number/', desc: 'ตั้งเลขต่ำสุดกับสูงสุดแล้วกดสุ่ม เลือกได้ว่าจะให้เลขซ้ำได้ หรือห้ามซ้ำในรอบเดียวกัน' },
];
---

<Base
  title="เครื่องมือสุ่มทั้งหมด — วัดดวง"
  description="รวมเครื่องมือสุ่มเล่นฟรี วงล้อสุ่มชื่อ จับฉลาก แบ่งทีม สุ่มเลข ใช้ได้ทันทีบนมือถือ ไม่ต้องโหลดแอป"
>
  <main>
    <h1>เครื่องมือสุ่ม</h1>
    <p>เครื่องมือให้คำตอบทันที ไม่มีรอบ ไม่มีลำดับตา คนเดียวก็ใช้ได้ ใช้รายชื่อร่วมกับเกมในเว็บนี้ได้เลย</p>

    <ul>
      {
        tools.map((tool) => (
          <li>
            <a href={tool.href}>{tool.name}</a>
            <p>{tool.desc}</p>
          </li>
        ))
      }
    </ul>

    <p><a href="/games/">ดูเกมทั้งหมด</a></p>
  </main>
</Base>

---
// The one exit control on every full-screen play route (gh#144, owner ruling in gh#143): the same X,
// in the same corner, on /game/*/play/, leaving to the home page. Imported by all three play.astro
// files so there is one implementation and one stylesheet — a per-route copy is the thing that drifts.
//
// A <button> that navigates, NOT an <a href>. Two reasons, and the first is the guard:
//   1. The arm-gate class this control reuses renders a control inert by setting `disabled` — an
//      attribute only a form control has. An anchor can be dimmed but stays tappable, which is
//      exactly the "the guard is itself a live tap surface when idle" failure this ticket names.
//   2. ADR-0014 keeps navigation targets out of the game surface. This sits OUTSIDE the mockup root
//      (#app / #app-container) in DOM order and out of flow (position: fixed), so no runtime height
//      change inside the game can pull it under a finger.
//
// The crawlable link is the clipped anchor below, NOT the X. ADR-0050 deleted the party landing
// pages and accepted that deletion on the condition that the landing's job — how-to-play and the one
// outbound link — moves onto the play route, so "the landing page is the crawl surface" (what this
// comment used to say) stopped being true and every play page shipped with zero anchors. The anchor
// is static markup, never emitted by script, and it is clipped rather than hidden: display:none or
// visibility:hidden would take it out of the accessibility tree, and an anchor a crawler or a screen
// reader cannot reach is the same dead end as no anchor. It carries no `data-stable-exit` — that
// marker is a closed set of one link in GameLayout.astro (scripts/stable-exit-markers-check.mjs) and
// this is not that link. `pointer-events: none` is why it is not the tap hazard a visible corner
// anchor would be — no contact can reach it in EITHER state, including the focus style that grows it
// over the X — so the arm gate below has nothing to guard here.
//
// Not a leave-confirm. LeaveConfirm.astro is mounted by GameLayout only; play routes have never used
// it, and the ticket's guard is the arm delay, not a dialog. A dialog here would add a second tap
// surface over the game for no ruling that asks for one.
//
// TWO controls now, not a second component (owner decision 2026-08-29): the edit-players control is
// page chrome with exactly the same rules — outside the mockup root, out of flow, and inert until the
// same quiet window has passed. A sibling component would have to either import this file's gate or
// carry a second copy of it, and a second copy of a tap guard is how one of them drifts. One gate now
// drives a list of controls; each control differs only in what its activation does.
---

<a id="play-crawl-home" href="/">กลับหน้าแรก</a>
<button id="play-exit" type="button" aria-label="ออกจากเกม" disabled>✕</button>
<!-- Hidden until the shared player screen announces itself closed: open, it is already what the
     control would offer, and with no screen on the page nothing would answer it. -->
<button id="play-edit-players" type="button" disabled hidden>แก้ผู้เล่น</button>

<style>
  /* The same clip the play routes already use for their live regions (1px box, clip-path, no
     display/visibility change), so the link stays in the served HTML and in the accessibility tree
     while covering no pixel a finger can reach. */
  #play-crawl-home {
    position: fixed;
    top: 0;
    left: 0;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    /* Unconditional, in both states: the focus style below grows this link over the X's corner,
       which is exactly where a tap burst lands, and it has no arm gate of its own. With no pointer
       events it can never BE that tap surface, while Enter on a focused link still navigates and
       both a crawler and the accessibility tree read it unchanged. */
    pointer-events: none;
  }

  /* A keyboard user who tabs to it gets a real, readable link instead of an invisible focus stop.
     Keyboard focus only (:focus-visible), so a pointer can never surface it over the game. */
  #play-crawl-home:focus-visible {
    inline-size: auto;
    block-size: auto;
    z-index: 301;
    padding: 8px 14px;
    clip-path: none;
    border-radius: 0 0 12px 0;
    background: #000;
    color: #fff;
    font-size: 14px;
  }

  /* Fixed, so nothing the game re-renders can move it. z-index 300 clears every layer the three
     mockups declare (highest measured in src/play/**: 200) — the exit stays reachable even over a
     game's own modal. Top-left: the mockups all put their icon buttons at the top RIGHT, so this
     corner is the one that covers no control on any of the three. */
  #play-exit {
    position: fixed;
    top: max(6px, env(safe-area-inset-top));
    left: max(6px, env(safe-area-inset-left));
    z-index: 300;
    /* 44px is the tap-target floor the rest of the site uses; it is also what makes the disabled
       state readable as "not yet", instead of a control that looks the same armed or not. */
    inline-size: 44px;
    block-size: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    /* The three mockups all paint a near-black header behind this corner, so the disc needs its own
       edge or the control disappears into it — measured on the 320px captures, where the first
       version read as a bare glyph. */
    background: rgba(0, 0, 0, 0.6);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  /* Disabled is the armed/not-armed readout. No transition: motion here would need a
     prefers-reduced-motion branch, and an instant opacity change needs neither. */
  /* Still legible, clearly not ready: at 0.35 on a dark header it vanished entirely, and an exit a
     player cannot find is a worse outcome than one that looks dim for 400ms. */
  #play-exit:disabled,
  #play-edit-players:disabled {
    opacity: 0.55;
    cursor: default;
  }

  /* Directly BELOW the X, same left edge (the X is 44px tall from the same inset, so this starts at
     inset + 50px). Top-LEFT is the corner gh#144 measured as covering no control on any of the three
     mockups — their own icon buttons are top-RIGHT, and freeze-tap's second one still ends far to the
     right of this pill at 320px. Beside the X was measured first and rejected on the captures: it
     covers no control, but it sits on all three mockups' header TITLE. The row under the header is
     empty on all three. Bottom was rejected outright: all three put their primary action low on the
     screen, which is where a mid-round tap actually lands. */
  #play-edit-players {
    position: fixed;
    top: calc(max(6px, env(safe-area-inset-top)) + 50px);
    left: max(6px, env(safe-area-inset-left));
    z-index: 300;
    block-size: 44px;
    padding-inline: 14px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.6);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
    color: #fff;
    font-size: 14px;
    font-family: inherit;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  /* `hidden` on a button whose display is set here would otherwise still render. */
  #play-edit-players[hidden] {
    display: none;
  }
</style>

<script>
  // Bundled by Astro, never inline (ADR-0005 + `script-src 'self'`).
  import { ARM_DELAY_MS, inputClockGate } from '../games/_arm-gate';

  const exitBtn = document.getElementById('play-exit') as HTMLButtonElement | null;
  const editBtn = document.getElementById('play-edit-players') as HTMLButtonElement | null;

  // ADR-0071, gh#264. Every play route mounts the shared player screen, and the edit control edits
  // the players IN PLACE: the screen marks <html> with this attribute ('open' / 'closed') and answers
  // EDIT_EVENT itself -- confirming first when a round is live. The names are player-screen.ts's
  // SCREEN_ATTR, STATE_EVENT and EDIT_EVENT, spelled here rather than imported so this chrome pulls no
  // player screen code of its own. The flag-then-reload path through the per-route bridges is retired:
  // no route is left to answer it.
  const SCREEN_ATTR = 'data-player-screen';
  const sharedScreen = (): string | null => document.documentElement.getAttribute(SCREEN_ATTR);

  // One gate, a list of controls. `run` is what a completed, armed tap on that control does;
  // `stays` says the page is still here afterwards, so the one-way `leaving` latch must not close.
  const controls: { el: HTMLButtonElement; run: () => void; stays?: () => boolean }[] = [];
  if (exitBtn) controls.push({ el: exitBtn, run: () => { window.location.href = '/'; } });
  if (editBtn) {
    // Always in the gate's list: hidden it can take no contact, and it is shown later without a
    // second gate.
    controls.push({
      el: editBtn,
      run: () => document.dispatchEvent(new CustomEvent('watduang:edit-players')),
      stays: () => true,
    });
    // The pill is offered exactly while the shared screen is closed: open, it would offer what is
    // already on screen, and with no screen announced nothing would answer it. Its state arrives as
    // an event; the attribute covers a screen that announced itself before this script ran.
    const syncEdit = (): void => {
      const state = sharedScreen();
      if (state !== null) editBtn.hidden = state === 'open';
    };
    document.addEventListener('watduang:player-screen', syncEdit);
    syncEdit();
  }

  if (controls.length > 0) {
    // Same guard CLASS as src/games/_arm-gate.ts — a control is inert until nothing has been touched
    // for ARM_DELAY_MS, and it classifies nothing (no timing heuristic, no click-count), so it
    // converges the way ADR-0016 describes. It is not armAfterQuiet() itself because that helper
    // arms ONCE per rendered screen: the games call it again on every replaceChildren(), while this
    // control outlives every render, so a one-shot arm would leave it permanently live and a mid-round
    // burst at this corner would exit on the first contact. Here the window restarts on every contact.
    let timer: ReturnType<typeof setTimeout> | undefined;
    // Pointers currently down anywhere on the page. The quiet window only runs while this is zero:
    // a finger still on the screen is not "quiet", so a press-and-hold can never arm the X under
    // its own contact, and a held aim (cannon-flag drags) keeps the X disarmed for a stray second
    // finger. pointercancel is counted like pointerup so a contact leaving the viewport cannot
    // leak the counter high and disarm the X forever.
    let active = 0;
    // gh#190 — the second, independent guard. The timer below keeps owning the visible `disabled`
    // attribute; this decides, from the browser's own dispatch stamp, whether a contact belongs to
    // the quiet window at all. It exists because the two are not the same question: a contact the
    // browser stamped 235.5ms after a transition tap was handled 638ms later, with the timer already
    // expired and the X live, and the round left the play route. `_arm-gate.ts` carries the rule.
    // A `disarm()` called with no event (load, bfcache restore) anchors to nothing, which reads as
    // open and leaves the timer in sole charge — the behaviour this control always had.
    const stamps = inputClockGate();

    const disarm = (ev?: Event): void => {
      if (ev) stamps.hold(ev); else stamps.anchor();
      for (const c of controls) c.el.disabled = true;
      clearTimeout(timer);
      if (active === 0) {
        timer = setTimeout(() => {
          for (const c of controls) c.el.disabled = false;
        }, ARM_DELAY_MS);
      }
    };

    // Capture phase on the document: a game that stops propagation inside its own root still cannot
    // hide a contact from this gate. A contact on the button while it is ALREADY ARMED is the one
    // exception — that is the deliberate tap, and disarming mid-gesture would cancel the click Chrome
    // is about to dispatch (a button disabled between pointerdown and click fires no click at all).
    // Every other contact, including a burst landing on this button while it is disabled, restarts
    // the window — which is what stops a burst from arming the control under its own taps.
    const hit = (ev: Event): (typeof controls)[number] | undefined =>
      ev.target instanceof Node
        ? controls.find((c) => c.el.contains(ev.target as Node))
        : undefined;

    // The control the current press began on, while it was ALREADY ARMED. Activation requires it:
    // without this, a press that starts disabled and outlives the quiet window (hold on a control, or
    // a hold elsewhere arming it mid-gesture) would activate on release.
    let pressed: (typeof controls)[number] | undefined;

    document.addEventListener(
      'pointerdown',
      (ev) => {
        active += 1;
        const target = hit(ev);
        // Three conditions, not two: the control must be armed AND this contact must have been
        // DISPATCHED after the window closed. Without the third one a contact from inside the window
        // that the main thread only got to afterwards reads as a deliberate press.
        if (target && !target.el.disabled && stamps.isOpen(ev)) {
          pressed = target;
          return;
        }
        disarm(ev);
      },
      true,
    );

    // Activation is `pointerup`, not `click`, and that is measured, not stylistic: a real touch on
    // this button inside /game/cannon-flag/play/ dispatches pointerdown, touchstart, pointerup and
    // touchend — and NO click at all (walked 2026-08-29 at 320px; freeze-tap and power-meter do fire
    // one). A click-only handler is therefore dead on one of the three routes. Document capture, so
    // no page-level handler can stop the event before this gate sees it. `click` is kept as the
    // keyboard path (Enter/Space fire click and no pointer events); `leaving` stops the two paths
    // from navigating twice.
    // The exit is a one-way transition off this page, so one flag stops it firing twice — including
    // the pointerup and click paths racing.
    // The edit control is the exception (ADR-0071): it edits in place, the page stays, so the
    // latch stays open and the controls are re-gated instead -- the dialog or screen that just
    // appeared is a reveal, and disabling the pill here is also what stops the click that trails a
    // pointerup from firing it a second time (a disabled button dispatches no click).
    let leaving = false;
    const activate = (control: (typeof controls)[number]): void => {
      if (leaving || control.el.disabled) return;
      if (control.stays?.()) {
        control.run();
        disarm();
        return;
      }
      leaving = true;
      control.run();
    };

    document.addEventListener(
      'pointerup',
      (ev) => {
        active = Math.max(0, active - 1);
        // Touch has implicit pointer capture: a finger that starts here and slides away still lands
        // its pointerup on this button. Require the release point to be inside the box, so a drag
        // off the control cancels it the way a native button does — and require pressArmed, so only
        // a press that STARTED on the armed button can activate.
        const armedPress = pressed;
        pressed = undefined;
        if (armedPress && hit(ev) === armedPress) {
          const r = armedPress.el.getBoundingClientRect();
          const e = ev as PointerEvent;
          const inside =
            e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
          if (inside) {
            activate(armedPress);
            return;
          }
        }
        // Every release restarts the quiet window (scheduling only once no contact remains), so a
        // window that expired under a held finger cannot leave the X armed the instant the hold ends.
        disarm(ev);
      },
      true,
    );
    document.addEventListener(
      'pointercancel',
      (ev) => {
        active = Math.max(0, active - 1);
        pressed = undefined;
        disarm(ev);
      },
      true,
    );
    // Keyboard path only (Enter/Space fire click and no pointer events).
    for (const c of controls) c.el.addEventListener('click', () => activate(c));

    // bfcache: back-navigation restores this page with module state intact and scripts NOT re-run.
    // Without this reset, `leaving` stays true after an exit and the X is permanently dead on the
    // restored page.
    window.addEventListener('pageshow', () => {
      leaving = false;
      active = 0;
      pressed = undefined;
      disarm();
    });

    disarm();
  }
</script>

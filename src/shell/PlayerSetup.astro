---
interface Props { min: number; max: number; ctaLabel?: string; clearsSession?: boolean; gameId?: string }
const { min, max, ctaLabel = 'เริ่มรอบ', clearsSession = true, gameId } = Astro.props as Props;
---
<!-- data-game-id is emitted on game pages only (#23) — it is what tells the island whether the
     checkpoint in the shared slot belongs to this page. Never import a game to ask, and never guess
     from the URL: the id arrives as a prop from GameLayout. -->
<div id="player-setup" data-min={min} data-max={max} data-game-id={gameId}>
  <div id="setup-number-picker">
    <label for="player-count">จำนวนคนเล่น</label>
    <input id="player-count" type="number" min={min} max={max} value={min} />
    <button id="start-numbered" type="button">เริ่มแบบ "คนที่ 1, 2, 3…"</button>
  </div>

  <div id="setup-roster-grid">
    <p>เลือกชื่อจากกลุ่มเดิม หรือเพิ่มชื่อใหม่ — วงที่เล่นล่าสุดจะถูกติ๊กไว้ให้ ถ้าอยากเล่นแบบไม่ใช้ชื่อ กดปุ่ม "เริ่มแบบ คนที่ 1, 2, 3…" ด้านบนได้เลย กลุ่มเดิมยังอยู่ครบ</p>
    <ul id="roster-list"></ul>
    <input id="roster-add-name" type="text" placeholder="เพิ่มชื่อใหม่" />
    <button id="roster-add-btn" type="button">เพิ่ม</button>
  </div>

  <!-- hidden while there is nothing to say — there is no style block here, so an empty <p> would eat
       the UA margin on every page for nothing -->
  <p id="setup-error" role="alert" hidden></p>
  <button id="start-round" type="button">{ctaLabel}</button>

  <!-- #23: a live round of this game is a question, not a choice made on the player's behalf. Neither
       branch can lose a round silently.
       role="alert" so it is announced when the hidden attribute drops, same as #setup-error -->
  <div id="resume-choice" hidden>
    <p role="alert">ยังมีรอบที่เล่นค้างอยู่ จะกลับไปเล่นต่อ หรือเริ่มรอบใหม่กับวงที่เลือกไว้?</p>
    <button id="resume-round" type="button">กลับไปเล่นรอบที่ค้าง</button>
    <button id="fresh-round" type="button">เริ่มรอบใหม่</button>
  </div>
</div>

<!-- Deliberately outside #player-setup: the panel hides itself once a round starts, and this button has
     to stay pressable — otherwise the group cannot be changed at all short of a manual reload.
     data-clears-session is emitted only when the button is switched off (clearsSession={false}), so a
     game page's HTML is byte-for-byte what it always was.

     hidden on tool pages (#23): with clearsSession={false} the click handler is a deliberate no-op
     (ADR-0004 — a tool must not touch the session or the checkpoint a game is mid-round on), and a
     button that does nothing is its own defect. Hidden in the template, not removed: the script
     below reads #clear-group for both the handler and the data flag, and a null there would throw
     and kill the whole island — taking the setup panel with it. -->
<button id="clear-group" type="button" data-clears-session={clearsSession ? undefined : 'no'} hidden={!clearsSession}>ล้างกลุ่มนี้</button>

<!-- #25: this button empties the site-wide session slot, so mid-round it destroys the round while its
     label only mentions the group. It asks first, with two labelled buttons (ADR-0008's shape).
     Outside #player-setup like the button it answers for: root.hidden = true swallows the panel once a
     round starts, and a question the player cannot see would turn ล้างกลุ่มนี้ into a dead control.
     role="alert" so it is announced when the hidden attribute drops, same as #setup-error -->
<div id="clear-choice" hidden>
  <p role="alert">ยังมีรอบที่เล่นค้างอยู่ ถ้าล้างกลุ่มนี้ รอบที่ค้างจะหายไปด้วย</p>
  <button id="clear-confirm" type="button">ล้างและทิ้งรอบที่ค้าง</button>
  <button id="clear-cancel" type="button">ยกเลิก</button>
</div>

<script>
  import { loadRoster, loadGroup, saveGroup } from './roster';
  import { loadSession } from './session';
  import { resolveStart, numberedPlayers, planStart, planClear, type ResumeChoice } from './player-select';

  const root = document.getElementById('player-setup') as HTMLElement;
  const min = Number(root.dataset.min);
  const max = Number(root.dataset.max);
  // undefined on tool pages — there is no game to resume there, so no live round to ask about (#23)
  const gameId = root.dataset.gameId;

  const roster = loadRoster();

  const rosterList = document.getElementById('roster-list') as HTMLUListElement;
  const countInput = document.getElementById('player-count') as HTMLInputElement;
  const addNameInput = document.getElementById('roster-add-name') as HTMLInputElement;
  const addBtn = document.getElementById('roster-add-btn') as HTMLButtonElement;
  const startBtn = document.getElementById('start-round') as HTMLButtonElement;
  const startNumberedBtn = document.getElementById('start-numbered') as HTMLButtonElement;
  const errorEl = document.getElementById('setup-error') as HTMLElement;
  const clearBtn = document.getElementById('clear-group') as HTMLButtonElement;
  const resumeChoiceEl = document.getElementById('resume-choice') as HTMLElement;
  const resumeBtn = document.getElementById('resume-round') as HTMLButtonElement;
  const freshBtn = document.getElementById('fresh-round') as HTMLButtonElement;
  const clearChoiceEl = document.getElementById('clear-choice') as HTMLElement;
  const clearConfirmBtn = document.getElementById('clear-confirm') as HTMLButtonElement;
  const clearCancelBtn = document.getElementById('clear-cancel') as HTMLButtonElement;

  // True until "เริ่มรอบ" is pressed a second time — the first click over max only warns (#21).
  // Must reset whenever the group changes, or one warning would last the whole life of the page.
  let overMaxWarned = false;

  // The last group comes pre-ticked — walking from a tool page into a game must not mean ticking it
  // all over again (#15). loadGroup() has already dropped names that left the roster · first visit or
  // never started a round = the empty set, as before.
  const selected = new Set<string>(loadGroup());

  // Drop hidden first, then set the text: role="alert" announces only while the node is visible
  function showError(text: string): void {
    errorEl.hidden = text === '';
    errorEl.textContent = text;
    // Every refusal or warning before a start runs through this one function (over max, below min).
    // Having refused, an open resume question would still be holding the group the panel just turned
    // down, and pressing "เริ่มรอบใหม่" would start with it. A warning and a question must never share
    // the screen: the panel must not point at the path it has just closed (#23).
    if (text !== '') cancelResumeChoice();
  }

  // #23: the group waiting on an answer about the live round — null = nobody has been asked yet
  let pendingStart: string[] | null = null;

  // The group changed after the question appeared = the question is holding the old one. Close it and
  // make them press start again; otherwise "เริ่มรอบใหม่" starts with the group the player just edited
  // away — silent and wrong in exactly the way #23 fixed.
  function cancelResumeChoice(): void {
    pendingStart = null;
    resumeChoiceEl.hidden = true;
  }

  /** The one way out of a start — both "เริ่มรอบ" and the "คนที่ N" shortcut run through here.
   *  A live round of this page's game = ask first (planStart); no round = start as before. */
  function requestStart(playing: string[], choice?: ResumeChoice): void {
    // #25: an unanswered clear question stays on screen after the panel hides — it lives outside the
    // panel on purpose — with ล้างและทิ้งรอบที่ค้าง still armed, and that button clears without asking
    // again. Open it, then start or resume, and one tap kills the round the player just chose to keep.
    // Every shell-level start or resume closes it first. "เล่นอีกรอบ" is a second door: it calls
    // mountInto directly (siamsi.ts, timebomb.ts) and never passes here, so an open question can
    // survive that one — but it stays on screen with its label intact, so that path is labelled
    // loss, not the silent loss #25 closes.
    clearChoiceEl.hidden = true;
    const session = loadSession();
    const action = planStart(session.checkpoint, gameId, choice);
    if (action === 'ask') {
      pendingStart = playing;
      resumeChoiceEl.hidden = false;
      resumeBtn.focus(); // the buttons open at the foot of the panel — take eyes and screen reader there
      return;
    }
    // "เริ่มรอบใหม่" = drop the old round, which the player asked for in as many words. It has to be
    // cleared before the game mounts, or resume finds the old blob and the "new" round IS the old one
    // (siamsi.ts mountInto reads the checkpoint every time).
    if (action === 'discard-then-start') session.saveCheckpoint(null);
    // The resume path still passes the ticked group along — the game overwrites it from the checkpoint's
    // own roster while resuming. If the blob is too broken to resume, that group is the fallback and the
    // screen is not left empty.
    // The question has its answer, so clear it before leaving: today root.hidden closes the panel anyway,
    // but if a way to reopen the panel ever appears, a stale question would sit there holding the old
    // group · playing is a parameter already in hand, so clearing pendingStart costs nothing here.
    cancelResumeChoice();
    document.dispatchEvent(new CustomEvent('watduang:start', { detail: { players: playing }, bubbles: true }));
    // The start button sits above the game stage — pressing it mid-round would tear the round down, so
    // the whole panel hides once a round is running.
    // Ways back: "เล่นอีกรอบ" lives in the game screen · "ล้างกลุ่มนี้" is outside this panel and stays pressable.
    root.hidden = true;
  }

  // Editing the count after the question appeared = the group changed; close it, same as ticking a name.
  // Without this line: press "คนที่ N" at 4 → question opens → change to 6 → "เริ่มรอบใหม่" silently starts 4.
  countInput.addEventListener('input', cancelResumeChoice);

  resumeBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'resume');
  });

  freshBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'fresh');
  });

  function renderRosterList(): void {
    rosterList.innerHTML = '';
    for (const name of roster.names()) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = selected.has(name);
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) selected.add(name);
        else selected.delete(name);
        overMaxWarned = false;
        showError('');
        cancelResumeChoice();
      });
      label.appendChild(checkbox);
      label.append(` ${name}`);
      li.appendChild(label);
      rosterList.appendChild(li);
    }
  }

  // Both modes are always on screen together (issue #7) — hiding the name grid while the roster is
  // empty would hide the "เพิ่ม" button with it, and nobody could ever build the first roster.
  renderRosterList();

  addBtn.addEventListener('click', () => {
    const name = addNameInput.value.trim();
    if (!name) return;
    roster.add(name);
    selected.add(name);
    addNameInput.value = '';
    overMaxWarned = false;
    showError('');
    cancelResumeChoice();
    renderRosterList();
  });

  // #22: a direct route into "คนที่ 1, 2, 3…" even while the old group is fully ticked — it never
  // touches selected or saveGroup. Unlike startBtn it skips resolveStart: numberedPlayers already
  // clamps into [min, max], so there is nothing over max to warn about and nothing below min to refuse.
  // #23: this button is never hidden any more. It used to disappear whenever ANY checkpoint existed,
  // because pressing it fired setPlayers("คนที่ N") and the resume path then failed a name gate and
  // dropped the live round. A checkpoint now carries its own roster and is resumed from itself
  // (siamsi.ts resumeFrom), so the hazard is gone — and with it the state where the panel copy at the
  // top of this file pointed at a control that was not on screen, on every game page including ones
  // with no resume at all. It routes through requestStart like "เริ่มรอบ" does, so a live round of this
  // game reaches the same two-button question here too — no entry point discards a round on its own.
  startNumberedBtn.addEventListener('click', () => {
    requestStart(numberedPlayers(Number(countInput.value), min, max));
  });

  startBtn.addEventListener('click', () => {
    // ponytail: clamp in this one place — every game starts through this line. The count input clamps
    // already, but the pick-from-names path never did, so a game with a per-player limit (siamsi's 24
    // cards) broke mid-round.
    let fullSelection: string[];
    if (selected.size > 0) {
      fullSelection = [...selected];
    } else {
      // 0 ticked names substitutes a synthesized "คนที่ 1..N" set for the player's actual (empty)
      // selection BEFORE resolveStart runs (same #22 fallback startNumberedBtn uses explicitly) — the
      // guard at result.belowMin below never sees the empty selection, only the substitute. Since
      // numberedPlayers clamps to at least min, belowMin can never fire from this branch; the refusal
      // gate only ever triggers on a partial tick. Deliberate, not a non-event: see CONTEXT.md's
      // "คนที่ N" entry for why this does not repeat the ADR-0007-scored guard-sees-the-wrong-set defect.
      fullSelection = numberedPlayers(Number(countInput.value), min, max);
    }

    const result = resolveStart(fullSelection, min, max, overMaxWarned);

    // Over max and not warned yet — the first click only tells, the second goes ahead (#21).
    // The stored group is always the full set; nothing clamps before storing (see the note at saveGroup).
    if (result.needsOverMaxWarning) {
      overMaxWarned = true;
      showError(`หน้านี้เล่นได้สูงสุด ${max} คน — ${result.sittingOut.join(', ')} จะไม่ได้เล่นรอบนี้ (ยังอยู่ในกลุ่มเดิม ไม่หายไปไหน) กดอีกครั้งเพื่อเริ่มรอบ`);
      return;
    }
    overMaxWarned = false;

    // Fewer than min and no way to clamp upwards — refuse in words, not with a silent return (#15).
    // The old check was === 0, so a game needing 2 players could start with one and then the panel hid
    // itself: a dead end.
    if (result.belowMin) {
      const need = Math.max(min, 1);
      showError(`ยังเริ่มไม่ได้ — เลือกไว้ ${result.playing.length} ชื่อ แต่ต้องมีอย่างน้อย ${need} คน เลือกเพิ่มอีก ${need - result.playing.length} ชื่อ`);
      return;
    }
    showError('');
    // Stored only once the min gate passes — a group that was refused should not follow the player to
    // another page.
    // It stores [...selected], not result.playing: playing has been clamped, and the count input yields
    // "คนที่ N" names that are not roster members.
    // Deliberately stores "the group as intended", not "the group this page can seat" — clamp on use,
    // never on store. Storing the clamped set was tried: one walk past a page with a small max and the
    // group was gone for good, which is worse than the problem it solved.
    // selected empty = the player came through the count input (the fullSelection lines above), not
    // "clear my group". Writing [] here would lose the group for good and it would have to be ticked
    // again from scratch (#15).
    // (#23: it no longer costs a live round either — the checkpoint carries its own roster, so there is
    // no name gate left to fail.)
    // Clearing the group has a button of its own (#clear-group); it need not be a side effect of starting.
    if (selected.size > 0) saveGroup([...selected]);
    // The group is stored before the live-round question is asked, on purpose: the player really did tick
    // this group, so next time's prefill should be it — whichever branch they choose (ADR-0004: store the
    // full group, clamp on use).
    requestStart(result.playing);
  });

  // #25: this button empties the session slot, and that slot is site-wide — a live round of ANY game
  // dies with it, not only this page's. So the condition is "is there a round at all", never planStart's
  // game-matched test (planClear takes no gameId for that reason): with a game-matched test, pressing
  // clear on timebomb's page would still destroy a live siamsi round without a word.
  // The open question is itself state: it arms ล้างและทิ้งรอบที่ค้าง, which clears without asking again. It
  // holds no group the way the start flow's pendingStart does, so pressing ล้างกลุ่มนี้ again merely reopens
  // it — but it still inherits #23's reset-on-transition rule, and requestStart closes it before a round
  // begins or resumes. Left open across that transition it sits armed beside a live round (found in
  // pre-merge review, and it is the same one-tap loss this ticket exists to close).
  function requestClear(confirmed: boolean): void {
    // Tool pages pass clearsSession={false} (ADR-0004: a tool must not touch the session).
    // The button's meaning is unchanged: it clears "this round", not the roster (the roster lives in
    // localStorage and survives either way).
    // #data-loss: saveGroup([]) must sit behind the same gate as session.clear(). It used to sit outside
    // the if, so a tool page could wipe the group (the prefill) even while the session went untouched,
    // and the player walking back into a game had to tick the whole group again (#15). The round itself
    // has been safe since #23, but this gate stays: a tool must not touch the group either.
    if (clearBtn.dataset.clearsSession !== 'no') {
      const session = loadSession();
      if (planClear(session.checkpoint, confirmed) === 'ask') {
        clearChoiceEl.hidden = false;
        // Focus the SAFE branch, as the resume prompt does. click fires on Enter keydown, so focusing
        // ล้างและทิ้งรอบที่ค้าง would put the destructive button under a key that is still held: OS auto-repeat
        // or a habitual second Enter would confirm a question the player never got to read.
        clearCancelBtn.focus();
        return;
      }
      session.clear();
      saveGroup([]);
    }
    // ponytail: reload rather than tearing the UI down by hand — teardown at every layer comes free
    // (pagehide → game.dispose(), the setup panel returns, the selection is cleared). If a client router
    // ever lands, turn this into an in-place reset.
    location.reload();
  }

  clearBtn.addEventListener('click', () => requestClear(false));
  clearConfirmBtn.addEventListener('click', () => requestClear(true));
  clearCancelBtn.addEventListener('click', () => {
    clearChoiceEl.hidden = true;
    clearBtn.focus(); // hiding the focused button would drop focus to <body> and lose the keyboard's place
  });
</script>

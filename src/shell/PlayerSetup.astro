---
interface Props { min: number; max: number; ctaLabel?: string; clearsSession?: boolean; gameId?: string }
const { min, max, ctaLabel = 'เริ่มรอบ', clearsSession = true, gameId } = Astro.props as Props;
---
<!-- data-game-id โผล่เฉพาะหน้าเกม (#23) — เป็นตัวบอกว่า checkpoint ในช่องรวมเป็นของหน้านี้ไหม
     ห้าม import เกมมาถามที่นี่ และห้ามเดาจาก URL — id เดินมาทาง prop จาก GameLayout -->
<div id="player-setup" data-min={min} data-max={max} data-game-id={gameId}>
  <div id="setup-number-picker">
    <label for="player-count">จำนวนคนเล่น</label>
    <input id="player-count" type="number" min={min} max={max} value={min} />
    <button id="start-numbered" type="button">เริ่มแบบ "คนที่ 1, 2, 3…"</button>
  </div>

  <div id="setup-roster-grid">
    <p>เลือกชื่อจากกลุ่มเดิม หรือเพิ่มชื่อใหม่ — วงที่เล่นล่าสุดจะถูกติ๊กไว้ให้ ถ้าอยากเล่นแบบไม่ใช้ชื่อ กดปุ่ม "เริ่มแบบ คนที่ 1, 2, 3…" ด้านบนได้เลย กลุ่มเดิมยังอยู่ครบ</p>
    <ul id="roster-list"></ul>
    <input id="roster-add-name" type="text" placeholder="เพิ่มชื่อใหม่" />
    <button id="roster-add-btn" type="button">เพิ่ม</button>
  </div>

  <!-- hidden ตอนไม่มีอะไรจะบอก — ไม่มี style block ที่นี่ <p> ว่างจึงกินระยะขอบของ UA ไปเปล่าๆ ทุกหน้า -->
  <p id="setup-error" role="alert" hidden></p>
  <button id="start-round" type="button">{ctaLabel}</button>

  <!-- #23: มีรอบค้างของเกมนี้ = ต้องถาม ไม่ใช่เลือกให้ ทั้งสองทางไม่มีทางไหนทำรอบหายแบบเงียบๆ
       role="alert" เพื่อให้ประกาศตอนถูกปลด hidden เหมือน #setup-error -->
  <div id="resume-choice" hidden>
    <p role="alert">ยังมีรอบที่เล่นค้างอยู่ จะกลับไปเล่นต่อ หรือเริ่มรอบใหม่กับวงที่เลือกไว้?</p>
    <button id="resume-round" type="button">กลับไปเล่นรอบที่ค้าง</button>
    <button id="fresh-round" type="button">เริ่มรอบใหม่</button>
  </div>
</div>

<!-- อยู่นอก #player-setup ตั้งใจ: พอเริ่มรอบแล้ว setup ถูกซ่อน ปุ่มนี้ต้องยังกดได้
     ไม่งั้นเปลี่ยนกลุ่มไม่ได้เลยจนกว่าจะรีโหลดเอง
     data-clears-session โผล่เฉพาะตอนถูกปิด (clearsSession={false}) — HTML ของเกมจึงเหมือนเดิมทุกไบต์

     hidden on tool pages (#23): with clearsSession={false} the click handler is a deliberate no-op
     (ADR-0004 — a tool must not touch the session or the checkpoint a game is mid-round on), and a
     button that does nothing is its own defect. Hidden in the template, not removed: the script
     below reads #clear-group for both the handler and the data flag, and a null there would throw
     and kill the whole island — taking the setup panel with it. -->
<button id="clear-group" type="button" data-clears-session={clearsSession ? undefined : 'no'} hidden={!clearsSession}>ล้างกลุ่มนี้</button>

<script>
  import { loadRoster, loadGroup, saveGroup } from './roster';
  import { loadSession } from './session';
  import { resolveStart, numberedPlayers, planStart, type ResumeChoice } from './player-select';

  const root = document.getElementById('player-setup') as HTMLElement;
  const min = Number(root.dataset.min);
  const max = Number(root.dataset.max);
  // undefined บนหน้าเครื่องมือ — ที่นั่นไม่มีเกมให้กู้ จึงไม่มีรอบค้างให้ถามถึง (#23)
  const gameId = root.dataset.gameId;

  const roster = loadRoster();

  const rosterList = document.getElementById('roster-list') as HTMLUListElement;
  const countInput = document.getElementById('player-count') as HTMLInputElement;
  const addNameInput = document.getElementById('roster-add-name') as HTMLInputElement;
  const addBtn = document.getElementById('roster-add-btn') as HTMLButtonElement;
  const startBtn = document.getElementById('start-round') as HTMLButtonElement;
  const startNumberedBtn = document.getElementById('start-numbered') as HTMLButtonElement;
  const errorEl = document.getElementById('setup-error') as HTMLElement;
  const clearBtn = document.getElementById('clear-group') as HTMLButtonElement;
  const resumeChoiceEl = document.getElementById('resume-choice') as HTMLElement;
  const resumeBtn = document.getElementById('resume-round') as HTMLButtonElement;
  const freshBtn = document.getElementById('fresh-round') as HTMLButtonElement;

  // จริงจนกว่าจะกด "เริ่มรอบ" ซ้ำ — คลิกแรกเกิน max แค่เตือน คลิกสองไปต่อ (#21)
  // ต้องรีเซ็ตทุกครั้งที่วงเปลี่ยน ไม่งั้นเตือนครั้งเดียวจบตลอดชีวิตหน้า
  let overMaxWarned = false;

  // วงเดิมติ๊กไว้ให้เลย — เดินจากหน้าเครื่องมือเข้าเกมแล้วต้องไม่ต้องติ๊กใหม่ทั้งวง (#15)
  // loadGroup() ตัดชื่อที่หายจาก roster ออกให้แล้ว · ครั้งแรก/ไม่เคยเริ่มรอบ = เซ็ตว่างเหมือนเดิม
  const selected = new Set<string>(loadGroup());

  // ปลด hidden ก่อนแล้วค่อยใส่ข้อความ role="alert" จึงประกาศตอนที่มันมองเห็นอยู่จริง
  function showError(text: string): void {
    errorEl.hidden = text === '';
    errorEl.textContent = text;
    // ทุกทางที่ปฏิเสธ/เตือนก่อนเริ่มรอบวิ่งผ่านฟังก์ชันนี้ที่เดียว (เกิน max, ต่ำกว่า min) — ปฏิเสธแล้ว
    // คำถามเรื่องรอบค้างที่ยังเปิดอยู่ถือวงเดิมที่แผงเพิ่งไม่รับไว้ กด "เริ่มรอบใหม่" ตอนนั้นจะเริ่มด้วยวงนั้น
    // ห้ามให้คำเตือนกับคำถามอยู่บนจอพร้อมกัน — แผงต้องไม่ชี้ไปที่ทางที่ตัวเองเพิ่งปิด (#23)
    if (text !== '') cancelResumeChoice();
  }

  // #23: วงที่กำลังจะเริ่ม รอคำตอบเรื่องรอบที่ค้างอยู่ — null = ยังไม่ได้ถามใคร
  let pendingStart: string[] | null = null;

  // วงเปลี่ยนหลังคำถามโผล่แล้ว = คำถามเดิมถือวงเก่าไว้ ปิดไปแล้วให้กดเริ่มรอบใหม่อีกที
  // ไม่งั้น "เริ่มรอบใหม่" จะเริ่มด้วยวงก่อนหน้าที่ผู้เล่นเพิ่งแก้ — เงียบและผิดใจแบบเดียวกับที่ #23 แก้อยู่
  function cancelResumeChoice(): void {
    pendingStart = null;
    resumeChoiceEl.hidden = true;
  }

  /** ทางออกเดียวของการเริ่มรอบ — ทั้งปุ่ม "เริ่มรอบ" และทางลัด "คนที่ N" วิ่งผ่านที่นี่
   *  มีรอบค้างของเกมหน้านี้ = ถามก่อน (planStart) ไม่มี = เริ่มเลยเหมือนเดิม */
  function requestStart(playing: string[], choice?: ResumeChoice): void {
    const session = loadSession();
    const action = planStart(session.checkpoint, gameId, choice);
    if (action === 'ask') {
      pendingStart = playing;
      resumeChoiceEl.hidden = false;
      resumeBtn.focus(); // ปุ่มโผล่ท้ายแผง — พาสายตาและ screen reader ไปถึงคำถามที่เพิ่งขึ้น
      return;
    }
    // "เริ่มรอบใหม่" = ทิ้งรอบเก่าตามที่ผู้เล่นสั่งไว้ชัดๆ ต้องล้างก่อน mount ไม่งั้นเกม resume เจอ blob เดิม
    // แล้วรอบ "ใหม่" กลายเป็นรอบเก่า (siamsi.ts mountInto อ่าน checkpoint ก่อนทุกครั้ง)
    if (action === 'discard-then-start') session.saveCheckpoint(null);
    // ทาง "กลับไปเล่นรอบที่ค้าง" ยังส่งวงที่ติ๊กไว้ตามปกติ — เกมจะทับด้วยรายชื่อใน checkpoint เองตอน resume
    // ถ้า blob เสียจน resume ไม่ได้ วงที่ติ๊กนี้คือทางถอย จอจึงไม่ว่างเปล่า
    // คำถามได้คำตอบแล้ว ล้างทิ้งก่อนออก — วันนี้ root.hidden ปิดแผงอยู่แล้ว แต่ถ้าวันหน้ามีทางเปิดแผงซ้ำ
    // คำถามค้างจะถือวงเก่าไว้เงียบๆ · playing เป็นพารามิเตอร์ในมือแล้ว ล้าง pendingStart จึงไม่กระทบ
    cancelResumeChoice();
    document.dispatchEvent(new CustomEvent('watduang:start', { detail: { players: playing }, bubbles: true }));
    // ปุ่มเริ่มรอบอยู่เหนือจอเล่น — กดกลางรอบ = ล้มรอบทิ้ง จึงซ่อนทั้งแผงหลังเริ่มแล้ว
    // ทางกลับ: "เล่นอีกรอบ" อยู่ในจอเกม · "ล้างกลุ่มนี้" อยู่นอกแผงนี้จึงยังกดได้กลางรอบ
    root.hidden = true;
  }

  // แก้จำนวนคนหลังคำถามโผล่ = วงเปลี่ยน ต้องปิดคำถามเหมือนตอนติ๊กชื่อ
  // ไม่มีบรรทัดนี้: กด "คนที่ N" ที่ 4 คน → คำถามโผล่ → แก้เป็น 6 → "เริ่มรอบใหม่" ได้ 4 คน เงียบๆ
  countInput.addEventListener('input', cancelResumeChoice);

  resumeBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'resume');
  });

  freshBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'fresh');
  });

  function renderRosterList(): void {
    rosterList.innerHTML = '';
    for (const name of roster.names()) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = selected.has(name);
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) selected.add(name);
        else selected.delete(name);
        overMaxWarned = false;
        showError('');
        cancelResumeChoice();
      });
      label.appendChild(checkbox);
      label.append(` ${name}`);
      li.appendChild(label);
      rosterList.appendChild(li);
    }
  }

  // ทั้งสองโหมดอยู่พร้อมกันเสมอ (issue #7) — ถ้าซ่อนช่องรายชื่อตอน roster ว่าง
  // ปุ่ม "เพิ่ม" จะโดนซ่อนไปด้วย แล้วไม่มีใครสร้าง roster ครั้งแรกได้เลย
  renderRosterList();

  addBtn.addEventListener('click', () => {
    const name = addNameInput.value.trim();
    if (!name) return;
    roster.add(name);
    selected.add(name);
    addNameInput.value = '';
    overMaxWarned = false;
    showError('');
    cancelResumeChoice();
    renderRosterList();
  });

  // #22: ทางลัดเข้าโหมด "คนที่ 1, 2, 3…" ตรงๆ แม้วงเดิมถูกติ๊กอยู่เต็ม — ไม่แตะ selected/saveGroup เลย
  // ต่างจาก startBtn ตรงที่ไม่ผ่าน resolveStart: numberedPlayers clamp อยู่ในช่วง [min, max] แล้ว จึงไม่มีเกิน max ให้เตือนหรือต่ำกว่า min ให้ปฏิเสธ
  // #23: this button is never hidden any more. It used to disappear whenever ANY checkpoint existed,
  // because pressing it fired setPlayers("คนที่ N") and the resume path then failed a name gate and
  // dropped the live round. A checkpoint now carries its own roster and is resumed from itself
  // (siamsi.ts resumeFrom), so the hazard is gone — and with it the state where the panel copy at the
  // top of this file pointed at a control that was not on screen, on every game page including ones
  // with no resume at all. It routes through requestStart like "เริ่มรอบ" does, so a live round of this
  // game reaches the same two-button question here too — no entry point discards a round on its own.
  startNumberedBtn.addEventListener('click', () => {
    requestStart(numberedPlayers(Number(countInput.value), min, max));
  });

  startBtn.addEventListener('click', () => {
    // ponytail: clamp ที่นี่ที่เดียว — ทุกเกมออกสตาร์ทผ่านบรรทัดนี้ ทางกรอกจำนวนข้างล่าง clamp อยู่แล้ว
    // แต่ทางเลือกจากรายชื่อไม่เคย clamp เลย เกมที่มีของจำกัดต่อคน (เช่น siamsi 24 ใบ) จึงพังกลางรอบ
    let fullSelection: string[];
    if (selected.size > 0) {
      fullSelection = [...selected];
    } else {
      fullSelection = numberedPlayers(Number(countInput.value), min, max);
    }

    const result = resolveStart(fullSelection, min, max, overMaxWarned);

    // เกิน max แล้วยังไม่เคยเตือน — คลิกแรกแค่บอก คลิกซ้ำถึงไปต่อ (#21)
    // วงที่บันทึกไว้ยังเป็นชุดเต็มเสมอ ไม่มีจุดไหน clamp ก่อนเก็บ (ดูบันทึกที่ saveGroup ด้านล่าง)
    if (result.needsOverMaxWarning) {
      overMaxWarned = true;
      showError(`หน้านี้เล่นได้สูงสุด ${max} คน — ${result.sittingOut.join(', ')} จะไม่ได้เล่นรอบนี้ (ยังอยู่ในกลุ่มเดิม ไม่หายไปไหน) กดอีกครั้งเพื่อเริ่มรอบ`);
      return;
    }
    overMaxWarned = false;

    // เลือกน้อยกว่า min แล้ว clamp ขึ้นไม่ได้ — ต้องปฏิเสธให้เห็นเป็นตัวหนังสือ ไม่ใช่ return เงียบ (#15)
    // ของเดิมเช็คแค่ === 0 เกมที่ต้องการ 2 คนขึ้นไปจึงเริ่มด้วยคนเดียวได้ แล้วแผงซ่อนตัว = ทางตัน
    if (result.belowMin) {
      const need = Math.max(min, 1);
      showError(`ยังเริ่มไม่ได้ — เลือกไว้ ${result.playing.length} ชื่อ แต่ต้องมีอย่างน้อย ${need} คน เลือกเพิ่มอีก ${need - result.playing.length} ชื่อ`);
      return;
    }
    showError('');
    // บันทึกหลังผ่านด่าน min เท่านั้น — วงที่ถูกปฏิเสธไม่ควรตามไปติ๊กค้างที่หน้าอื่น
    // เก็บ [...selected] ไม่ใช่ result.playing: playing ผ่าน clamp มาแล้ว และช่องกรอกจำนวนให้ชื่อ "คนที่ N" ที่ไม่ใช่คนใน roster
    // ตั้งใจเก็บ "วงเต็มตามที่ตั้งใจ" ไม่ใช่ "วงที่เล่นได้จริงบนหน้านี้" — clamp ตอนใช้ ไม่ clamp ตอนเก็บ
    // เคยลองเก็บตัวที่ clamp แล้ว: เดินผ่านหน้า max เล็กครั้งเดียว วงหายถาวร ซึ่งแย่กว่าปัญหาที่แก้
    // selected ว่าง = มาทางช่องกรอกจำนวน (บรรทัด fullSelection ด้านบน) ไม่ใช่ "ตั้งใจล้างวง"
    // เขียน [] ทับตรงนี้ = วงเดิมหายถาวร ต้องกลับมาติ๊กใหม่ทั้งวง (#15)
    // (#23: ไม่ทำให้รอบที่ค้างอยู่หายอีกแล้ว — checkpoint พารายชื่อของตัวเองไป จึงไม่มีด่านเทียบชื่อให้ตก)
    // การล้างวงมีปุ่มของมันอยู่แล้ว (#clear-group) จึงไม่ต้องล้างเป็นผลข้างเคียงของการเริ่มรอบ
    if (selected.size > 0) saveGroup([...selected]);
    // วงถูกบันทึกไปแล้วก่อนถึงคำถามเรื่องรอบค้าง ตั้งใจ: ผู้เล่นติ๊กวงนี้จริง prefill ครั้งหน้าจึงควรเป็นวงนี้
    // ไม่ว่าเขาจะเลือกกลับไปเล่นรอบเก่าหรือเริ่มใหม่ (ADR-0004: เก็บวงเต็ม ไม่ clamp ตอนเก็บ)
    requestStart(result.playing);
  });

  clearBtn.addEventListener('click', () => {
    // หน้าเครื่องมือส่ง clearsSession={false} มา (ADR-0004: เครื่องมือห้ามแตะ session)
    // checkpoint มีช่องเดียวร่วมกันทั้งเว็บ ล้างจากหน้าเครื่องมือ = เกมที่ค้างกลางรอบหายทันทีโดยไม่เตือน
    // ความหมายของปุ่มยังเดิม: ล้าง "รอบนี้" ไม่ใช่ล้าง roster (roster อยู่ localStorage จึงรอดทั้งสองทาง)
    // #data-loss: saveGroup([]) ต้องอยู่ gate เดียวกับ session.clear() — เดิมอยู่นอก if จึงล้าง "วง" (prefill)
    // จากหน้าเครื่องมือได้แม้ session ยังไม่ถูกแตะ กลับไปหน้าเกมแล้ว prefill ว่างต้องติ๊กใหม่ทั้งวง (#15)
    // ตัวรอบเองรอดแล้วตั้งแต่ #23 (checkpoint พารายชื่อไปเอง) แต่ gate นี้ยังต้องอยู่ — เครื่องมือห้ามแตะของวง
    if (clearBtn.dataset.clearsSession !== 'no') {
      loadSession().clear();
      saveGroup([]);
    }
    // ponytail: reload แทนการรื้อ UI เอง — ได้ teardown ครบทุกชั้นฟรี (pagehide → game.dispose(),
    // แผง setup กลับมา, selection ล้าง) ถ้าวันหนึ่งมี client router ค่อยเปลี่ยนเป็น reset ในที่
    location.reload();
  });
</script>

---
interface Props { min: number; max: number; ctaLabel?: string; clearsSession?: boolean; gameId?: string }
const { min, max, ctaLabel = 'เริ่มรอบ', clearsSession = true, gameId } = Astro.props as Props;
---
{/* Every comment in this template is a JS-style brace comment, never an HTML one: Astro renders an HTML
    comment straight into the built page, so a note like this one would ship English engineering prose to
    a Thai-first player on all nine pages this island renders on. npm test and npm run build are both
    blind to that; the guard lives in player-setup.test.mjs, and the proof is grepping dist/, not the source.

    data-game-id is emitted on game pages only (#23) — it is what tells the island whether the
    checkpoint in the shared slot belongs to this page. Never import a game to ask, and never guess
    from the URL: the id arrives as a prop from GameLayout. */}
<div id="player-setup" data-min={min} data-max={max} data-game-id={gameId}>
  <div id="setup-number-picker">
    <label for="player-count">จำนวนคนเล่น</label>
    <input id="player-count" type="number" min={min} max={max} value={min} />
    <button id="start-numbered" type="button">เริ่มแบบ "คนที่ 1, 2, 3…"</button>
  </div>

  <div id="setup-roster-grid">
    <p>เลือกชื่อจากกลุ่มเดิม หรือเพิ่มชื่อใหม่ — วงที่เล่นล่าสุดจะถูกติ๊กไว้ให้ ถ้าอยากเล่นแบบไม่ใช้ชื่อ กดปุ่ม "เริ่มแบบ คนที่ 1, 2, 3…" ด้านบนได้เลย กลุ่มเดิมยังอยู่ครบ</p>
    <ul id="roster-list"></ul>
    <input id="roster-add-name" type="text" maxlength="24" placeholder="เพิ่มชื่อใหม่" />
    <button id="roster-add-btn" type="button">เพิ่ม</button>
  </div>

  {/* hidden while there is nothing to say — this file still carries no <style> block of its own, so
      an empty p would eat the UA margin on every page for nothing. (#39: that stays true of THIS file —
      #leave-confirm below is styled from tokens.css, not a scoped block here, for the reason given
      on its own comment — so the claim this p relies on is unaffected by that addition.) */}
  <p id="setup-error" role="alert" hidden></p>
  <button id="start-round" type="button">{ctaLabel}</button>

  {/* #23: a live round of this game is a question, not a choice made on the player's behalf. Neither
      branch can lose a round silently.
      role="alert" so it is announced when the hidden attribute drops, same as #setup-error */}
  <div id="resume-choice" hidden>
    <p role="alert">ยังมีรอบที่เล่นค้างอยู่ จะกลับไปเล่นต่อ หรือเริ่มรอบใหม่กับวงที่เลือกไว้?</p>
    <button id="resume-round" type="button">กลับไปเล่นรอบที่ค้าง</button>
    <button id="fresh-round" type="button">เริ่มรอบใหม่</button>
  </div>
</div>

{/* Deliberately outside #player-setup: the panel hides itself once a round starts, and this button has
    to stay pressable — otherwise the group cannot be changed at all short of a manual reload.
    data-clears-session is emitted only when the button is switched off (clearsSession false), so a
    game page's HTML is byte-for-byte what it always was.

    hidden on tool pages (#23): with clearsSession false the click handler is a deliberate no-op
    (ADR-0004 — a tool must not touch the session or the checkpoint a game is mid-round on), and a
    button that does nothing is its own defect. Hidden in the template, not removed: the script
    below reads #clear-group for both the handler and the data flag, and a null there would throw
    and kill the whole island — taking the setup panel with it. */}
<button id="clear-group" type="button" data-clears-session={clearsSession ? undefined : 'no'} hidden={!clearsSession}>ล้างกลุ่มนี้</button>

{/* #25: this button empties the site-wide session slot, so mid-round it destroys the round while its
    label only mentions the group. It asks first, with two labelled buttons (ADR-0008's shape).
    Outside #player-setup like the button it answers for: root.hidden = true swallows the panel once a
    round starts, and a question the player cannot see would turn the Clear-group button into a dead control.
    role="alert" so it is announced when the hidden attribute drops, same as #setup-error

    #data-loss: the two strings below are the stranded-checkpoint wording (ADR-0008's approved pair) and
    stay the default. A round live on THIS page is a different loss, and both at once is a third; those
    two get their own wording from clearCopy, swapped in at runtime by requestClear. The template still
    ships this pair byte for byte, so ADR-0008's quoted strings keep resolving.

    gh#55: a dialog element, not a plain block, and the element type IS the fix. (Written without the
    angle brackets on purpose: player-setup.test.mjs decides inside-the-panel by counting unclosed div
    tags from the panel's opening tag, and a div tag named in this prose counts as one more.)
    In normal flow, [hidden]{display:none} on dismissal reflowed everything below it upward — a stage control could
    arrive under a finger already descending for the second half of a double-tap. The ~60px of clearance
    that made that miss today is emergent from Thai text width and font metrics and is owned by nobody,
    so it cannot be relied on for games not yet written. An open modal <dialog> is out of flow, so
    dismissal moves nothing at all and the whole hazard family goes with the reflow (ADR-0024).

    It keeps `hidden` as well, and that is the fail-SAFE half: a browser with no <dialog>.showModal never
    reaches showModal, drops `hidden` alone, and gets exactly the reflowing question that shipped before —
    still asked, still answerable. #leave-confirm below fails OPEN for the opposite reason; copying that
    early return here would clear the group and discard the rounds without asking. Never do that. */}
<dialog id="clear-choice" hidden>
  <p id="clear-choice-msg" role="alert">ยังมีรอบที่เล่นค้างอยู่ ถ้าล้างกลุ่มนี้ รอบที่ค้างจะหายไปด้วย</p>
  <button id="clear-confirm" type="button">ล้างและทิ้งรอบที่ค้าง</button>
  <button id="clear-cancel" type="button">ยกเลิก</button>
</dialog>

{/* #39: a tap-transition (stage shrinks, page chrome slides up) can put a GameNav link exactly where a
    double-tap's second tap lands — the group leaves the round with no warning. This asks first, but only
    while a round is actually live on THIS page (root.hidden — same bit #data-loss reads above), so a
    reader who has not started anything yet still navigates freely.
    Outside #player-setup like #clear-choice above, for the same reason: root.hidden hides the panel the
    moment a round starts, which is exactly when this dialog needs to still be reachable.
    #leave-go is a <button>, not an <a> — an anchor here would recreate the exact hazard this dialog
    exists to remove (a second target waiting under the same finger).

    Thai copy below is FINAL, owner-ruled #39: this dialog can only ask whether to leave, and that
    ceiling is accepted as permanent rather than worked around. It is bounded by what the predicate
    carries. root.hidden means "a round was STARTED on this page", not "a round is running right now" —
    nothing ever un-hides the panel, so a finished-round summary still reaches this dialog. An earlier
    wording ended by asserting that this round would END, which on that screen is simply false — the
    round already had. Both buttons are bounded the same way: an earlier "เล่นรอบนี้ต่อ" promised to
    resume a round that may already be over, so the stay button names the page, not the round.
    Same discipline as clearCopy in player-select.ts, which is worded to claim only its own bit.
    Do not restore any claim about a round ending or resuming unless the predicate is narrowed to
    match — and narrowing it means building round state this site does not have (ADR-0015). */}
<dialog id="leave-confirm">
  <p id="leave-confirm-msg" role="alert">ไปเกมอื่นตอนนี้ไหม</p>
  <button id="leave-stay" type="button">อยู่หน้านี้ต่อ</button>
  <button id="leave-go" type="button">ไปเกมอื่น</button>
</dialog>

<script>
  import { loadRoster, loadGroup, saveGroup } from './roster';
  import { loadSession, type StartKind } from './session';
  import { resolveStart, numberedPlayers, planStart, planClear, clearCopy, type ResumeChoice } from './player-select';

  const root = document.getElementById('player-setup') as HTMLElement;
  const min = Number(root.dataset.min);
  const max = Number(root.dataset.max);
  // undefined on tool pages — there is no game to resume there, so no live round to ask about (#23)
  const gameId = root.dataset.gameId;

  const roster = loadRoster();

  const rosterList = document.getElementById('roster-list') as HTMLUListElement;
  const countInput = document.getElementById('player-count') as HTMLInputElement;
  const addNameInput = document.getElementById('roster-add-name') as HTMLInputElement;
  const addBtn = document.getElementById('roster-add-btn') as HTMLButtonElement;
  const startBtn = document.getElementById('start-round') as HTMLButtonElement;
  const startNumberedBtn = document.getElementById('start-numbered') as HTMLButtonElement;
  const errorEl = document.getElementById('setup-error') as HTMLElement;
  const clearBtn = document.getElementById('clear-group') as HTMLButtonElement;
  const resumeChoiceEl = document.getElementById('resume-choice') as HTMLElement;
  const resumeBtn = document.getElementById('resume-round') as HTMLButtonElement;
  const freshBtn = document.getElementById('fresh-round') as HTMLButtonElement;
  const clearChoiceEl = document.getElementById('clear-choice') as HTMLDialogElement;
  const clearChoiceMsg = document.getElementById('clear-choice-msg') as HTMLElement;
  const clearConfirmBtn = document.getElementById('clear-confirm') as HTMLButtonElement;
  const clearCancelBtn = document.getElementById('clear-cancel') as HTMLButtonElement;

  // True until "Start round" is pressed a second time — the first click over max only warns (#21).
  // Must reset whenever the group changes, or one warning would last the whole life of the page.
  let overMaxWarned = false;

  // The last group comes pre-ticked — walking from a tool page into a game must not mean ticking it
  // all over again (#15). loadGroup() has already dropped names that left the roster · first visit or
  // never started a round = the empty set, as before.
  const selected = new Set<string>(loadGroup());

  // Drop hidden first, then set the text: role="alert" announces only while the node is visible
  function showError(text: string): void {
    errorEl.hidden = text === '';
    errorEl.textContent = text;
    // Every refusal or warning before a start runs through this one function (over max, below min).
    // Having refused, an open resume question would still be holding the group the panel just turned
    // down, and pressing "Start new round" would start with it. A warning and a question must never share
    // the screen: the panel must not point at the path it has just closed (#23).
    if (text !== '') cancelResumeChoice();
  }

  // #23: the group waiting on an answer about the live round — null = nobody has been asked yet
  let pendingStart: string[] | null = null;

  // The group changed after the question appeared = the question is holding the old one. Close it and
  // make them press start again; otherwise "Start new round" starts with the group the player just edited
  // away — silent and wrong in exactly the way #23 fixed.
  function cancelResumeChoice(): void {
    pendingStart = null;
    resumeChoiceEl.hidden = true;
  }

  /** The one way out of a start — both "Start round" and the "Player N" shortcut run through here.
   *  A live round of this page's game = ask first (planStart); no round = start as before. */
  function requestStart(playing: string[], choice?: ResumeChoice): void {
    // #25: an unanswered clear question stays on screen after the panel hides — it lives outside the
    // panel on purpose — with Clear-and-drop-pending-round still armed, and that button clears without asking
    // again. Open it, then start or resume, and one tap kills the round the player just chose to keep.
    // Every shell-level start or resume closes it first. "Play again" is a second door: it calls
    // mountInto directly and never passes here, so an open question can survive that one — but it
    // stays on screen with its label intact, so that path is labelled loss, not the silent loss #25
    // closes. Five games have that door today; grep the play-again handlers rather than trusting a
    // list here, because an enumeration in a comment goes stale the next time a game ships.
    // Both states, in this order: `hidden` is the one the no-dialog fallback reads, [open] is the one
    // the UA sheet reads. Setting one and not the other leaves the question on screen in one browser
    // population or the other — see the dialog's own comment in the template.
    clearChoiceEl.hidden = true;
    if (typeof clearChoiceEl.close === 'function' && clearChoiceEl.open) clearChoiceEl.close();
    else clearChoiceEl.removeAttribute('open');
    const session = loadSession();
    const action = planStart(session.checkpoint, gameId, choice);
    if (action === 'ask') {
      pendingStart = playing;
      resumeChoiceEl.hidden = false;
      resumeBtn.focus(); // the buttons open at the foot of the panel — take eyes and screen reader there
      return;
    }
    // "Start new round" = drop the old round, which the player asked for in as many words. It has to be
    // cleared before the game mounts, or resume finds the old blob and the "new" round IS the old one
    // (siamsi.ts mountInto reads the checkpoint every time).
    if (action === 'discard-then-start') session.saveCheckpoint(null);
    // The resume path still passes the ticked group along — the game overwrites it from the checkpoint's
    // own roster while resuming. If the blob is too broken to resume, that group is the fallback and the
    // screen is not left empty.
    // The question has its answer, so clear it before leaving: today root.hidden closes the panel anyway,
    // but if a way to reopen the panel ever appears, a stale question would sit there holding the old
    // group · playing is a parameter already in hand, so clearing pendingStart costs nothing here.
    cancelResumeChoice();
    // gh#53 — whether this start BEGINS a round or carries the one in the slot on is decided here and
    // carried on the event, because here is the only place that knows. 'resume' is the sole
    // continuation: it is reached only after this panel asked about a live round of THIS page's game
    // and the player chose to keep it. Every other route is a round beginning — the discard branch,
    // and the plain start planStart returns when it found nothing of this game's to ask about.
    // That second route is exactly why session.ts must not infer this from the slot: it is reached with
    // a stranded checkpoint of ANOTHER game still sitting there, so "the slot holds a round" is true
    // while the round being started is brand new. The first gh#53 fix read that as a continuation and
    // handed the new round the stranded round's identity.
    const start: StartKind = choice === 'resume' ? 'same-round' : 'new-round';
    document.dispatchEvent(new CustomEvent('watduang:start', { detail: { players: playing, start }, bubbles: true }));
    // The start button sits above the game stage — pressing it mid-round would tear the round down, so
    // the whole panel hides once a round is running.
    // Ways back: "Play again" lives in the game screen · "Clear group" is outside this panel and stays pressable.
    root.hidden = true;
  }

  // Editing the count after the question appeared = the group changed; close it, same as ticking a name.
  // Without this line: press "Player N" at 4 → question opens → change to 6 → "Start new round" silently starts 4.
  countInput.addEventListener('input', cancelResumeChoice);

  resumeBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'resume');
  });

  freshBtn.addEventListener('click', () => {
    if (pendingStart) requestStart(pendingStart, 'fresh');
  });

  function renderRosterList(): void {
    rosterList.innerHTML = '';
    for (const name of roster.names()) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = selected.has(name);
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) selected.add(name);
        else selected.delete(name);
        overMaxWarned = false;
        showError('');
        cancelResumeChoice();
      });
      label.appendChild(checkbox);
      label.append(` ${name}`);
      li.appendChild(label);
      rosterList.appendChild(li);
    }
  }

  // Both modes are always on screen together (issue #7) — hiding the name grid while the roster is
  // empty would hide the "Add" button with it, and nobody could ever build the first roster.
  renderRosterList();

  // async because roster.add() waits on the cross-tab lock. Awaiting it is the fix, not a formality:
  // firing it and rendering straight away would draw the list before add() had re-read storage, so a name
  // another tab added would be missing from the panel until the next load. It must not become
  // fire-and-forget for the sake of a sync handler — that is the race back, wearing a lock.
  addBtn.addEventListener('click', async () => {
    const name = addNameInput.value.trim();
    if (!name) return;
    await roster.add(name);
    selected.add(name);
    addNameInput.value = '';
    overMaxWarned = false;
    showError('');
    cancelResumeChoice();
    renderRosterList();
  });

  // #22: a direct route into "Player 1, 2, 3…" even while the old group is fully ticked — it never
  // touches selected or saveGroup. Unlike startBtn it skips resolveStart: numberedPlayers already
  // clamps into [min, max], so there is nothing over max to warn about and nothing below min to refuse.
  // #23: this button is never hidden any more. It used to disappear whenever ANY checkpoint existed,
  // because pressing it fired setPlayers("Player N") and the resume path then failed a name gate and
  // dropped the live round. A checkpoint now carries its own roster and is resumed from itself
  // (siamsi.ts resumeFrom), so the hazard is gone — and with it the state where the panel copy at the
  // top of this file pointed at a control that was not on screen, on every game page including ones
  // with no resume at all. It routes through requestStart like "Start round" does, so a live round of this
  // game reaches the same two-button question here too — no entry point discards a round on its own.
  startNumberedBtn.addEventListener('click', () => {
    requestStart(numberedPlayers(Number(countInput.value), min, max));
  });

  startBtn.addEventListener('click', () => {
    // ponytail: clamp in this one place — every game starts through this line. The count input clamps
    // already, but the pick-from-names path never did, so a game with a per-player limit (siamsi's 24
    // cards) broke mid-round.
    let fullSelection: string[];
    if (selected.size > 0) {
      fullSelection = [...selected];
    } else {
      // 0 ticked names substitutes a synthesized "Player 1..N" set for the player's actual (empty)
      // selection BEFORE resolveStart runs (same #22 fallback startNumberedBtn uses explicitly) — the
      // guard at result.belowMin below never sees the empty selection, only the substitute. Since
      // numberedPlayers clamps to at least min, belowMin can never fire from this branch; the refusal
      // gate only ever triggers on a partial tick. Deliberate, not a non-event: see CONTEXT.md's
      // "numbered-players group" entry for why this does not repeat the ADR-0007-scored guard-sees-the-wrong-set defect.
      fullSelection = numberedPlayers(Number(countInput.value), min, max);
    }

    const result = resolveStart(fullSelection, min, max, overMaxWarned);

    // Over max and not warned yet — the first click only tells, the second goes ahead (#21).
    // The stored group is always the full set; nothing clamps before storing (see the note at saveGroup).
    if (result.needsOverMaxWarning) {
      overMaxWarned = true;
      showError(`หน้านี้เล่นได้สูงสุด ${max} คน — ${result.sittingOut.join(', ')} จะไม่ได้เล่นรอบนี้ (ยังอยู่ในกลุ่มเดิม ไม่หายไปไหน) กดอีกครั้งเพื่อเริ่มรอบ`);
      return;
    }
    overMaxWarned = false;

    // Fewer than min and no way to clamp upwards — refuse in words, not with a silent return (#15).
    // The old check was === 0, so a game needing 2 players could start with one and then the panel hid
    // itself: a dead end.
    if (result.belowMin) {
      const need = Math.max(min, 1);
      showError(`ยังเริ่มไม่ได้ — เลือกไว้ ${result.playing.length} ชื่อ แต่ต้องมีอย่างน้อย ${need} คน เลือกเพิ่มอีก ${need - result.playing.length} ชื่อ`);
      return;
    }
    showError('');
    // Stored only once the min gate passes — a group that was refused should not follow the player to
    // another page.
    // It stores [...selected], not result.playing: playing has been clamped, and the count input yields
    // "Player N" names that are not roster members.
    // Deliberately stores "the group as intended", not "the group this page can seat" — clamp on use,
    // never on store. Storing the clamped set was tried: one walk past a page with a small max and the
    // group was gone for good, which is worse than the problem it solved.
    // selected empty = the player came through the count input (the fullSelection lines above), not
    // "clear my group". Writing [] here would lose the group for good and it would have to be ticked
    // again from scratch (#15).
    // (#23: it no longer costs a live round either — the checkpoint carries its own roster, so there is
    // no name gate left to fail.)
    // Clearing the group has a button of its own (#clear-group); it need not be a side effect of starting.
    // Deliberately ungated by clearsSession, unlike the wipe below: a tool page must write the group too
    // (#15 — spin the wheel, keep going, the roster flows into the game without retyping). saveGroup()
    // overwrites watduang:group wholesale (roster.ts), so this write is not itself recoverable — but it
    // only ever replaces the group with what the player just ticked on THIS page, never with an empty or
    // synthesized set (guarded above by `if (selected.size > 0)`), so there is nothing destructive for the
    // gate to prevent. Only the wipe below can turn "no group" into the group, which is why it alone needs
    // the gate.
    if (selected.size > 0) saveGroup([...selected]);
    // The group is stored before the live-round question is asked, on purpose: the player really did tick
    // this group, so next time's prefill should be it — whichever branch they choose (ADR-0004: store the
    // full group, clamp on use).
    requestStart(result.playing);
  });

  // #25: this button empties the session slot, and that slot is site-wide — a live round of ANY game
  // dies with it, not only this page's. So the condition is "is there a round at all", never planStart's
  // game-matched test (planClear takes no gameId for that reason): with a game-matched test, pressing
  // clear on timebomb's page would still destroy a live siamsi round without a word.
  // The open question is itself state: it arms Clear-and-drop-pending-round, which clears without asking again. It
  // holds no group the way the start flow's pendingStart does, so pressing Clear group again merely reopens
  // it — but it still inherits #23's reset-on-transition rule, and requestStart closes it before a round
  // begins or resumes. Left open across that transition it sits armed beside a live round (found in
  // pre-merge review, and it is the same one-tap loss this ticket exists to close).
  function requestClear(confirmed: boolean): void {
    // Tool pages pass clearsSession={false} (ADR-0004: a tool must not touch the session).
    // The button's meaning is unchanged: it clears "this round", not the roster (the roster lives in
    // localStorage and survives either way).
    // #data-loss: saveGroup([]) must sit behind the same gate as session.clear(). It used to sit outside
    // the if, so a tool page could wipe the group (the prefill) even while the session went untouched,
    // and the player walking back into a game had to tick the whole group again (#15). The round itself
    // has been safe since #23, but this gate stays: a tool must not touch the group either.
    if (clearBtn.dataset.clearsSession !== 'no') {
      const session = loadSession();
      // #data-loss: the checkpoint was never the liveness test. Only siamsi writes one — 1 of 6 games —
      // and it empties the slot at round end, so an empty slot covered a live short-stick or timebomb
      // round and every fresh session, and the tap below reloaded the page and took the round with it.
      // The bit was here all along: requestStart sets root.hidden when a round begins. Read inside this
      // gate, never above it — a tool page hides its own round too and must stay a no-op (ADR-0004).
      const roundLive = root.hidden;
      if (planClear(session.checkpoint, confirmed, roundLive) === 'ask') {
        // The template's copy says \u0e23\u0e2d\u0e1a\u0e17\u0e35\u0e48\u0e04\u0e49\u0e32\u0e07 — the round left hanging — which is true of a stranded
        // checkpoint and false of the round on screen: mid short-stick with a stale siamsi blob in the
        // slot it names the abandoned siamsi round while the button under it kills the live one, and both
        // of them die in that press. clearCopy owns which of the three cases this is and the strings that
        // name it; null means the template's default already says the true thing. Assigned as a pair and
        // before the question is shown — role="alert" announces the text that is there when hidden drops.
        const copy = clearCopy(session.checkpoint, roundLive);
        if (copy) {
          clearChoiceMsg.textContent = copy.message;
          clearConfirmBtn.textContent = copy.confirmLabel;
        }
        clearChoiceEl.hidden = false;
        // gh#55: raise it out of flow, so answering it moves nothing (ADR-0024). Fail SAFE, the exact
        // opposite of #leave-confirm's fail-OPEN early return below: this question is the only thing
        // standing in front of a destructive action, so a browser with no showModal must still be asked.
        // An early return on this capability test would clear the group and discard the rounds without
        // asking: data loss, not a degraded guard.
        // hidden drops FIRST, one line up: showModal() on a display:none box would raise nothing.
        //
        // The else branch is NOT belt and braces — dropping hidden alone is not enough, measured. A UA
        // that styles <dialog> at all also ships `dialog:not([open]) { display: none }`, and that rule
        // outlives any missing method: with showModal deleted the question read hidden=false and ZERO
        // client rects, focus fell to <body>, and Clear group became a control that visibly did nothing.
        // Setting [open] by hand is what renders it in both populations — as an out-of-flow absolutely
        // positioned box where the UA knows <dialog>, and as the plain in-flow block this shipped as
        // before gh#55 where it does not. Reflowing is an acceptable fallback; unanswerable is not.
        if (!clearChoiceEl.open) {
          if (typeof clearChoiceEl.showModal === 'function') clearChoiceEl.showModal();
          else clearChoiceEl.setAttribute('open', '');
        }
        // Focus the SAFE branch, as the resume prompt does. click fires on Enter keydown, so focusing
        // Clear-and-drop-pending-round would put the destructive button under a key that is still held: OS auto-repeat
        // or a habitual second Enter would confirm a question the player never got to read.
        // Load-bearing under <dialog> too, and more so: showModal() autofocuses the first focusable
        // descendant, which in DOM order is the destructive button. This line runs in the same
        // synchronous task and takes focus back, so no frame ever paints with it focused.
        clearCancelBtn.focus();
        return;
      }
      // clear() can refuse since gh#51 F2, and this page wires no onWriteRefused — so the refusal
      // would be silent here, and saveGroup([]) + reload below run regardless. Unreachable today, and
      // the reason is the ONLY thing keeping it so: `const session = loadSession()` above binds fresh
      // inside this same gate, with zero awaits/then/yield before the wipe, so the closure cannot be a
      // generation behind its own record. Hoist that binding out, leave an async escape before the
      // wipe, or make session.clear() run in a synchronous re-entrant writer's wake, and this becomes a
      // silent discard-that-did-not-happen — the ADR-0008 loss gh#50 closed for write(). Wire the
      // listener (clear() would first need write()'s WriteRefusal | null return — write() in session.ts
      // is declared to return one and clear() is declared void, so there is no return to check yet)
      // before making any of those changes. player-setup.test.mjs's "#51 requestClear's `const session = loadSession()`
      // binding stays inside this function" pins the first two of those three breaks by source text;
      // the third (a synchronous re-entrant writer in that span) is named there as not covered, not
      // enumerated — that set has no owner a source-text check converges on.
      session.clear();
      saveGroup([]);
    }
    // ponytail: reload rather than tearing the UI down by hand — teardown at every layer comes free
    // (pagehide → game.dispose(), the setup panel returns, the selection is cleared). If a client router
    // ever lands, turn this into an in-place reset.
    location.reload();
  }

  clearBtn.addEventListener('click', () => requestClear(false));
  clearConfirmBtn.addEventListener('click', () => requestClear(true));
  // ESC on an open modal is a dismissal the browser performs for us, and it must land on exactly what
  // "ยกเลิก" does — that is the whole reason both side effects live here rather than in the button's
  // handler (ADR-0015's rule (c) shape: one clearing point per dismissal, not per button). Nothing is
  // ever cleared until #clear-confirm is pressed, so the two were already equal on the destructive
  // axis; they were NOT equal on the other two, and both gaps were measured, not assumed:
  //   hidden — ESC drops [open] and leaves the attribute behind, so the element's two closed states
  //     (the one the no-showModal fallback needs, the one the UA sheet reads) drift apart.
  //   focus — the UA restores focus to whatever was focused when showModal ran. A tap does not focus
  //     the button it hits on iOS, so that is <body>: measured activeElement BODY after a real Escape,
  //     against clear-group after the button. Same dismissal, keyboard place lost on one of them.
  clearChoiceEl.addEventListener('close', () => {
    clearChoiceEl.hidden = true;
    clearBtn.focus(); // hiding the focused button would drop focus to <body> and lose the keyboard's place
  });
  clearCancelBtn.addEventListener('click', () => {
    clearChoiceEl.hidden = true;
    // close() re-enters the listener above, which owns the rest. A browser with no dialog methods fires
    // no close event ever, so that branch finishes the job itself: the [open] this question set by hand
    // has to come off by hand too, or the fallback shuts once and never reopens.
    if (typeof clearChoiceEl.close === 'function' && clearChoiceEl.open) clearChoiceEl.close();
    else {
      clearChoiceEl.removeAttribute('open');
      clearBtn.focus();
    }
  });

  // #39 — a link click during a live round on this page asks first. Capture phase so this runs before
  // the link's own navigation, and it is deliberately global (document, not #stage or GameNav): the
  // hazard is page chrome sliding under a tap-transition, and enumerating every link that could end up
  // there is exactly the maintenance burden ADR-0014 already rejected once. Only data-stable-exit
  // (GameLayout's /games/ link, which never moves) opts out.
  const leaveDlg = document.getElementById('leave-confirm') as HTMLDialogElement;
  const leaveStayBtn = document.getElementById('leave-stay') as HTMLButtonElement;
  const leaveGoBtn = document.getElementById('leave-go') as HTMLButtonElement;
  let pendingHref: string | null = null;

  document.addEventListener('click', (e) => {
    // root.hidden is the same live-round bit requestClear reads above — no game on this page, or no
    // round started on it yet, and there is nothing at risk: let every link behave normally.
    if (gameId === undefined || !root.hidden) return;
    // A modified or non-primary click is the round-PRESERVING action — cmd/ctrl/middle opens the
    // sibling game in a new tab and leaves this round exactly where it is. Intercepting it and then
    // honouring the answer with location.href turns the safe action into the destructive one: the
    // player asked for a second tab and the current tab navigates instead. Let the browser have it.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    // Fail OPEN: a browser with no <dialog>.showModal cannot ask, and eating the click with no way to
    // ask would strand the player worse than the double-tap this guard exists to stop.
    if (typeof leaveDlg.showModal !== 'function') return;
    const link = (e.target as Element).closest?.('a[href]:not([data-stable-exit])') as HTMLAnchorElement | null;
    if (!link) return;
    e.preventDefault();
    pendingHref = link.href;
    // Anchors to the viewport half the finger is NOT in, and (via tokens.css) flips which end of the
    // dialog #leave-go sits at, so the destructive button lands furthest from where the tap already is.
    const tapY = e.clientY;
    leaveDlg.classList.toggle('at-bottom', tapY < window.innerHeight / 2);
    leaveDlg.classList.toggle('at-top', tapY >= window.innerHeight / 2);
    leaveDlg.showModal();
    leaveStayBtn.focus(); // same reason as resumeBtn/clearCancelBtn above: focus the safe branch
  }, true);

  // One clearing point for every way this dialog can shut — the stay button, Escape, and the close()
  // the go branch issues below all end here. Clearing it per-button was the shipped defect: after a
  // dismissal pendingHref still held the link, so any later press of #leave-go navigated on an answer
  // the player had already given the other way. `close` is the event <dialog> fires for all of them,
  // so a close path added later cannot forget to clear it.
  leaveDlg.addEventListener('close', () => { pendingHref = null; });
  leaveStayBtn.addEventListener('click', () => leaveDlg.close());
  leaveGoBtn.addEventListener('click', () => {
    // Read it out before close() fires the listener above and nulls it. No pendingHref = this press
    // came from somewhere other than an intercepted link click, and there is nowhere to go.
    const href = pendingHref;
    leaveDlg.close();
    if (href) location.href = href;
  });
</script>
